VERSION = "3.2.1"

APP_DIR = os.environ.get("SINKO_APP_DIR", "/opt/sinko")
LISTS_DIR = os.path.join(APP_DIR, "lists")
CONFIG_FILE = os.environ.get("SINKO_CONFIG_FILE", "/etc/sinko/config")
DEFAULT_LISTS_BASE = "https://raw.githubusercontent.com/iret33/sinko/master/lists"
DEFAULT_STATE_DIR = "/var/lib/sinko"
TELEMETRY_URL = "https://sinko-counter.sabdulla.workers.dev"          # the anonymous counter's address; empty = not configured, and then nothing is ever sent
CLI_PW_FILE = os.environ.get("SINKO_CLI_PW_FILE", "/etc/pihole/cli_pw")

G_KIDS = "pb-kids"          # marker: membership == "this is a kid device"
G_GUARD = "pb-guard"        # always-on anti-bypass list (DoH resolvers)
G_OFFLINE = "pb-offline"    # enabled == internet off for all kid devices
G_PAUSED = "pb-paused"      # always enabled; membership == this device is paused
G_STATE = "pb-state"        # disabled; description holds shared JSON state
SVC_PREFIX = "pb-svc-"
LIST_COMMENT_PREFIX = "pb:"
BLOCK_ALL_REGEX = "^.*$"
BLOCK_ALL_COMMENT = "sinko: blocks everything for offline/paused kid devices"
# pihole-bahrain 2.x made the same rule with its own comment: it is ours too, so that migrating re-owns it. Anything
# else on "^.*$" belongs to the owner of the Pi-hole (an allow-list-only setup) and is never rewritten or deleted.
BLOCK_ALL_OURS = (BLOCK_ALL_COMMENT, "pihole-bahrain: blocks everything for offline/paused kid devices")


def block_all_is_ours(rule: dict) -> bool:
    return rule.get("comment") in BLOCK_ALL_OURS

DEFAULT_GROUP = 0
TICK_SECONDS = 15
GRAVITY_LOCK_NAME = "gravity.lock"       # in the state folder: /var/lib/sinko/gravity.lock (the unit that refreshes the lists uses it)
GRAVITY_LOCK_WAIT = 30 * 60              # seconds a run waits for the one before it ...
GRAVITY_RUN_LIMIT = 30 * 60              # ... and a run itself may take
GRAVITY_POLL = 1.0                       # seconds between two looks at a lock that somebody else holds

DEFAULT_STATE = {
    "v": 1,
    "timer": None,
    "schedule": {"enabled": False, "start": "21:00", "end": "06:00",
                 "days": [0, 1, 2, 3, 4, 5, 6]},
    "scheduleActive": False,
    # Written by the parent page (auto, request, checkRequest) and by the scheduler (the rest). See parse_state.
    "update": {"auto": False, "request": None, "checkRequest": None, "latest": None, "notes": None,
               "checked": 0, "status": "idle", "from": None, "to": None, "at": 0, "error": None, "rolledBack": None},
    "power": {"request": None, "action": None},      # the page asks for "reboot" or "poweroff"
    "telemetry": {"on": None},                       # None: not asked yet; True/False: the parent's answer
    "community": None,                               # {"online": n, "at": epoch}, set by the scheduler after a ping
    "setup": {"done": False},                        # the first-run checklist was dismissed
    "learn": {"on": False},                          # learning new addresses of blocked apps (Learner); set by the terms screen
    "terms": {"agreed": 0},                          # the version of the terms of use the parent agreed to on the page; 0 = none yet
}

SEMVER_RE = re.compile(r"\d{1,4}\.\d{1,4}\.\d{1,4}", re.ASCII)      # always used with fullmatch: "$" lets a newline through
NOTES_RE = re.compile(r"https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/releases(/tag/[A-Za-z0-9_.+-]+)?", re.ASCII)
UPDATE_STATUSES = ("idle", "running", "ok", "failed")
POWER_ACTIONS = ("reboot", "poweroff")
TERMS_MAX = 9999                         # terms.agreed is a whole number from 0 to this; anything else reads as 0 (not agreed)

log = logging.getLogger("sinko")


# --------------------------------------------------------------------------- #
# Catalog
# --------------------------------------------------------------------------- #
def load_catalog(lists_dir: str = LISTS_DIR) -> dict:
    with open(os.path.join(lists_dir, "services.json"), encoding="utf-8") as fh:
        cat = json.load(fh)
    ids = [s["id"] for s in cat["services"]]
    if len(ids) != len(set(ids)):
        raise SystemExit("services.json: duplicate service id")
    for sid in ids + ["guard"]:
        path = os.path.join(lists_dir, sid + ".txt")
        if not os.path.isfile(path):
            raise SystemExit("missing list file: " + path)
    return cat


def svc_group(sid: str) -> str:
    return SVC_PREFIX + sid


def read_config(path: str = CONFIG_FILE) -> dict:
    """KEY=VALUE file written by install.sh (shell-compatible, no expansion)."""
    conf = {}
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, value = line.split("=", 1)
                conf[key.strip()] = value.strip().strip("'\"")
    except FileNotFoundError:
        pass
    # A box that was installed as pihole-bahrain (<= 2.2.x) still has PB_* keys until the installer rewrites the
    # file; its answers (hostname, address, list source, ref) must not be lost in between.
    for key in [k for k in conf if k.startswith("PB_")]:
        conf.setdefault("SINKO_" + key[3:], conf[key])
    return conf


def lists_base(conf: dict | None = None) -> str:
    """Where Pi-hole downloads the service lists from.

    An http(s) URL (default: this repository on GitHub, so `pihole -g` picks up
    list changes automatically) or a local directory (served as file://).
    """
    conf = read_config() if conf is None else conf
    base = os.environ.get("SINKO_LISTS_BASE") or conf.get("SINKO_LISTS_BASE") or DEFAULT_LISTS_BASE
    return base.rstrip("/")


def list_address(sid: str, base: str) -> str:
    if base.startswith(("http://", "https://", "file://")):
        return "%s/%s.txt" % (base, sid)
    return "file://" + os.path.join(os.path.abspath(base), sid + ".txt")


def kid_groups(group_ids: dict, catalog: dict) -> list:
    """Every group a kid device must belong to (except pb-paused)."""
    names = [G_KIDS, G_GUARD, G_OFFLINE] + [svc_group(s["id"]) for s in catalog["services"]]
    return [DEFAULT_GROUP] + [group_ids[n] for n in names if n in group_ids]


# --------------------------------------------------------------------------- #
# Reading a host name: the small AI model (docs/maintainers/host-model.md)
# --------------------------------------------------------------------------- #
# tools/suggest-hosts.py trains the model and reads names with the code below, imported from this file, so that the
# box and the training can never read a name differently.
MODEL_FILE = os.environ.get("SINKO_MODEL_FILE", os.path.join(APP_DIR, "model", "host-model.json"))
MODEL_MAX_BYTES = 4 * 1024 * 1024        # the model is about half a megabyte; anything much bigger is not ours
MODEL_THRESHOLD = 0.98                   # how sure the model must be that a name is an app's before anything is done with it
MIN_WORD = 5                             # an app's word ("tiktok", "twimg") is at least this long: "fb" or "x" would match everything

# Platforms that carry many companies' names. Their own labels say nothing about the app ("akamaized" is not Steam),
# so they are cut off before a name is read, and nothing ever blocks one of them as a whole.
SHARED = {
    "akamaihd.net", "akamaized.net", "akamai.net", "akamaiedge.net", "edgesuite.net", "edgekey.net", "akadns.net",
    "akamaitechnologies.com", "fastly.net", "map.fastly.net", "fastlylb.net", "cloudflare.net", "cdn.cloudflare.net",
    "cloudflare.com", "cloudfront.net", "amazonaws.com", "awsglobalaccelerator.com", "elb.amazonaws.com",
    "azureedge.net", "azurefd.net", "trafficmanager.net", "cloudapp.net", "cloudapp.azure.com", "windows.net",
    "footprint.net", "llnwd.net", "edgecastcdn.net", "cdn77.org", "b-cdn.net", "omtrdc.net", "2o7.net",
    "l.google.com", "googleapis.com", "googleusercontent.com", "gstatic.com", "ggpht.com", "googlevideo.com",
    "appspot.com", "1e100.net", "fbcdn.net", "github.io", "githubusercontent.com", "herokuapp.com", "vercel.app",
    "netlify.app", "pages.dev", "workers.dev", "firebaseapp.com", "web.app", "wpengine.com", "shopify.com",
    "myshopify.com", "wixsite.com", "blogspot.com", "fandom.com", "wordpress.com", "tumblr.com",
}
# Never blocked as a whole, whatever the model says: tests/test_core.py refuses a list that blocks any of them.
NEVER = SHARED | {
    "google.com", "apple.com", "icloud.com", "microsoft.com", "microsoftonline.com", "live.com", "windows.com",
    "office.com", "office.net", "msftncsi.com", "msftconnecttest.com", "github.com", "raw.githubusercontent.com",
}
SECOND_LEVEL = {"co", "com", "net", "org", "gov", "edu", "ac", "or", "ne", "go", "gob", "nic", "ltd", "plc"}
TLDISH = re.compile(r"(?:[a-z]{2}|com|net|org|info|biz|io|tv|me|app|dev|gg|xyz|online|site|tech|cloud|live|media|"
                    r"games|game|group|link|top|club|vip|pro|world|global|asia|mobi|name|cc|ws|us|eu)\Z")
HOST_RE = re.compile(r"[a-z0-9_](?:[a-z0-9_-]{0,62}\.)+[a-z0-9-]{1,63}\Z")
DIGITS = re.compile(r"[0-9]+")


def parse_block_list(text: str) -> list:
    """The domains of an Adblock-style list (one `||domain^` a line)."""
    return [line[2:-1].lower() for line in (l.strip() for l in text.splitlines())
            if line.startswith("||") and line.endswith("^")]


def load_app_lists(lists_dir: str = LISTS_DIR, guard: bool = False) -> dict:
    """{app id: [domain, ...]} from the *.txt lists. The guard list is not an app (it stops DNS bypass services, and
    guessing new ones from a name, "dns." or "doh.", would flag half the internet): it is left out unless asked for."""
    lists = {}
    for name in sorted(os.listdir(lists_dir)):
        if name.endswith(".txt") and (guard or name != "guard.txt"):
            with open(os.path.join(lists_dir, name), encoding="utf-8") as fh:
                lists[name[:-4]] = parse_block_list(fh.read())
    return lists


def site(name: str) -> str:
    """The registrable part, near enough: "a.b.example.co.uk" -> "example.co.uk"."""
    labels = name.split(".")
    if len(labels) >= 3 and labels[-2] in SECOND_LEVEL and len(labels[-1]) == 2:
        return ".".join(labels[-3:])
    return ".".join(labels[-2:])


def strip_shared(labels: list, keep: int = 0) -> list:
    """Cuts shared platforms off the end, longest first, as long as more than `keep` labels stay."""
    cut = True
    while cut:
        cut = False
        for k in range(max(1, keep), len(labels)):
            if ".".join(labels[k:]) in SHARED:
                labels = labels[:k]
                cut = True
                break
    return labels


def unwrap(name: str) -> str:
    """A platform's alias of a host -> the host: "x.tiktokcdn-us.com.edgesuite.net" -> "x.tiktokcdn-us.com"."""
    return ".".join(strip_shared(name.split("."), keep=2))


def on_platform(name: str) -> bool:
    return any(name.endswith("." + p) for p in SHARED)


def app_labels(name: str) -> list:
    """The labels that can say whose a name is: platforms and the public suffix cut off."""
    if name in SHARED:
        return []
    labels = strip_shared(name.split("."))
    if len(labels) > 1 and TLDISH.match(labels[-1]):
        labels = labels[:-1]
        if len(labels) > 1 and labels[-1] in SECOND_LEVEL:
            labels = labels[:-1]
    return labels


def features(name: str) -> tuple:
    """The pieces the model reads: the main label, every label, pairs of neighbouring labels and the 3- to 5-letter
    pieces of each label (digits count as one "0"). A sorted tuple, so that training never depends on set order."""
    labels = [DIGITS.sub("0", label) for label in app_labels(name)]
    if not labels:
        return ()
    out = {"D:" + labels[-1]}
    for label in labels:
        out.add("L:" + label)
        padded = "^" + label + "$"
        for n in (3, 4, 5):
            for i in range(len(padded) - n + 1):
                out.add("G:" + padded[i:i + n])
    for a, b in zip(labels, labels[1:]):
        out.add("P:" + a + "." + b)
    return tuple(sorted(out))


class Cover:
    """Which app's list blocks a name: a listed domain, a name under it, or a platform's alias of either."""

    def __init__(self, lists: dict):
        self.owner = {d: sid for sid in sorted(lists) for d in lists[sid]}

    def __call__(self, name: str):
        return self._listed(name) or self._listed(unwrap(name))

    def _listed(self, name: str):
        labels = name.split(".")
        for i in range(len(labels)):
            hit = self.owner.get(".".join(labels[i:]))
            if hit:
                return hit
        return None


def app_words(lists: dict) -> dict:
    """{app id: its own words}: the main label of every whole site on its list ("tiktokcdn" from tiktokcdn.com), or of
    a host on a platform ("steamcdn-a" from steamcdn-a.akamaihd.net). A host on somebody else's site gives none:
    teams.microsoft.com must not make "microsoft" a word of Teams."""
    words = {}
    for sid in sorted(lists):
        found = set()
        for d in lists[sid]:
            labels = app_labels(d)
            if not labels:
                continue
            if d == site(d):
                word = d.split(".")[0]
            elif on_platform(d):
                word = labels[-1]
            else:
                continue
            if len(word) >= MIN_WORD:
                found.add(word)
        words[sid] = frozenset(found)
    return words


def matcher(words):
    """One regular expression that finds any of `words` (one app's, or every app's)."""
    return re.compile("|".join(re.escape(w) for w in sorted(words)) or "(?!)")


def carries(name: str, rx) -> bool:
    """Does the part of `name` that can say whose it is hold one of the words of `rx`?"""
    return rx.search(".".join(app_labels(name))) is not None


def zone(name: str, rx):
    """The shortest end of `name` (two labels at least: never a top-level domain) that still carries one of the app's
    words: what a block would cover. "pull-flv.tiktokcdn.com.wsdvs.com" -> "tiktokcdn.com.wsdvs.com", never
    "wsdvs.com", which is not TikTok's."""
    labels = name.split(".")
    for k in range(len(labels) - 2, -1, -1):
        end = ".".join(labels[k:])
        if carries(end, rx):
            return end
    return None


def sigmoid(z: float) -> float:
    if z >= 0:
        return 1.0 / (1.0 + math.exp(-z))
    e = math.exp(z)
    return e / (1.0 + e)


class Model:
    """Two stages: "is this an app's name?" (logistic regression) and "which app?" (softmax over the apps). A score
    is a sum of the weights of the name's pieces, so it is fast to compute and each weight can be read by a person."""

    def __init__(self, apps, b1, w1, b2, w2):
        self.apps, self.b1, self.w1, self.b2, self.w2 = apps, b1, w1, b2, w2

    def score(self, name: str):
        """(how sure the model is that `name` belongs to an app, 0..1; which app)."""
        fs = features(name)
        if not fs:
            return 0.0, None
        p = sigmoid(self.b1 + sum(self.w1.get(f, 0.0) for f in fs))
        z = list(self.b2)
        for f in fs:
            for c, v in self.w2.get(f, ()):
                z[c] += v
        return p, self.apps[max(range(len(z)), key=z.__getitem__)]

    def to_json(self) -> dict:
        return {"v": 1, "apps": self.apps, "b1": self.b1, "w1": self.w1, "b2": self.b2,
                "w2": {f: [list(cv) for cv in row] for f, row in self.w2.items()}}

    @classmethod
    def from_json(cls, data) -> "Model":
        """A model from its JSON form; ValueError for anything that is not one (the file is read by root)."""
        try:
            if data.get("v") != 1:
                raise ValueError("unknown model version %r" % data.get("v"))
            apps = [str(a) for a in data["apps"]]
            b2 = [float(v) for v in data["b2"]]
            w2 = {str(f): [(int(c), float(v)) for c, v in row] for f, row in data["w2"].items()}
            if not apps or len(b2) != len(apps) or any(not 0 <= c < len(apps) for row in w2.values() for c, _ in row):
                raise ValueError("the apps and the weights of the model do not match")
            return cls(apps, float(data["b1"]), {str(f): float(v) for f, v in data["w1"].items()}, b2, w2)
        except (AttributeError, KeyError, TypeError) as err:
            raise ValueError("not a model: %s" % err) from None


def load_model(path: str | None = None) -> Model:
    """The model the release ships (MODEL_FILE). OSError when it is missing, ValueError when it is not a model."""
    path = path or MODEL_FILE
    with open(path, "rb") as fh:
        raw = fh.read(MODEL_MAX_BYTES + 1)
    if len(raw) > MODEL_MAX_BYTES:
        raise ValueError("%s is bigger than %d MB" % (path, MODEL_MAX_BYTES >> 20))
    return Model.from_json(json.loads(raw, parse_constant=_no_constants))


# --------------------------------------------------------------------------- #
# Runtime data: /var/lib/sinko (root only, never reachable from the page)
# --------------------------------------------------------------------------- #
HANDLED_KINDS = ("update", "check", "power")
INSTALL_ID_RE = re.compile(r"^[0-9a-f]{32}\Z")
RESULT_STATUSES = ("ok", "failed")


def state_dir() -> str:
    """Read on every call, so tests (and a second box in a container) can point it elsewhere."""
    return os.environ.get("SINKO_STATE_DIR") or DEFAULT_STATE_DIR


def state_path(name: str) -> str:
    return os.path.join(state_dir(), name)


def _private_dir(path: str) -> None:
    os.makedirs(path, mode=0o700, exist_ok=True)
    st = os.stat(path)
    if st.st_uid != os.geteuid():
        # Files in a folder that somebody else owns could be swapped under us (the request markers, the update lock).
        raise OSError("%s belongs to another user" % path)
    # makedirs obeys the umask, and an installer may have made the directory with looser rights.
    if stat.S_IMODE(st.st_mode) & 0o077:
        os.chmod(path, 0o700)


def ensure_state_dir(sub: str = "") -> str:
    """Create the runtime directory (mode 0700: it holds the counter id and the update files); returns its path."""
    path = state_dir()
    _private_dir(path)
    if sub:
        path = os.path.join(path, sub)
        _private_dir(path)
    return path


def _fsync_dir(directory: str) -> None:
    try:
        fd = os.open(directory, os.O_RDONLY)
    except OSError:
        return
    try:
        os.fsync(fd)
    except OSError:
        pass
    finally:
        os.close(fd)


def atomic_write(path: str, data, mode: int = 0o600) -> None:
    """Replace `path` so that a reader, or a power cut, sees the old content or the new, never half of it.

    The box has no battery-backed clock and loses power without warning; a request marker that is only half
    written would be acted on twice or not at all.
    """
    raw = data.encode("utf-8") if isinstance(data, str) else data
    directory = os.path.dirname(path) or "."
    fd, tmp = tempfile.mkstemp(dir=directory, prefix="." + os.path.basename(path) + ".")
    try:
        with os.fdopen(fd, "wb") as fh:
            os.fchmod(fh.fileno(), mode)
            fh.write(raw)
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    _fsync_dir(directory)


def read_json_file(path: str, default=None):
    """The parsed JSON in `path`, or `default` when it is missing or unreadable (never raises). An integer of more than
    400 digits reads as Infinity, which every number check refuses (see _json_int)."""
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh, parse_int=_json_int)
    except (OSError, ValueError, RecursionError):
        return default


def load_handled() -> dict:
    """The request markers this box already acted on: {"update": m, "check": m, "power": m} (missing = never)."""
    data = read_json_file(state_path("handled.json"), {})
    out = {}
    if isinstance(data, dict):
        for kind in HANDLED_KINDS:
            marker = _nonce(data.get(kind))
            if marker is not None:
                out[kind] = marker
    return out


def set_handled(kind: str, marker) -> None:
    """Remember (or, with None, forget) the marker of a request. Durable before it returns."""
    ensure_state_dir()
    handled = load_handled()
    if marker is None:
        handled.pop(kind, None)
    else:
        handled[kind] = marker
    atomic_write(state_path("handled.json"), json.dumps(handled, sort_keys=True))


def install_id(create: bool = True):
    """The random id the optional counter sends. Made on first use; derived from nothing on the device."""
    try:
        with open(state_path("install-id"), encoding="ascii") as fh:
            value = fh.read().strip()
        if INSTALL_ID_RE.match(value):
            return value
    except (OSError, ValueError):
        pass
    return reset_install_id() if create else None


def reset_install_id() -> str:
    ensure_state_dir()
    value = secrets.token_hex(16)
    atomic_write(state_path("install-id"), value + "\n")
    return value


def box_id():
    """box.json's `boxId`: a random number of this box, so that the app knows it again after the router gave it another
    address. Made once (the installer's first box.json, or the first start of a ready-made box, after the seal removed the
    golden unit's) and never sent anywhere. Not the counter's install-id: that one is forgotten when the counter is
    switched off, and it must not be readable on the home network. None when it can be neither read nor made (the program
    run by an account other than root): box.json then says null, and a later write by root fills it in."""
    try:
        with open(state_path("box-id"), encoding="ascii") as fh:
            value = fh.read().strip()
        if INSTALL_ID_RE.match(value):
            return value
    except (OSError, ValueError):
        pass
    try:
        ensure_state_dir()
        value = secrets.token_hex(16)
        atomic_write(state_path("box-id"), value + "\n")
        return value
    except OSError:
        return None


def write_update_result(status: str, from_version, to_version, error, at: float, rolled_back=None,
                        transient: bool = False) -> dict:
    """What the update runner leaves for the scheduler (see architecture.md, "Update flow").

    `rolledBack` (copied into the shared state): True when the previous version runs again and passed the self-check,
    False when the update failed and that could not be shown, None when nothing failed. `transient` (only for the
    scheduler's own retry rule, never shown): the failure was the network or the disk, not the release."""
    result = {"status": status, "from": from_version, "to": to_version, "error": error, "at": at,
              "rolledBack": rolled_back if isinstance(rolled_back, bool) else None, "transient": bool(transient)}
    ensure_state_dir()
    atomic_write(state_path("update-result.json"), json.dumps(result, sort_keys=True))
    return result


def read_update_result():
    """The runner's result as parse_state would accept it, or None when there is no (valid) result."""
    raw = read_json_file(state_path("update-result.json"))
    if not isinstance(raw, dict) or raw.get("status") not in RESULT_STATUSES or not _is_count(raw.get("at")):
        return None
    err = raw.get("error")
    failed = raw["status"] == "failed"
    return {"status": raw["status"],
            "from": raw.get("from") if isinstance(raw.get("from"), str) and SEMVER_RE.fullmatch(raw["from"]) else None,
            "to": raw.get("to") if isinstance(raw.get("to"), str) and SEMVER_RE.fullmatch(raw["to"]) else None,
            "error": err[:200] if isinstance(err, str) and err.strip() else None,
            "at": float(raw["at"]),
            "rolledBack": raw.get("rolledBack") if failed and isinstance(raw.get("rolledBack"), bool) else None,
            "transient": failed and raw.get("transient") is True}


def clear_update_result() -> None:
    try:
        os.unlink(state_path("update-result.json"))
    except FileNotFoundError:
        pass


def note_failure(result: dict) -> None:
    """Keep, for the scheduler's own retry rule, whether the last failed run was only the network or the disk (the
    state the page sees has no place for it, and it must not: it is not for parents). Never raises."""
    try:
        ensure_state_dir()
        atomic_write(state_path("update-failure.json"), json.dumps(
            {"at": result["at"], "to": result["to"], "transient": bool(result.get("transient"))}, sort_keys=True))
    except OSError as err:
        log.debug("could not note the failure: %s", err)


def failure_is_transient(update: dict) -> bool:
    """Was the failure that the state shows (the same run: same time, same release) only the network or the disk?"""
    raw = read_json_file(state_path("update-failure.json"))
    return (isinstance(raw, dict) and raw.get("transient") is True and raw.get("at") == update["at"]
            and raw.get("to") == update["to"])


# --------------------------------------------------------------------------- #
# The scheduler's pulse: /run/sinko/heartbeat.json (memory, so that writing it every pass costs the SD card nothing)
# --------------------------------------------------------------------------- #
DEFAULT_RUN_DIR = "/run/sinko"
HEARTBEAT_FILE = "heartbeat.json"


def run_dir() -> str:
    return os.environ.get("SINKO_RUN_DIR") or DEFAULT_RUN_DIR


def write_heartbeat(ticks: int, pid=None, version=None, mono=None) -> None:
    """Say that this process has just finished a pass of the scheduler (the rules were read and applied)."""
    path = run_dir()
    _private_dir(path)
    beat = {"v": 1, "pid": os.getpid() if pid is None else pid, "version": VERSION if version is None else version,
            "ticks": ticks, "mono": time.monotonic() if mono is None else mono}
    atomic_write(os.path.join(path, HEARTBEAT_FILE), json.dumps(beat, sort_keys=True))


def read_heartbeat():
    """The last heartbeat as {"pid", "version", "ticks", "mono"}, or None when there is none that makes sense.
    `mono` is on the clock of the whole machine (CLOCK_MONOTONIC), so another process can compare it with its own."""
    raw = read_json_file(os.path.join(run_dir(), HEARTBEAT_FILE))
    if not isinstance(raw, dict):
        return None
    pid, ticks, mono, version = raw.get("pid"), raw.get("ticks"), raw.get("mono"), raw.get("version")
    if not (_is_int(pid) and pid > 0 and _is_int(ticks) and ticks >= 0 and _is_number(mono) and isinstance(version, str)):
        return None
    return {"pid": pid, "version": version, "ticks": ticks, "mono": float(mono)}


class LogGate:
    """Lets a message through the first time and then at most once every `period` seconds per key: a failure that
    repeats every few seconds must not fill the log (the box's disk is a memory card)."""

    def __init__(self, period: float = 1800, monotonic=time.monotonic):
        self.period = period
        self._mono = monotonic
        self._last = {}

    def allow(self, key) -> bool:
        now = self._mono()
        last = self._last.get(key)
        if last is not None and now - last < self.period:
            return False
        if len(self._last) > 200:                          # a failure that never repeats its words must not grow this
            self._last.clear()
        self._last[key] = now
        return True


def open_lock_file(name: str) -> int:
    """A file descriptor on /var/lib/sinko/<name>, for flock. The file lives in the state folder (mode 0700, root only),
    never in a folder every user can write to (/run/lock): there another user could keep the lock, or, with
    fs.protected_regular (Debian's default), make root's own open of an existing file fail. It is opened without
    following a link, and anything but a plain file of ours is refused."""
    ensure_state_dir()
    path = state_path(name)
    fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0), 0o600)
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid():
            raise OSError("%s is not a plain file of this user" % path)
    except BaseException:
        os.close(fd)
        raise
    return fd


class RunLock:
    """An flock on /var/lib/sinko/lock: held for the whole of an update or rollback, so two never run at once.

    The kernel drops the lock when the holder dies, so a crashed runner cannot block the next one. `is_held()` is
    how the scheduler tells whether a runner is still alive.
    """

    def __init__(self):
        self._fh = None

    def acquire(self) -> bool:
        """True when this object now holds the lock (the file: see open_lock_file)."""
        fd = open_lock_file("lock")
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            os.close(fd)
            return False
        except BaseException:
            os.close(fd)
            raise
        self._fh = os.fdopen(fd, "r+b", buffering=0)
        return True

    def release(self) -> None:
        if self._fh is not None:
            self._fh.close()               # closing drops the flock
            self._fh = None

    def __enter__(self):
        return self

    def __exit__(self, *exc):
        self.release()

    @staticmethod
    def is_held() -> bool:
        probe = RunLock()
        try:
            if probe.acquire():
                probe.release()
                return False
        except OSError:
            return False                   # a lock that cannot even be opened is not held by a runner
        return True


# --------------------------------------------------------------------------- #
# Client matching (mirrors Pi-hole FTL)
# --------------------------------------------------------------------------- #
# FTL (get_client_groupids() in src/database/gravity-db.c) chooses a client's
# groups like this: first the client rows whose IP address or subnet contains the
# address the query came from, and among those the longest prefix (highest id on a
# tie). Only when no such row exists does it try the device's MAC address, then
# its host name, then its interface. So an IP or subnet row silently overrides a
# child's MAC row, and every pb-* rule on that MAC row is ignored.
# /api/network/devices returns only 10 devices with 3 addresses each by default.
NETWORK_QUERY = "/api/network/devices?max_devices=200&max_addresses=50"
MAC_RE = re.compile(r"^[0-9a-f]{2}([:-][0-9a-f]{2}){5}$", re.IGNORECASE)


def is_mac(value) -> bool:
    return isinstance(value, str) and bool(MAC_RE.match(value))


def parse_ip(text):
    """ipaddress object for an IPv4/IPv6 address (a %zone suffix is ignored), else None."""
    try:
        return ipaddress.ip_address(str(text).split("%", 1)[0])
    except ValueError:
        return None


def parse_net(text):
    """ip_network for a client row that is an address or subnet; None for MAC, host name and :interface rows."""
    try:
        return ipaddress.ip_network(str(text).split("%", 1)[0], strict=False)
    except ValueError:
        return None


def device_ips(dev: dict) -> list:
    """Every address FTL has seen for a network-table device (an 'ip-<addr>' entry has just that one)."""
    ips = [i.get("ip") for i in dev.get("ips") or [] if i.get("ip")]
    hw = dev.get("hwaddr") or ""
    if hw.startswith("ip-") and hw[3:] not in ips:
        ips.append(hw[3:])
    return ips


def find_device(devices: list, client: str):
    """The network-table entry for a client row, matched by MAC or by one of its addresses; None if unknown."""
    if is_mac(client):
        return next((d for d in devices if (d.get("hwaddr") or "").lower() == client.lower()), None)
    want = parse_ip(client)
    if want is None:
        return None
    return next((d for d in devices if want in {parse_ip(i) for i in device_ips(d)}), None)


def winning_row(ip, clients: list):
    """The client row FTL applies to source address `ip`: longest matching prefix, highest id on a tie."""
    best = None
    for c in clients:
        net = parse_net(c.get("client"))
        if net is None or net.version != ip.version or ip not in net:
            continue
        key = (net.prefixlen, c.get("id") or 0)
        if best is None or key > best[0]:
            best = (key, c)
    return best[1] if best else None


def needed_pb_groups(groups: dict, catalog: dict, paused: bool = False) -> set:
    """Ids of the pb-* groups a child's effective client row must have (not Default)."""
    names = [G_KIDS, G_GUARD, G_OFFLINE] + [svc_group(s["id"]) for s in catalog["services"]]
    if paused:
        names.append(G_PAUSED)
    return {groups[n]["id"] for n in names if n in groups}


def shadowing_rows(kid: dict, devices: list, clients: list, needed: set) -> list:
    """IP/subnet client rows that FTL will use instead of this MAC-registered child's own row.

    Only rows that lack some of the child's pb-* groups count: a duplicate IP row
    that carries them all filters correctly. Returns [{"client", "groups", "ip"}].
    """
    if not is_mac(kid.get("client")):
        return []
    dev = find_device(devices, kid["client"])
    found = {}
    for ip_text in device_ips(dev) if dev else []:
        ip = parse_ip(ip_text)
        row = winning_row(ip, clients) if ip is not None else None
        if row is not None and needed - set(row.get("groups", [])):
            found.setdefault(row["client"], {"client": row["client"], "groups": row.get("groups", []), "ip": ip_text})
    return list(found.values())


def group_names(ids, groups: dict) -> list:
    by_id = {g["id"]: g["name"] for g in groups.values()}
    return [by_id.get(i, "#%s" % i) for i in sorted(ids)]


# --------------------------------------------------------------------------- #
# Pi-hole API client
# --------------------------------------------------------------------------- #
class ApiError(Exception):
    def __init__(self, status: int, message: str):
        super().__init__("HTTP %s: %s" % (status, message))
        self.status = status


# Errors that mean "Pi-hole (or the network to it) did not answer properly": the session is dropped and the pass is
# tried again with a back-off. Anything else is a bug in this program or a state it did not foresee. An answer that is
# shorter than its Content-Length (FTL restarting, a connection closed half way) raises http.client.IncompleteRead,
# which is neither an OSError nor a ValueError.
TRANSPORT_ERRORS = (ApiError, OSError, ValueError, http.client.HTTPException)


def ftl_config(key: str) -> str:
    # No "-q": with it, reading a boolean that is false exits with status 1.
    out = subprocess.run(["pihole-FTL", "--config", key],
                         check=True, capture_output=True, text=True, timeout=30)
    return out.stdout.strip()


def ftl_set_config(key: str, value: str) -> None:
    subprocess.run(["pihole-FTL", "--config", key, value],
                   check=True, capture_output=True, text=True, timeout=30)


def parse_cli_array(text: str) -> list:
    """Parse `pihole-FTL --config <array>` output: [ a b, c d ] (unquoted)."""
    text = text.strip()
    if text.startswith("[") and text.endswith("]"):
        text = text[1:-1]
    items = []
    for part in text.split(","):
        part = part.strip()
        if not part:
            continue
        try:
            part = json.loads('"%s"' % part)     # values are JSON-escaped
        except ValueError:
            pass
        items.append(part)
    return items


def merged_hosts(current: list, ip: str, hostname: str) -> list:
    keep = [h for h in current if hostname not in h.split()[1:]]
    return keep + ["%s %s" % (ip, hostname)]


def discover_base_url() -> str:
    """Build a local API URL from webserver.port, e.g. '80o,443os,[::]:80o'."""
    env = os.environ.get("SINKO_API_URL")
    if env:
        return env.rstrip("/")
    try:
        ports = ftl_config("webserver.port")
    except (OSError, subprocess.SubprocessError):
        ports = "80"
    http_port = https_port = None
    for tok in ports.split(","):
        tok = tok.strip()
        if not tok or tok.startswith("["):
            continue
        tok = tok.rsplit(":", 1)[-1]          # strip "127.0.0.1:" style binds
        digits = "".join(c for c in tok if c.isdigit())
        flags = tok[len(digits):]
        if not digits or "r" in flags:        # 'r' = redirect-only port
            continue
        if "s" in flags:
            https_port = https_port or digits
        else:
            http_port = http_port or digits
    if http_port:
        return "http://127.0.0.1:%s" % http_port
    if https_port:
        return "https://127.0.0.1:%s" % https_port
    return "http://127.0.0.1:80"


def _session_of(payload) -> dict:
    """The `session` object of an answer from /api/auth ({} when the answer is not shaped like one)."""
    sess = payload.get("session") if isinstance(payload, dict) else None
    return sess if isinstance(sess, dict) else {}


def _is_int(value) -> bool:
    return isinstance(value, int) and not isinstance(value, bool)


def _text(value) -> str:
    return value if isinstance(value, str) else ""


def _id_list(value) -> list:
    return [v for v in value if _is_int(v)] if isinstance(value, list) else []


def _clean_group(row: dict):
    if not isinstance(row.get("name"), str) or not _is_int(row.get("id")):
        return None
    return dict(row, comment=_text(row.get("comment")), enabled=bool(row.get("enabled")))


def _clean_list(row: dict):
    if not isinstance(row.get("address"), str):
        return None
    return dict(row, comment=_text(row.get("comment")), groups=_id_list(row.get("groups")), enabled=bool(row.get("enabled")))


def _clean_client(row: dict):
    if not isinstance(row.get("client"), str):
        return None
    return dict(row, comment=_text(row.get("comment")), groups=_id_list(row.get("groups")))


def _clean_domain(row: dict):
    if not isinstance(row.get("domain"), str):
        return None
    return dict(row, comment=_text(row.get("comment")), groups=_id_list(row.get("groups")), enabled=bool(row.get("enabled")))


def _rows(payload, key: str, clean) -> list:
    """The entries of `payload[key]` that are shaped the way `clean` needs. Pi-hole answers come from a service that
    is restarted, restored from backups and edited by hand: one odd row must not stop the scheduler."""
    rows = payload.get(key) if isinstance(payload, dict) else None
    if not isinstance(rows, list):
        return []
    out = []
    for row in rows:
        cleaned = clean(row) if isinstance(row, dict) else None
        if cleaned is not None:
            out.append(cleaned)
    return out


class Api:
    def __init__(self, base: str | None = None, password: str | None = None):
        self.base = (base or discover_base_url()).rstrip("/")
        self._password = password
        self.sid = None
        self._ctx = ssl.create_default_context()
        # Local self-signed certificate: we only ever talk to 127.0.0.1.
        self._ctx.check_hostname = False
        self._ctx.verify_mode = ssl.CERT_NONE

    # -- transport --
    def _raw(self, method: str, path: str, body=None):
        data = None if body is None else json.dumps(body).encode()
        req = urllib.request.Request(self.base + path, data=data, method=method)
        req.add_header("Accept", "application/json")
        if data is not None:
            req.add_header("Content-Type", "application/json")
        if self.sid:
            req.add_header("sid", self.sid)
        try:
            with urllib.request.urlopen(req, timeout=20, context=self._ctx) as resp:
                raw = resp.read()
                return resp.status, (json.loads(raw) if raw else {})
        except urllib.error.HTTPError as err:
            raw = err.read()
            try:
                payload = json.loads(raw) if raw else {}
            except ValueError:
                payload = {"error": {"message": raw[:200].decode(errors="replace")}}
            return err.code, payload

    def request(self, method: str, path: str, body=None, _retry=True):
        status, payload = self._raw(method, path, body)
        if status == 401 and _retry:
            self.login()
            return self.request(method, path, body, _retry=False)
        if status >= 400:
            err = payload.get("error") if isinstance(payload, dict) else None
            msg = err.get("message", str(err)) if isinstance(err, dict) else str(payload)
            if isinstance(err, dict) and err.get("hint"):
                msg += " (" + str(err["hint"]) + ")"
            raise ApiError(status, msg)
        return payload

    def wait_ready(self, timeout: float = 120) -> None:
        """Block until FTL answers on its API (it restarts during installs)."""
        deadline = time.time() + timeout
        while True:
            try:
                status, _ = self._raw("GET", "/api/auth")
                if status in (200, 401):
                    return
            except TRANSPORT_ERRORS:
                pass
            if time.time() > deadline:
                raise ApiError(0, "Pi-hole API did not come up at " + self.base)
            time.sleep(2)

    def password_set(self) -> bool:
        status, payload = self._raw("GET", "/api/auth")
        return not (status == 200 and _session_of(payload).get("valid"))

    def login(self):
        self.sid = None
        status, payload = self._raw("GET", "/api/auth")
        if status == 200 and _session_of(payload).get("valid"):
            return  # no password configured
        pw = self._password
        if pw is None:
            with open(CLI_PW_FILE, encoding="utf-8") as fh:   # regenerated on FTL restart
                pw = fh.read().strip()
        status, payload = self._raw("POST", "/api/auth", {"password": pw})
        sess = _session_of(payload)
        if status != 200 or not sess.get("valid"):
            raise ApiError(status, "login to the Pi-hole API failed")
        self.sid = sess.get("sid") if isinstance(sess.get("sid"), str) else None

    def logout(self):
        """Give the session back: FTL has a small, fixed number of them (webserver.api.max_sessions)."""
        if self.sid:
            try:
                self._raw("DELETE", "/api/auth")
            finally:
                self.sid = None

    # -- helpers --
    @staticmethod
    def q(value: str) -> str:
        return urllib.parse.quote(value, safe="")

    def groups(self) -> list:
        return _rows(self.request("GET", "/api/groups"), "groups", _clean_group)

    def group_map(self) -> dict:
        return {g["name"]: g for g in self.groups()}

    def lists(self) -> list:
        return _rows(self.request("GET", "/api/lists"), "lists", _clean_list)

    def clients(self) -> list:
        return _rows(self.request("GET", "/api/clients"), "clients", _clean_client)

    def network_devices(self) -> list:
        """Devices FTL has seen on the network ([] when unavailable)."""
        try:
            return _rows(self.request("GET", NETWORK_QUERY), "devices", lambda d: d)
        except ApiError:
            return []

    def domains(self) -> list:
        return _rows(self.request("GET", "/api/domains"), "domains", _clean_domain)

    def add_group(self, name, comment, enabled):
        self.request("POST", "/api/groups", {"name": name, "comment": comment, "enabled": enabled})

    def put_group(self, name, comment, enabled, new_name=None):
        self.request("PUT", "/api/groups/" + self.q(name),
                     {"name": new_name or name, "comment": comment, "enabled": enabled})

    def delete_group(self, name):
        self.request("DELETE", "/api/groups/" + self.q(name))

    def flush_dns(self):
        """Clear the box's DNS cache so a changed rule applies at once.

        Pi-hole keeps answers it learned before a block and keeps serving them (even stale ones), so an app that was
        just blocked can keep working for a while. A restart of the resolver is quick and empties that cache. Best
        effort: a failure here must never stop a rule change that already happened.
        """
        try:
            self.request("POST", "/api/action/restartdns")
        except Exception as e:                        # noqa: BLE001
            log.warning("could not clear the DNS cache: %s", e)

    def put_client(self, client, comment, groups):
        self.request("PUT", "/api/clients/" + self.q(client),
                     {"comment": comment, "groups": groups})


# --------------------------------------------------------------------------- #
# State (JSON stored in the pb-state group description)
# --------------------------------------------------------------------------- #
def parse_state(raw) -> dict:
    """The shared state from the text stored in the pb-state group, always a complete and valid one.

    TOTAL: whatever is stored there (the page writes it, but so can anybody who can open Pi-hole's admin pages, and a
    backup brings back whatever was in it) gives a state, and never an exception: this is called on every pass of the
    scheduler, and one that raises stops bedtime, timers and every request from the page. Numbers are judged the way the
    page's JavaScript judges them (see _is_number); `tests/fixtures/state-cases.json` is the spec both parsers meet."""
    try:
        return _parse_state(raw)
    except Exception as err:             # a last net: every field below is checked on its own, so this is "cannot happen"
        if _PARSE_GATE.allow("parse_state"):
            log.error("the shared state could not be read (%s: %s); using the default one", type(err).__name__,
                      short_text(err, 80))
        return json.loads(json.dumps(DEFAULT_STATE))


_PARSE_GATE = LogGate()                  # that message at most every half hour: parse_state runs on every pass


def _json_int(text: str):
    """json's way of reading an integer: as long as it is written, except that a number of more than 400 digits (no finite
    double has that many: the page's JSON.parse reads it as Infinity, which it then refuses) is Infinity here too. Python
    would otherwise raise for one of more than 4300 digits and refuse the whole text, where the page keeps the rest."""
    return float("inf") if len(text) > 400 else int(text)


def _parse_state(raw) -> dict:
    state = json.loads(json.dumps(DEFAULT_STATE))
    try:
        text = raw if isinstance(raw, (str, bytes, bytearray)) else None          # only text is ever stored there
        data = json.loads(text, parse_constant=_no_constants, parse_int=_json_int) if text else {}
    except (ValueError, RecursionError):
        data = {}
    if not isinstance(data, dict):
        data = {}
    timer = data.get("timer")
    if isinstance(timer, dict) and timer.get("mode") in ("free", "block") and _is_number(timer.get("until")):
        snap = timer.get("snapshot") if isinstance(timer.get("snapshot"), dict) else {}
        services = snap.get("services") if isinstance(snap.get("services"), dict) else {}   # a list or text here must not crash the tick
        state["timer"] = {
            "mode": timer["mode"],
            "until": float(timer["until"]),
            "snapshot": {
                "services": {str(k): bool(v) for k, v in services.items()},
                "offline": bool(snap.get("offline", False)),
            },
        }
    sched = data.get("schedule")
    if isinstance(sched, dict):
        s = state["schedule"]
        s["enabled"] = bool(sched.get("enabled", False))
        for key in ("start", "end"):
            if valid_hhmm(sched.get(key)):
                s[key] = sched[key]
        days = sched.get("days")
        if isinstance(days, list):
            s["days"] = sorted({int(d) for d in days if _is_number(d) and d == int(d) and 0 <= d <= 6})
    state["scheduleActive"] = bool(data.get("scheduleActive", False))
    state["update"] = _parse_update(data.get("update"))
    state["power"] = _parse_power(data.get("power"))
    tel = data.get("telemetry")
    if isinstance(tel, dict) and isinstance(tel.get("on"), bool):
        state["telemetry"] = {"on": tel["on"]}
    comm = data.get("community")
    if isinstance(comm, dict) and _is_count(comm.get("online")) and _is_number(comm.get("at")):
        state["community"] = {"online": int(float(comm["online"])), "at": float(comm["at"])}
    setup = data.get("setup")
    if isinstance(setup, dict):
        state["setup"] = {"done": setup.get("done") is True}
    learn = data.get("learn")
    if isinstance(learn, dict):
        state["learn"] = {"on": learn.get("on") is True}
    terms = data.get("terms")
    if isinstance(terms, dict) and _is_count(terms.get("agreed")) and terms["agreed"] == int(terms["agreed"]) \
            and terms["agreed"] <= TERMS_MAX:
        state["terms"] = {"agreed": int(terms["agreed"])}
    return state


def _no_constants(token):
    """json accepts NaN and Infinity, which JSON (and the page's JSON.parse) does not: the whole description is then garbage."""
    raise ValueError(token)


# What counts as "blank" in update.error: the same characters in the page (web/pb-core.js), spelled out so that neither
# language's idea of whitespace (Python's \x1c-\x1f and \x85, JavaScript's byte order mark) decides.
_BLANK_RE = re.compile("[\t\n\x0b\x0c\r \xa0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000\ufeff]*")


def _is_number(value) -> bool:
    """A finite number, exactly as the page's `typeof x === 'number' && isFinite(x)` says. The test is the conversion to
    a double itself: an integer of more than 308 digits is a valid Python int that the page reads as Infinity, and the
    first float() of it raises OverflowError (comparing it with infinity would not)."""
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return False
    try:
        return math.isfinite(float(value))
    except OverflowError:
        return False


def _is_count(value) -> bool:
    return _is_number(value) and value >= 0


def _plain(value):
    """The number as the page holds it: an integer that a double cannot hold exactly is the double (the page has no other
    kind), so both programs write back, and compare, the same value."""
    return float(value) if isinstance(value, int) and abs(value) > 2 ** 53 else value


def _nonce(value):
    """A request marker the page writes (the time in ms) and the scheduler acts on once: a number or a short string."""
    if _is_number(value) and value > 0:
        return _plain(value)
    if isinstance(value, str) and 0 < len(value) <= 40:
        return value
    return None


def _parse_update(raw) -> dict:
    out = dict(DEFAULT_STATE["update"])
    if not isinstance(raw, dict):
        return out
    out["auto"] = raw.get("auto") is True
    out["request"] = _nonce(raw.get("request"))
    out["checkRequest"] = _nonce(raw.get("checkRequest"))
    for key in ("latest", "from", "to"):
        v = raw.get(key)
        out[key] = v if isinstance(v, str) and SEMVER_RE.fullmatch(v) else None
    notes = raw.get("notes")
    out["notes"] = notes if isinstance(notes, str) and NOTES_RE.fullmatch(notes) else None
    for key in ("checked", "at"):
        v = raw.get(key)
        out[key] = _plain(v) if _is_count(v) else 0
    out["status"] = raw.get("status") if raw.get("status") in UPDATE_STATUSES else "idle"
    err = raw.get("error")
    out["error"] = err[:200] if isinstance(err, str) and not _BLANK_RE.fullmatch(err) else None
    out["rolledBack"] = raw.get("rolledBack") if isinstance(raw.get("rolledBack"), bool) else None
    return out


def _parse_power(raw) -> dict:
    out = dict(DEFAULT_STATE["power"])
    if isinstance(raw, dict) and raw.get("action") in POWER_ACTIONS:
        out["action"] = raw["action"]
        out["request"] = _nonce(raw.get("request"))
        if out["request"] is None:
            out["action"] = None
    return out


HHMM_RE = re.compile(r"[0-9]{2}:[0-9]{2}")


def valid_hhmm(value) -> bool:
    if not isinstance(value, str) or not HHMM_RE.fullmatch(value):
        return False
    return int(value[:2]) <= 23 and int(value[3:]) <= 59


def in_schedule(sched: dict, now: dt.datetime) -> bool:
    """True if `now` is inside the bedtime window.

    days use JavaScript numbering (0 = Sunday). A window that crosses midnight
    belongs to the day it STARTS on, e.g. Thu 21:00 -> Fri 06:00 is "Thursday".
    """
    if not sched.get("enabled") or not sched.get("days"):
        return False
    start = int(sched["start"][:2]) * 60 + int(sched["start"][3:])
    end = int(sched["end"][:2]) * 60 + int(sched["end"][3:])
    if start == end:
        return False
    minute = now.hour * 60 + now.minute
    js_today = (now.weekday() + 1) % 7            # Python Mon=0 -> JS Sun=0
    js_yesterday = (js_today + 6) % 7
    days = set(sched["days"])
    if start < end:
        return js_today in days and start <= minute < end
    if minute >= start:
        return js_today in days
    return minute < end and js_yesterday in days


# --------------------------------------------------------------------------- #
# Updates (docs/maintainers/architecture.md, "Update flow")
# --------------------------------------------------------------------------- #
DEFAULT_REPO_SLUG = "iret33/sinko"
DEFAULT_REPO_URL = "https://github.com/iret33/sinko.git"
RELEASE_ASSET = "sinko.tar.gz"
MAX_DOWNLOAD = 20 * 1024 * 1024        # a release is a few MB; anything bigger is not ours
MAX_UNPACKED = 100 * 1024 * 1024       # gzip can inflate a small download a thousandfold
MAX_MEMBERS = 5000
# Free space an update or a rollback needs. ONE number, the installer's: install.sh refuses to start an update or a
# rollback (a box that already has Sinko) with 200 MB or less free, and a first install with 1 GB or less (that one may
# have to install Pi-hole). An engine that asked for less would download, install, fail in the installer's first check,
# fail again in the rollback's, and report a box that was never touched as one that could not be put back. The doctor
# warns earlier (DISK_WARN_BYTES), so there is time to make room.
MIN_FREE_BYTES = 200 * 1024 * 1024
CHECK_TIMEOUT = 10
DOWNLOAD_TIMEOUT = 30                  # for each wait on the network ...
DOWNLOAD_DEADLINE = 600                # ... and for a whole download
# The installer's `sinko setup` may wait for a run of gravity that is going (up to GRAVITY_LOCK_WAIT), then does its own
# (up to GRAVITY_RUN_LIMIT); the rest of the installer takes minutes. A slow night must not become a rolled-back update.
INSTALL_TIMEOUT = GRAVITY_LOCK_WAIT + GRAVITY_RUN_LIMIT + 900
SELFCHECK_WAIT = 90                    # the installer has just restarted FTL and the scheduler: give them time
REQUIRED_MEMBERS = ("sinko/VERSION", "sinko/install.sh", "sinko/bin/sinko")
REF_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._/-]{0,100}\Z")      # never starts with "-": it reaches git's command line
SLUG_RE = re.compile(r"^[A-Za-z0-9_.-]{1,60}/[A-Za-z0-9_.-]{1,60}\Z")
TAG_RE = re.compile(r"^v(\d{1,4}\.\d{1,4}\.\d{1,4})\Z")
CACHE_RE = re.compile(r"^sinko-(\d{1,4}\.\d{1,4}\.\d{1,4})\.tar\.gz\Z")
REPO_URL_RE = re.compile(r"^(?:https://github\.com/|git@github\.com:)([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+?)(?:\.git)?/?\Z")


class UpdateError(Exception):
    """A failure with a message a parent can read: short, and never containing a secret."""


class UpdateLocked(UpdateError):
    """Another update or rollback is running."""


class TransientError(UpdateError):
    """A failure that goes away by itself: the internet was down, GitHub answered with an error or a limit, the disk
    was full. The scheduler tries such an update again within the hour; after any other failure it leaves that
    release alone for a week."""


class DownloadError(TransientError):
    """The release could not be fetched (nothing was installed)."""


def parse_version(text):
    """(major, minor, patch) for 'X.Y.Z', else None."""
    if isinstance(text, str) and SEMVER_RE.fullmatch(text):          # fullmatch: "$" alone lets a trailing newline through
        return tuple(int(part) for part in text.split("."))
    return None


def is_newer(candidate, current) -> bool:
    a, b = parse_version(candidate), parse_version(current)
    return a is not None and b is not None and a > b


def short_text(text, limit: int = 200) -> str:
    text = " ".join(str(text).split())
    return text if len(text) <= limit else text[:limit - 1] + "…"


def release_settings(conf=None) -> dict:
    """Where releases come from. The environment beats /etc/sinko/config beats the built-in GitHub address."""
    conf = read_config() if conf is None else conf

    def pick(key: str) -> str:
        return os.environ.get(key) or conf.get(key) or ""
    repo = pick("SINKO_REPO") or DEFAULT_REPO_URL
    slug = pick("SINKO_REPO_SLUG") or (REPO_URL_RE.match(repo).group(1) if REPO_URL_RE.match(repo) else "") \
        or DEFAULT_REPO_SLUG
    if not SLUG_RE.match(slug) or "." in slug.split("/") or ".." in slug.split("/"):
        raise UpdateError("The update source in the settings (%s) is not a GitHub name like owner/name." % short_text(slug, 60))
    base = (pick("SINKO_RELEASE_BASE") or "https://github.com/%s/releases" % slug).rstrip("/")
    api = pick("SINKO_RELEASE_API") or "https://api.github.com/repos/%s/releases/latest" % slug
    if not (web_address(base) and not urllib.parse.urlsplit(base).query):
        raise UpdateError("The update address in the settings is not a secure web address (it must start with https://).")
    if not web_address(api):
        raise UpdateError("The update address in the settings is not a secure web address (it must start with https://).")
    return {"slug": slug, "base": base, "api": api, "repo": repo, "ref": pick("SINKO_REF") or "latest"}


LOOPBACK_HOSTS = ("127.0.0.1", "localhost", "::1")


def web_address(url) -> bool:
    """True for an address updates may come from: https, or plain http to this machine only (the tests' local server).
    The program and the page are replaced with what such an address serves, so nothing that anybody on the home
    network could alter on the way is acceptable. No user name or password, no fragment."""
    if not isinstance(url, str) or not url or any(c.isspace() or ord(c) < 32 or ord(c) == 127 for c in url):
        return False
    try:
        parts = urllib.parse.urlsplit(url)
        host, _ = parts.hostname, parts.port
    except ValueError:
        return False
    if not host or parts.username is not None or parts.password is not None or parts.fragment:
        return False
    return parts.scheme == "https" or (parts.scheme == "http" and host in LOOPBACK_HOSTS)


def classify_ref(ref):
    """('latest', None), ('tag', 'X.Y.Z') for vX.Y.Z, or ('branch', ref): the developer path (git)."""
    if not isinstance(ref, str) or not REF_RE.match(ref) or ".." in ref:
        raise UpdateError("'%s' is not a version name." % short_text(ref, 40))
    if ref == "latest":
        return "latest", None
    tag = TAG_RE.match(ref)
    return ("tag", tag.group(1)) if tag else ("branch", ref)


class _SafeRedirect(urllib.request.HTTPRedirectHandler):
    """Follow redirects (GitHub serves release files from another host), but only to https (or to this machine)."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        if not web_address(newurl):
            raise urllib.error.HTTPError(req.full_url, code, "redirect to an insecure address refused", headers, fp)
        return super().redirect_request(req, fp, code, msg, headers, newurl)


def http_fetch(url, max_bytes, timeout=DOWNLOAD_TIMEOUT, deadline=DOWNLOAD_DEADLINE, dest=None):
    """GET `url`. Returns the body, or writes it to the file `dest` and returns None.

    A body over `max_bytes` is refused while it arrives, not after. `timeout` only limits each single wait, so a
    server that sends a byte a second would hold the update lock for hours: `deadline` limits the whole transfer.
    """
    if not web_address(url):                                  # urllib would also open file:// and ftp:// addresses
        raise UpdateError("The update address is not a secure web address.")
    request = urllib.request.Request(url, headers={"User-Agent": "sinko/" + VERSION})
    started = time.monotonic()
    total = 0
    chunks = []
    out = None
    try:
        if dest:
            out = open(dest, "wb")
        with urllib.request.build_opener(_SafeRedirect).open(request, timeout=timeout) as resp:
            read = getattr(resp, "read1", resp.read)         # read1 returns what has arrived; read() would wait for a full block
            length = resp.headers.get("Content-Length")
            if length and length.isdigit() and int(length) > max_bytes:
                raise UpdateError("The download is larger than allowed.")
            while True:
                if time.monotonic() - started > deadline:
                    raise DownloadError("The download took too long.")
                chunk = read(65536)
                if not chunk:
                    break
                total += len(chunk)
                if total > max_bytes:
                    raise UpdateError("The download is larger than allowed.")
                if out:
                    out.write(chunk)
                else:
                    chunks.append(chunk)
    except UpdateError:
        raise
    except urllib.error.HTTPError as err:
        err.close()
        raise DownloadError("The server answered HTTP %s for %s." % (err.code, url.rsplit("/", 1)[-1][:60]))
    except (urllib.error.URLError, OSError, http.client.HTTPException, ValueError) as err:
        raise DownloadError("Could not download %s (%s)." % (url.rsplit("/", 1)[-1][:60],
                                                            short_text(getattr(err, "reason", None) or err, 80)))
    finally:
        if out:
            out.close()
    return None if dest else b"".join(chunks)


def pick_release(data):
    """The newest usable release in GitHub's answer as {"version", "tag"}, or None.

    Understands the object of /releases/latest and the list of /releases. Drafts and prereleases never count, and
    neither does a tag that is not exactly vX.Y.Z.
    """
    best = None
    for item in data if isinstance(data, list) else [data]:
        if not isinstance(item, dict) or item.get("draft") or item.get("prerelease"):
            continue
        tag = item.get("tag_name")
        match = TAG_RE.match(tag) if isinstance(tag, str) else None
        if match and (best is None or parse_version(match.group(1)) > parse_version(best["version"])):
            best = {"version": match.group(1), "tag": tag}
    return best


def notes_url(slug: str, tag: str):
    """The release page, built from the configured repository, not copied from what a server said."""
    url = "https://github.com/%s/releases/tag/%s" % (slug, tag)
    return url if NOTES_RE.fullmatch(url) else None


def fetch_latest_release(settings: dict, fetch=http_fetch):
    body = fetch(settings["api"], 1 << 20, CHECK_TIMEOUT, 30)
    try:
        data = json.loads(body.decode("utf-8"))
    except (ValueError, RecursionError):
        raise UpdateError("The answer about the newest version was not understood.")
    return pick_release(data)


def check_for_update(conf=None, running: str = VERSION, fetch=http_fetch, ref=None):
    """The release this box could update to, {"version", "tag", "notes"}, or None when it is up to date.

    Raises UpdateError when GitHub cannot be asked. A box that follows a git branch (a developer box) is
    never offered a release.
    """
    settings = release_settings(conf)
    kind, value = classify_ref(ref or settings["ref"])
    if kind == "branch":
        return None
    release = {"version": value, "tag": "v" + value} if kind == "tag" else fetch_latest_release(settings, fetch)
    if release is None or not is_newer(release["version"], running):
        return None
    return dict(release, notes=notes_url(settings["slug"], release["tag"]))


def parse_sha256(text: str) -> str:
    """The hash in a `sha256sum` file: one line, `<64 hex>  sinko.tar.gz`."""
    lines = [line.strip() for line in text.splitlines() if line.strip()]
    match = re.match(r"^([0-9A-Fa-f]{64})(?:\s+\*?(\S+))?$", lines[0]) if len(lines) == 1 else None
    if not match or (match.group(2) and match.group(2) != RELEASE_ASSET):
        raise UpdateError("The checksum file is not in the expected form.")
    return match.group(1).lower()


def sha256_file(path: str) -> str:
    digest = hashlib.sha256()
    with open(path, "rb") as fh:
        for block in iter(lambda: fh.read(1 << 16), b""):
            digest.update(block)
    return digest.hexdigest()


def release_url(settings: dict, tag, asset: str) -> str:
    if tag:
        return "%s/download/%s/%s" % (settings["base"], tag, asset)
    return "%s/latest/download/%s" % (settings["base"], asset)


def download_release(settings: dict, tag, dest: str, fetch=http_fetch) -> None:
    """Fetch sinko.tar.gz and its checksum, and keep the file at `dest` only if the two agree."""
    try:
        fetch(release_url(settings, tag, RELEASE_ASSET), MAX_DOWNLOAD, DOWNLOAD_TIMEOUT, DOWNLOAD_DEADLINE, dest=dest)
        text = fetch(release_url(settings, tag, RELEASE_ASSET + ".sha256"), 4096, CHECK_TIMEOUT, 30)
        try:
            want = parse_sha256(text.decode("utf-8"))
        except UnicodeDecodeError:
            raise UpdateError("The checksum file is not in the expected form.")
        if sha256_file(dest) != want:
            raise UpdateError("The download does not match its checksum, so it was not installed.")
        fsync_path(dest)                        # the rollback copy must survive a power cut right after the rename
    except BaseException:
        try:
            os.unlink(dest)
        except OSError:
            pass
        raise


def fsync_path(path: str) -> None:
    fd = os.open(path, os.O_RDONLY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def sync_disks() -> None:
    """Flush everything written so far to the memory card. The box loses power without warning, and a file that was
    only written (not flushed) can come back empty after the next start: the program, the lists, the page."""
    try:
        os.sync()
    except (AttributeError, OSError):
        pass


class _CappedReader:
    """Stops a tarball that unpacks to far more than it should before it fills the disk or the memory."""

    def __init__(self, fh, limit: int):
        self._fh = fh
        self._left = limit

    def read(self, size=-1):
        size = self._left + 1 if size is None or size < 0 else min(size, self._left + 1)
        data = self._fh.read(size)
        self._left -= len(data)
        if self._left < 0:
            raise UpdateError("The download is not a valid Sinko release (it unpacks to too much data).")
        return data


def _not_a_release(why: str) -> UpdateError:
    return UpdateError("The download is not a valid Sinko release (%s)." % why)


def unpack_release(tar_path: str, dest: str) -> str:
    """Unpack a release into the empty directory `dest` and return the version it carries.

    Every entry is checked before it is written: only plain files and folders, only below sinko/, no absolute path,
    no "..", and no link of any kind, so nothing can be written outside `dest` or through a link. (The release has
    no links; this is stricter than "no link that leaves the tree" on purpose.) Done by hand instead of with
    tarfile's `filter="data"`, which only exists from Python 3.12 (and in late 3.9-3.11 patch releases).
    """
    files = set()
    total = 0
    real_dest = os.path.realpath(dest)
    try:
        with open(tar_path, "rb") as raw, gzip.GzipFile(fileobj=raw) as gz, \
                tarfile.open(fileobj=_CappedReader(gz, MAX_UNPACKED + MAX_MEMBERS * 1024 + (1 << 20)), mode="r|") as tar:
            for count, member in enumerate(tar, 1):
                if count > MAX_MEMBERS:
                    raise _not_a_release("too many files")
                if member.name.startswith("/"):
                    raise _not_a_release("a file name starts with /")
                parts = [p for p in member.name.split("/") if p not in ("", ".")]
                if ".." in parts:
                    raise _not_a_release("a file name contains ..")
                if not parts and member.isdir():
                    continue                                  # "./", the folder itself
                if not parts or parts[0] != "sinko":
                    raise _not_a_release("a file is outside the sinko folder")
                target = os.path.join(dest, *parts)
                if os.path.commonpath([real_dest, os.path.realpath(target)]) != real_dest:
                    raise _not_a_release("a file would land outside the folder")
                if member.isdir():
                    os.makedirs(target, exist_ok=True)
                    continue
                if member.type not in (tarfile.REGTYPE, tarfile.AREGTYPE):
                    raise _not_a_release("%s is a link or a special file" % short_text(member.name, 60))
                key = "/".join(parts)
                total += member.size
                if key in files or total > MAX_UNPACKED:
                    raise _not_a_release("a file appears twice or the files are too big")
                files.add(key)
                os.makedirs(os.path.dirname(target), exist_ok=True)
                fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
                with os.fdopen(fd, "wb") as out:
                    shutil.copyfileobj(tar.extractfile(member), out, 1 << 16)
                    os.fchmod(out.fileno(), 0o755 if member.mode & 0o111 else 0o644)    # never setuid, never group-writable
    except UpdateError:
        raise
    except (tarfile.TarError, OSError, EOFError, zlib.error) as err:
        raise _not_a_release(short_text(err, 80))
    missing = [name for name in REQUIRED_MEMBERS if name not in files]
    if missing:
        raise _not_a_release("%s is missing" % missing[0])
    top = os.path.join(dest, "sinko")
    for root, _dirs, _names in os.walk(top):
        os.chmod(root, 0o755)
    version = read_version_file(top)
    if version is None:
        raise _not_a_release("its VERSION file is not a version number")
    return version


def read_version_file(tree: str):
    try:
        with open(os.path.join(tree, "VERSION"), encoding="ascii") as fh:
            text = fh.read(64).strip()
    except (OSError, ValueError):
        return None
    return text if parse_version(text) else None


def install_source(top: str) -> str:
    """Make `top` the tree /opt/sinko/src (the last downloaded source). The old tree is renamed aside first, so a
    failure at any point leaves one complete tree behind."""
    src = os.path.join(APP_DIR, "src")
    old = src + ".old"
    shutil.rmtree(old, ignore_errors=True)
    if os.path.lexists(src):
        os.rename(src, old)
    try:
        os.rename(top, src)
    except OSError:
        if os.path.lexists(old):
            os.rename(old, src)
        raise
    shutil.rmtree(old, ignore_errors=True)
    return src


def cache_dir() -> str:
    return os.path.join(state_dir(), "cache")


def cache_file(version: str) -> str:
    return os.path.join(cache_dir(), "sinko-%s.tar.gz" % version)


def cached_versions() -> list:
    """Versions stored for offline rollback, newest first."""
    try:
        names = os.listdir(cache_dir())
    except OSError:
        return []
    found = [m.group(1) for m in (CACHE_RE.match(n) for n in names) if m]
    return sorted(found, key=parse_version, reverse=True)


def drop_cached(version: str) -> None:
    try:
        os.unlink(cache_file(version))
    except OSError:
        pass


def prune_cache(installed: str) -> None:
    """Keep two releases: the installed one, and the newest older one (the rollback target).

    "Two newest by number" would throw away the installed release after a rollback, and the older one that a second
    rollback needs.
    """
    versions = cached_versions()
    keep = {installed}
    older = [v for v in versions if is_newer(installed, v)]
    newer = [v for v in versions if is_newer(v, installed)]
    if older:
        keep.add(older[0])
    elif newer:
        keep.add(newer[0])
    for version in versions:
        if version not in keep:
            drop_cached(version)


def run_installer(src: str, ref: str) -> int:
    """The installer shipped in the release, told to use `src` as it is and never to ask anything."""
    env = dict(os.environ, SINKO_SRC=src, SINKO_NONINTERACTIVE="1", SINKO_REF=ref)
    try:
        return subprocess.run(["bash", os.path.join(src, "install.sh")], env=env, cwd="/", stdin=subprocess.DEVNULL,
                              timeout=INSTALL_TIMEOUT).returncode
    except subprocess.TimeoutExpired:
        return 124
    except OSError:
        return 127


def run_installed_selfcheck(wait: float = SELFCHECK_WAIT):
    """(ok, detail) from `sinko selfcheck` of the program that is installed NOW.

    It must be a new process: this one still runs the old code, whose VERSION would not match the page the
    installer has just put in place.
    """
    exe = os.path.join(APP_DIR, "bin", "sinko")
    if not os.path.isfile(exe):
        return False, "the installed program is missing"
    try:
        done = subprocess.run([sys.executable, exe, "selfcheck", "--wait", str(int(wait))], capture_output=True,
                              text=True, timeout=wait + 120)
    except (OSError, subprocess.SubprocessError) as err:
        return False, short_text(err, 80)
    if done.returncode == 0:
        return True, ""
    failed = [l.strip()[4:].strip() for l in done.stdout.splitlines() if l.strip().startswith("FAIL")]
    return False, short_text(failed[0] if failed else (done.stderr.strip() or "it exited with an error"), 120)


class Updater:
    """`sinko update` and `sinko rollback`. Everything that touches the network or the machine can be replaced
    (tests give it a local server and a fake installer)."""

    def __init__(self, conf=None, out=print, fetch=http_fetch, installer=run_installer, selfcheck=None, clock=time.time):
        self.conf = read_config() if conf is None else conf
        self.out = out
        self.fetch = fetch
        self.installer = installer
        self.selfcheck = selfcheck or run_installed_selfcheck
        self.clock = clock

    # ----- entry points -----
    def check(self):
        return check_for_update(self.conf, fetch=self.fetch)

    @staticmethod
    def _take_lock() -> "RunLock":
        lock = RunLock()
        try:
            got = lock.acquire()
        except OSError as err:
            raise UpdateError("The folder the update works in (%s) cannot be used (%s)." % (state_dir(), short_text(err, 80)))
        if not got:
            raise UpdateLocked("Another update is already running.")
        return lock

    def update(self, ref=None, force=False, confirm=None):
        """Install the newest release (or `ref`). Returns the result dict that was also written to
        update-result.json, or None when `confirm` said no. Raises UpdateLocked when a run is already going.

        The result says whether the previous version is back (`rolledBack`, see architecture.md): True only when the
        box runs the version it had before AND passes its own check, which is only claimed after the check ran."""
        lock = self._take_lock()
        current = VERSION
        target = {"to": None, "touched": False}      # touched: the installer has been started on this box
        try:
            clear_update_result()                    # a result from an earlier run must never pass for this one
            try:
                outcome = self._update(ref, force, confirm, current, target)
            except UpdateError as err:
                outcome = self._failure(target, str(err), isinstance(err, TransientError))
            except Exception as err:                 # a bug or an odd machine must not leave the box half updated and silent
                log.exception("update failed unexpectedly")
                outcome = self._failure(target, "The update stopped unexpectedly (%s)." % type(err).__name__, False)
            if outcome is None:
                return None
            status, to_version, error, rolled_back, transient = outcome
            return write_update_result(status, current, to_version, short_text(error) if error else None, self.clock(),
                                       rolled_back=rolled_back, transient=transient)
        finally:
            lock.release()

    def _failure(self, target, error, transient):
        """The outcome of a run that stopped by an exception. Before the installer started the box is as it was, and
        it is said to be back and working only when its own check agrees; after that, nobody can say."""
        rolled_back = False
        if not target["touched"]:
            try:
                rolled_back = bool(self.selfcheck()[0])
            except Exception:
                rolled_back = False
        return "failed", target["to"], error, rolled_back, transient

    def rollback(self):
        """Put the newest older release stored on this box back. Returns {"status", "from", "to", "error"}."""
        try:
            lock = self._take_lock()
        except UpdateLocked:
            raise
        except UpdateError as err:
            return {"status": "failed", "from": VERSION, "to": None, "error": str(err)}
        try:
            self._require_free_space()
            older = [v for v in cached_versions() if is_newer(VERSION, v)]
            if not older:
                return {"status": "failed", "from": VERSION, "to": None,
                        "error": "No earlier version is stored on this box."}
            self.out("Going back from %s to %s ..." % (VERSION, older[0]))
            ok, why = self._rollback_to(older[0], release_settings(self.conf)["ref"])
            return {"status": "ok" if ok else "failed", "from": VERSION, "to": older[0],
                    "error": None if ok else short_text(why)}
        except UpdateError as err:
            return {"status": "failed", "from": VERSION, "to": None, "error": str(err)}
        finally:
            lock.release()

    # ----- the update itself -----
    def _update(self, ref, force, confirm, current, target):
        settings = release_settings(self.conf)
        ref = ref or settings["ref"]
        kind, value = classify_ref(ref)
        self._clean_leftovers()
        self._require_free_space()                       # before anything is downloaded, unpacked or installed
        os.makedirs(APP_DIR, exist_ok=True)
        if kind == "branch":
            if confirm and not confirm(current, None):
                return None
            self.out("Fetching %s from %s ..." % (ref, settings["repo"]))
            src, version = self._fetch_branch(ref, settings["repo"])
            target["to"] = version
        else:
            release = self._resolve(kind, value, settings)
            if release is None:
                self.out("No release is published yet; Sinko %s stays." % current)
                return "ok", current, None, None, False
            if release["version"] and not force and not is_newer(release["version"], current):
                if kind == "tag":
                    self.out("Sinko %s is installed and %s is not newer (add --force to install it anyway)."
                             % (current, release["tag"]))
                else:
                    self.out("Sinko %s is already the newest version." % current)
                return "ok", current, None, None, False
            target["to"] = release["version"]
            if confirm and not confirm(current, release["version"]):
                return None
            self.out("Downloading Sinko %s ..." % (release["version"] or "(latest)"))
            version, src = self._fetch_release(settings, release, current, force, target)
            if src is None:
                self.out("Sinko %s is already the newest version." % current)
                return "ok", current, None, None, False
        self._ensure_rollback_copy(settings, current)
        try:
            self._require_free_space()                   # what was just written (downloads, the unpacked tree) came out of it
        except TransientError:
            if version != current:
                drop_cached(version)
            raise
        self.out("Installing Sinko %s ..." % version)
        target["touched"] = True
        ok, why = self._install_and_check(src, ref)
        if ok:
            prune_cache(version)
            self.out("Sinko is now at version %s." % version)
            return "ok", version, None, None, False
        if version != current:
            drop_cached(version)              # a release that failed here is no rollback target
            self.out("%s Going back to %s ..." % (why, current))
            # The installer saves the ref it is given as SINKO_REF. The version that is put back gets the ref the box had
            # BEFORE this run (settings, read at the start), not the one that was asked for and failed: otherwise the
            # box would stay pinned to a release that does not work here (and never see the fixed one after it).
            back_ok, back_why = self._rollback_to(current, settings["ref"])
        else:
            back_ok, back_why = False, "it is the version that was just installed"
        # The reason is for whoever helps (and for the log): English, short, and never a command to type. The page
        # tells the parent in their own language what to do, from `rolledBack`.
        if back_ok:
            error = "%s The previous version (%s) was put back." % (why, current)
        elif back_why.startswith("no earlier copy"):
            error = "%s There is no earlier copy on this box to go back to." % why
        else:
            error = "%s Going back to %s did not work either (%s)." % (why, current, back_why)
        return "failed", version, error, bool(back_ok), False

    @staticmethod
    def _require_free_space() -> None:
        """Stop, with a reason a person can act on, when the card has no room for the installer: the installer asks for
        the same amount (see MIN_FREE_BYTES) and would stop at its very first line. Nothing has been changed yet, and
        that is said, because `rolledBack` of such a failure comes from a check of the box as it was. More than the
        limit is needed, not the limit itself, as in the installer."""
        free = shutil.disk_usage(ensure_state_dir("cache")).free
        if free <= MIN_FREE_BYTES:
            raise TransientError("There is not enough free space on the box: %d MB are free and more than %d MB are needed. "
                                 "Nothing on the box was changed." % (free >> 20, MIN_FREE_BYTES >> 20))

    def _resolve(self, kind, value, settings):
        """{"version", "tag"} of the release to install; version None means "whatever /latest/ is" (see below)."""
        if kind == "tag":
            return {"version": value, "tag": "v" + value}
        try:
            return fetch_latest_release(settings, self.fetch)
        except UpdateError as err:
            # GitHub's API answers 60 requests an hour per address and is blocked on some networks, while the download
            # address is not. The tarball names its own version, which is compared after unpacking.
            self.out("Could not ask which version is newest (%s); trying the latest download directly." % err)
            return {"version": None, "tag": None}

    def _fetch_release(self, settings, release, current, force, target):
        """Download, verify and unpack. Returns (version, installed source dir), or (version, None) if not newer."""
        cache = ensure_state_dir("cache")
        fd, tarball = tempfile.mkstemp(dir=cache, prefix=".dl-", suffix=".tar.gz")
        os.close(fd)
        stage = tempfile.mkdtemp(dir=APP_DIR, prefix=".stage-")
        try:
            download_release(settings, release["tag"], tarball, self.fetch)
            self.out("Checking the download ...")
            version = unpack_release(tarball, stage)
            if release["version"] and version != release["version"]:
                raise UpdateError("The download says it is version %s, not %s." % (version, release["version"]))
            target["to"] = version
            if not release["version"] and not force and not is_newer(version, current):
                return version, None
            os.replace(tarball, cache_file(version))
            _fsync_dir(cache)
            try:
                return version, install_source(os.path.join(stage, "sinko"))
            except BaseException:
                if version != current:
                    drop_cached(version)
                raise
        finally:
            shutil.rmtree(stage, ignore_errors=True)
            try:
                os.unlink(tarball)
            except OSError:
                pass

    def _fetch_branch(self, ref, repo):
        """The developer path: git clone/fetch of the configured repository. Returns (source dir, its version)."""
        if repo.startswith("-"):
            raise UpdateError("The update source in the settings is not valid.")
        src = os.path.join(APP_DIR, "src")
        env = dict(os.environ, GIT_TERMINAL_PROMPT="0")

        def git(*args):
            try:
                subprocess.run(["git"] + list(args), check=True, env=env, stdin=subprocess.DEVNULL,
                               capture_output=True, text=True, timeout=600)
            except subprocess.CalledProcessError as err:
                raise UpdateError("git could not fetch %s (%s)." % (ref, short_text(err.stderr.strip(), 100)))
            except (OSError, subprocess.SubprocessError) as err:
                raise UpdateError("git could not run (%s)." % short_text(err, 80))
        if os.path.isdir(os.path.join(src, ".git")):
            git("-C", src, "fetch", "--quiet", "--depth", "1", "origin", ref)
            git("-C", src, "checkout", "--quiet", "--force", "FETCH_HEAD")
        else:
            stage = tempfile.mkdtemp(dir=APP_DIR, prefix=".stage-")
            try:
                git("clone", "--quiet", "--depth", "1", "--branch", ref, "--", repo, os.path.join(stage, "sinko"))
                install_source(os.path.join(stage, "sinko"))
            finally:
                shutil.rmtree(stage, ignore_errors=True)
        for name in REQUIRED_MEMBERS:
            if not os.path.isfile(os.path.join(src, name.split("/", 1)[1])):
                raise UpdateError("The fetched source has no %s." % name.split("/", 1)[1])
        version = read_version_file(src)
        if version is None:
            raise UpdateError("The fetched source has no valid VERSION file.")
        return src, version

    def _ensure_rollback_copy(self, settings, current):
        """The installed release is never in the cache on the first update (the installer put it there, not us):
        fetch it again now, while the network is known to work. Without it a failed update cannot be undone."""
        if os.path.isfile(cache_file(current)):
            return
        cache = ensure_state_dir("cache")
        fd, tarball = tempfile.mkstemp(dir=cache, prefix=".dl-", suffix=".tar.gz")
        os.close(fd)
        try:
            download_release(settings, "v" + current, tarball, self.fetch)
            os.replace(tarball, cache_file(current))
            _fsync_dir(cache)
        except UpdateError as err:
            self.out("Note: no copy of the current version is stored and it could not be fetched (%s); "
                     "an update that fails could not be undone automatically." % err)
        finally:
            try:
                os.unlink(tarball)
            except OSError:
                pass

    def _install_and_check(self, src, ref):
        """Run the installer on `src`, then the self-check of what it installed. Returns (ok, reason).

        Everything is flushed to the card before the installer starts (the downloaded copy and the source tree must
        survive a power cut in the middle of it) and again before the check."""
        sync_disks()
        try:
            rc = self.installer(src, ref)
        except Exception:
            log.exception("could not run the installer")
            return False, "The installer could not be started."
        if rc != 0:
            return False, "The installer stopped with an error (exit status %s)." % rc
        sync_disks()
        self.out("Checking the installation ...")
        try:
            ok, detail = self.selfcheck()
        except Exception:
            log.exception("self-check could not run")
            ok, detail = False, "it could not run"
        if not ok:
            return False, "The new version did not pass its own check (%s)." % (detail or "no reason given")
        return True, ""

    def _rollback_to(self, version, ref):
        """Reinstall a stored release. Returns (ok, reason)."""
        path = cache_file(version)
        if not os.path.isfile(path):
            return False, "no earlier copy is stored on this box"
        os.makedirs(APP_DIR, exist_ok=True)
        stage = tempfile.mkdtemp(dir=APP_DIR, prefix=".stage-")
        try:
            if unpack_release(path, stage) != version:
                return False, "the stored copy is damaged"
            src = install_source(os.path.join(stage, "sinko"))
        except UpdateError as err:
            return False, str(err)
        finally:
            shutil.rmtree(stage, ignore_errors=True)
        ok, why = self._install_and_check(src, ref)
        return ok, "" if ok else why

    @staticmethod
    def _clean_leftovers():
        """Staging folders and half downloads of a run that was cut off (power loss, killed service)."""
        for pattern_dir, prefix in ((APP_DIR, ".stage-"), (cache_dir(), ".dl-")):
            try:
                names = os.listdir(pattern_dir)
            except OSError:
                continue
            for name in names:
                if name.startswith(prefix):
                    path = os.path.join(pattern_dir, name)
                    if os.path.isdir(path) and not os.path.islink(path):
                        shutil.rmtree(path, ignore_errors=True)
                    else:
                        try:
                            os.unlink(path)
                        except OSError:
                            pass


# --------------------------------------------------------------------------- #
# Self-check: "did the update leave a working box?" (fast, no DNS probing)
# --------------------------------------------------------------------------- #
def webroot() -> str:
    if os.environ.get("SINKO_WEBROOT"):
        return os.environ["SINKO_WEBROOT"]
    value, err = ftl_try("webserver.paths.webroot")
    return value if value and err is None else "/var/www/html"


def unit_active(name: str) -> bool:
    try:
        return subprocess.run(["systemctl", "is-active", "--quiet", name], timeout=10).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


# A scheduler that dies a second after every start is "active" for that second and "activating (auto-restart)" for the
# ten (RestartSec) in between, so a single `systemctl is-active` is wrong about it half the time. What proves a
# scheduler works is that the same process has stayed up for longer than one such cycle AND has finished passes.
SCHEDULER_UNIT = "sinko"
SCHEDULER_PROOF_SECONDS = 20          # up without a restart for this long: longer than RestartSec plus a crash
SCHEDULER_PROOF_TICKS = 2             # ... and it has finished at least this many passes (the first, then 15 s later)
SCHEDULER_HEARTBEAT_FRESH = 60        # seconds: four passes
SCHEDULER_CRASHES = 2                 # restarts by systemd after which "starting" is no longer believed


def unit_state(name: str, mono=None):
    """{"active", "age", "pid", "restarts"} of a systemd unit, or None when systemd cannot be asked. `age` is the time
    in seconds the unit has been active without a break (None when it is not active)."""
    mono = mono or time.monotonic
    try:
        out = subprocess.run(["systemctl", "show", "-p", "ActiveState", "-p", "ActiveEnterTimestampMonotonic",
                              "-p", "MainPID", "-p", "NRestarts", name],
                             capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    if out.returncode != 0:
        return None
    props = dict(line.split("=", 1) for line in out.stdout.splitlines() if "=" in line)

    def number(key):
        try:
            return int(props.get(key, "0") or 0)
        except ValueError:
            return 0
    active = props.get("ActiveState") == "active"
    entered = number("ActiveEnterTimestampMonotonic")
    # CLOCK_MONOTONIC in microseconds, the same clock as time.monotonic() on Linux
    age = max(0.0, mono() - entered / 1e6) if active and entered > 0 else None
    return {"active": active, "age": age, "pid": number("MainPID"), "restarts": number("NRestarts")}


def unit_active_for(name: str, seconds: float = SCHEDULER_PROOF_SECONDS) -> bool:
    """Active, and without a break for at least `seconds`."""
    state = unit_state(name)
    return bool(state and state["active"] and state["age"] is not None and state["age"] >= seconds)


def scheduler_status(unit: str = SCHEDULER_UNIT, mono=None):
    """(state, text) about the scheduler. state: "stopped", "starting" (up less than SCHEDULER_PROOF_SECONDS),
    "crashing" (systemd has had to restart it again and again), "idle" (up, but no finished pass of this very process
    and this very version), or "ok"."""
    mono = mono or time.monotonic
    info = unit_state(unit, mono)
    if info is None or not info["active"]:
        return "stopped", "the scheduler service is not running"
    age = info["age"] if info["age"] is not None else 0.0
    if info["restarts"] >= SCHEDULER_CRASHES and age < 120:
        return "crashing", "the scheduler service keeps stopping and being restarted (%d restarts, up for %d s now)" % (
            info["restarts"], age)
    if age < SCHEDULER_PROOF_SECONDS:
        return "starting", "the scheduler service started %d s ago" % age
    beat = read_heartbeat()
    if beat is None or beat["pid"] != info["pid"]:
        return "idle", "the scheduler service is up but has not finished a pass yet"
    if beat["version"] != VERSION:
        return "idle", "the scheduler that runs is version %s, not %s" % (short_text(beat["version"], 20), VERSION)
    if beat["ticks"] < SCHEDULER_PROOF_TICKS:
        return "idle", "the scheduler has finished only %d pass(es) in %d s" % (beat["ticks"], age)
    if not 0 <= mono() - beat["mono"] <= SCHEDULER_HEARTBEAT_FRESH:
        return "idle", "the scheduler has not finished a pass for %d s" % max(0, mono() - beat["mono"])
    return "ok", "the scheduler service has run for %d s and keeps finishing its passes" % age


def referenced_page_files(index_html: str) -> list:
    """The /pb/... files the start page asks for: scripts, style sheets, icons, the manifest."""
    found = []
    for match in re.finditer(r'''(?:src|href)\s*=\s*["']/pb/([^"'?#\s]+)''', index_html):
        name = match.group(1)
        if ".." not in name.split("/") and name not in found:
            found.append(name)
    return found


def page_file_problems(root: str, src_web=None) -> list:
    """What is missing (or empty) among the page's files: a page that lacks one of its scripts shows nothing at all.
    `root` is the web root. Checked: index.html, version.txt, every /pb/ file index.html names, and every file of the
    installed release's web folder (`src_web`, when it is there) that the installer copies: the files directly in it
    (index.html goes to the web root, the others into pb/) and the files directly in fonts/, nothing deeper and no
    file whose name starts with a dot, exactly the installer's own rule (install_files in install.sh: web/* and
    web/fonts/*). A file the installer leaves out is not missing."""
    wanted = ["index.html", "pb/app.js", "pb/version.txt", "pb/services.json"]       # the page cannot start without these
    try:
        with open(os.path.join(root, "index.html"), encoding="utf-8", errors="replace") as fh:
            wanted += ["pb/" + name for name in referenced_page_files(fh.read(1 << 20))]
    except OSError:
        pass
    if src_web and os.path.isdir(src_web):
        for folder, prefix in ((src_web, ""), (os.path.join(src_web, "fonts"), "fonts/")):
            try:
                names = sorted(os.listdir(folder))
            except OSError:
                continue
            for name in names:
                if name.startswith(".") or not os.path.isfile(os.path.join(folder, name)):
                    continue
                wanted.append("index.html" if prefix + name == "index.html" else "pb/" + prefix + name)
    problems = []
    for name in dict.fromkeys(wanted):
        try:
            size = os.stat(os.path.join(root, name)).st_size
        except OSError:
            problems.append(name)
            continue
        if size == 0:
            problems.append(name + " (empty)")
    return problems


def installed_source_web():
    """The web folder of the source tree the installed version came from (/opt/sinko/src), or None when that tree is
    not there or is not this version's."""
    src = os.path.join(APP_DIR, "src")
    if read_version_file(src) != VERSION:
        return None
    path = os.path.join(src, "web")
    return path if os.path.isdir(path) else None


def page_version(root=None):
    """The version the installed page says it is (pb/version.txt in the web root), or None when it says none."""
    try:
        with open(os.path.join(root or webroot(), "pb", "version.txt"), encoding="utf-8") as fh:
            return fh.read(64).strip() or None
    except (OSError, ValueError):
        return None


class PageWatch:
    """What the scheduler asks, once a minute, about the installed page: its version. The web root comes from Pi-hole's
    settings (a subprocess), so it is asked once and kept. When Pi-hole cannot say, the usual place is looked at if the
    page is there, and otherwise nothing is known (an error, not "no page"): a box must not be reinstalled because a
    question was not answered."""

    DEFAULT_ROOT = "/var/www/html"

    def __init__(self):
        self._root = None

    def version(self):
        root = self._root or os.environ.get("SINKO_WEBROOT")
        if not root:
            value, err = ftl_try("webserver.paths.webroot")
            if value and err is None:
                self._root = root = value
            elif os.path.isdir(os.path.join(self.DEFAULT_ROOT, "pb")):
                root = self.DEFAULT_ROOT
            else:
                raise OSError("the web root cannot be asked of Pi-hole just now (%s)" % short_text(err or "no answer", 60))
        return page_version(root)


def selfcheck_round(catalog: dict, scheduler=None) -> list:
    """[(ok, text)], one per check. `scheduler` replaces the check of the scheduler service (the scheduler itself,
    which has just been started and checks itself, cannot be asked whether it is running)."""
    results = []

    def add(ok: bool, text: str) -> None:
        results.append((bool(ok), text))
    api = None
    try:
        api = Api()
        api.login()
        add(True, "Pi-hole API reachable, signed in with the CLI password")
    except Exception as err:                 # a check that cannot run FAILS: it must never end the process with a traceback
        api = None
        add(False, "Pi-hole API reachable, signed in with the CLI password (%s)" % short_text(err, 80))
    groups = lists = None
    if api is not None:
        try:
            groups, lists = api.group_map(), api.lists()
        except Exception as err:
            groups = None
            reason = "could not be read: %s" % short_text(err, 60)
    else:
        reason = "needs the Pi-hole API"
    if groups is not None:
        wanted = [G_KIDS, G_GUARD, G_OFFLINE, G_PAUSED, G_STATE] + [svc_group(s["id"]) for s in catalog["services"]]
        missing = [n for n in wanted if n not in groups]
        add(not missing, "all groups present" + (" (missing: %s)" % ", ".join(missing[:3]) if missing else ""))
        registered = {l.get("comment") for l in lists}
        absent = [i for i in [s["id"] for s in catalog["services"]] + ["guard"] if LIST_COMMENT_PREFIX + i not in registered]
        add(not absent, "every list registered" + (" (missing: %s)" % ", ".join(absent[:3]) if absent else ""))
    else:
        add(False, "all groups present (%s)" % reason)
        add(False, "every list registered (%s)" % reason)
    if api is not None:
        try:
            api.logout()
        except Exception:
            pass
    if scheduler is None:
        state, text = scheduler_status()
        add(state == "ok", text)
    else:
        add(*scheduler())
    root = webroot()
    problems = page_file_problems(root, installed_source_web())
    add(not problems, "page files installed in %s%s" % (root, " (missing: %s)" % ", ".join(problems[:3]) if problems else ""))
    shown = page_version(root)
    add(shown == VERSION, "page and program are the same version (page: %s, program: %s)" % (shown or "none", VERSION))
    return results


def run_selfcheck(wait: float = 0, out=print, sleep=time.sleep, clock=time.monotonic, catalog=None) -> int:
    """Print one line per check; the exit status is 1 if any failed. With `wait`, a failing round is repeated until
    it passes or the time is up: right after an install, FTL and the scheduler are still starting (the scheduler is
    only believed once it has stayed up for SCHEDULER_PROOF_SECONDS and finished passes)."""
    catalog = catalog or load_catalog()
    deadline = clock() + max(0.0, wait)
    while True:
        results = selfcheck_round(catalog)
        if all(ok for ok, _ in results) or clock() >= deadline:
            break
        sleep(3)
    for ok, text in results:
        out("  " + ("ok" if ok else "FAIL").ljust(6) + text)
    return 0 if all(ok for ok, _ in results) else 1


# --------------------------------------------------------------------------- #
# Controller
# --------------------------------------------------------------------------- #
CLOCK_HOLD_UPTIME = 600            # seconds after boot during which an unsynchronised clock is not believed


def read_uptime():
    try:
        with open(os.environ.get("SINKO_UPTIME_FILE", "/proc/uptime"), encoding="ascii") as fh:
            return float(fh.read().split()[0])
    except (OSError, ValueError, IndexError):
        return None


def ntp_synchronized(timeout: float = 1, on_timeout=None):
    """True / False as `timedatectl` says, None when it cannot say (no systemd, an answer that makes no sense).
    `on_timeout` is what a command that has not answered within `timeout` seconds counts as: None, unless the caller
    knows better (the clock guard counts it as "not yet")."""
    try:
        done = subprocess.run(["timedatectl", "show", "-p", "NTPSynchronized", "--value"], capture_output=True,
                              text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        return on_timeout
    except (OSError, subprocess.SubprocessError):
        return None
    answer = done.stdout.strip().lower() if done.returncode == 0 else ""
    return True if answer == "yes" else False if answer == "no" else None


class ClockGuard:
    """Is the box's clock worth believing yet?

    The Orange Pi has no real-time clock: after a power cut it starts with the time it last saved, hours or days
    ago, until it has reached an internet time server. Acting on that time would switch bedtime off in the middle
    of the night, or end a timer that has not run out. So while the box has been up less than ten minutes and
    timedatectl says the clock is NOT synchronised, the current state is held. A timedatectl that does not answer in
    time counts as "no" as well: right after a boot it has to be started by systemd (it exits when idle) on a card that
    FTL is also reading, and a second can be too little; asked again five seconds later, it answers. A machine that
    cannot tell at all (no systemd, no such command) is believed, and so is every box after ten minutes, because a home
    without internet must still get its bedtime.
    """

    def __init__(self, uptime=read_uptime, synchronized=None, monotonic=time.monotonic):
        self._uptime = uptime
        self._probe = synchronized or (lambda: ntp_synchronized(on_timeout=False))
        self._mono = monotonic
        self._synced = False
        self._asked = None             # (monotonic time, answer) of the last "no"
        self._holding = False

    def trusted(self) -> bool:
        up = self._uptime()
        if up is None or up >= CLOCK_HOLD_UPTIME or self._synced:
            return self._release()
        now = self._mono()
        if self._asked is None or now - self._asked[0] >= 5:        # the tick and the side jobs both ask, a few times
            answer = self._probe()
            if answer is True:
                self._synced = True
                return self._release()
            self._asked = (now, answer)
        if self._asked[1] is False:
            if not self._holding:
                self._holding = True
                log.info("the clock is not synchronised yet: holding bedtime and timers for up to %d minutes",
                         int((CLOCK_HOLD_UPTIME - up) // 60) + 1)
            return False
        return self._release()

    def _release(self) -> bool:
        if self._holding:
            self._holding = False
            log.info("the clock is trusted now: bedtime and timers follow it again")
        return True


class Controller:
    def __init__(self, api: Api, catalog: dict, base: str | None = None, clock_trusted=None):
        self.api = api
        self.catalog = catalog
        self.base = base or lists_base()
        self.clock_trusted = clock_trusted         # a callable; None = always believe the clock
        self._pending_kids = []

    # ----- setup -----
    def setup(self, run_gravity=True, legacy=True) -> None:
        """Create or repair every pb-* object. `legacy`: also clean up after the 1.x installer (that touches objects
        that are not ours, and only makes sense when Sinko is being installed, not when the scheduler repairs itself)."""
        if legacy:
            self.migrate_legacy()
        groups = self.api.group_map()

        def ensure(name, comment, enabled):
            if name not in groups:
                self.api.add_group(name, comment, enabled)
                log.debug("created group %s", name)

        ensure(G_KIDS, "sinko: kid devices", True)
        ensure(G_GUARD, "sinko: stops DNS bypass on kid devices", True)
        ensure(G_OFFLINE, "sinko: internet off for kid devices", False)
        ensure(G_PAUSED, "sinko: paused kid devices", True)
        ensure(G_STATE, json.dumps(DEFAULT_STATE, separators=(",", ":")), False)
        wanted = {s["id"] for s in self.catalog["services"]}
        for s in self.catalog["services"]:
            ensure(svc_group(s["id"]), "sinko: " + s["name"], False)

        # pb-paused must stay enabled, pb-state must stay disabled.
        groups = self.api.group_map()
        if not groups[G_PAUSED]["enabled"]:
            self.api.put_group(G_PAUSED, groups[G_PAUSED].get("comment") or "", True)
        if groups[G_STATE]["enabled"]:
            self.api.put_group(G_STATE, groups[G_STATE].get("comment") or "", False)
        gid = {n: g["id"] for n, g in groups.items()}

        # Block-all regex used by pb-offline and pb-paused. Pi-hole keeps one entry per (type, kind, domain), so when
        # the owner already has a "^.*$" deny rule of their own (an allow-list-only Pi-hole) Sinko cannot add a second:
        # whose it is is told by its comment. Sinko's (this release's or pihole-bahrain 2.x's) is rewritten as before;
        # the owner's keeps its comment, its enabled flag and its groups, and only gains Sinko's two groups.
        regex = next((d for d in self.api.domains()
                      if d.get("kind") == "regex" and d.get("type") == "deny"
                      and d.get("domain") == BLOCK_ALL_REGEX), None)
        body = {"comment": BLOCK_ALL_COMMENT, "groups": [gid[G_OFFLINE], gid[G_PAUSED]],
                "enabled": True}
        if regex is None:
            self.api.request("POST", "/api/domains/deny/regex", dict(body, domain=BLOCK_ALL_REGEX))
        elif not block_all_is_ours(regex):
            merged = sorted(set(regex.get("groups", [])) | set(body["groups"]))
            if not regex.get("enabled"):
                log.warning("your own %s rule is switched off, so 'internet off' and 'pause' cannot block anything "
                            "until it is switched on again", BLOCK_ALL_REGEX)
            elif merged != sorted(regex.get("groups", [])):
                self.api.request("PUT", "/api/domains/deny/regex/" + Api.q(BLOCK_ALL_REGEX),
                                 {"type": "deny", "kind": "regex", "comment": regex.get("comment") or "",
                                  "groups": merged, "enabled": True})
        elif sorted(regex.get("groups", [])) != sorted(body["groups"]) or not regex.get("enabled"):
            self.api.request("PUT", "/api/domains/deny/regex/" + Api.q(BLOCK_ALL_REGEX),
                             dict(body, type="deny", kind="regex"))

        # Blocklists: one per service + the guard list. Always enabled.
        existing = {l.get("comment"): l for l in self.api.lists()
                    if (l.get("comment") or "").startswith(LIST_COMMENT_PREFIX)}
        targets = [(s["id"], gid[svc_group(s["id"])]) for s in self.catalog["services"]]
        targets.append(("guard", gid[G_GUARD]))
        for sid, group_id in targets:
            comment = LIST_COMMENT_PREFIX + sid
            address = list_address(sid, self.base)
            cur = existing.pop(comment, None)
            if cur and cur["address"] != address:
                self.api.request("DELETE", "/api/lists/%s?type=block" % Api.q(cur["address"]))
                cur = None
            if cur is None:
                self.api.request("POST", "/api/lists?type=block",
                                 {"address": address, "comment": comment,
                                  "groups": [group_id], "enabled": True})
                log.debug("registered list %s", sid)
            elif cur.get("groups") != [group_id] or not cur.get("enabled"):
                self.api.request("PUT", "/api/lists/%s?type=block" % Api.q(address),
                                 {"comment": comment, "type": "block",
                                  "groups": [group_id], "enabled": True})

        # Services this release does not know. A service that is blocked right now is the parent's decision, and the
        # release that does not know it may be an older one that was put back by a rollback (a newer release added the
        # service): its group and its list stay, so that the block holds in the meantime and is still there after the
        # next update. Only an allowed (disabled) service that is gone from the catalog is removed.
        kept = {name for name in gid if name.startswith(SVC_PREFIX) and name[len(SVC_PREFIX):] not in wanted
                and groups[name]["enabled"]}
        for comment, cur in existing.items():
            if SVC_PREFIX + comment[len(LIST_COMMENT_PREFIX):] in kept:
                log.info("kept list %s of a blocked service this release does not know", comment)
                continue
            self.api.request("DELETE", "/api/lists/%s?type=block" % Api.q(cur["address"]))
            log.info("removed stale list %s", comment)
        for name in list(gid):
            if name.startswith(SVC_PREFIX) and name[len(SVC_PREFIX):] not in wanted:
                if name in kept:
                    log.info("kept group %s: a service this release does not know is blocked", name)
                    continue
                self.api.delete_group(name)
                log.info("removed stale group %s", name)
                del gid[name]

        # Make sure every kid device is in every (possibly new) group.
        required = kid_groups(gid, self.catalog)
        for c in self.api.clients():
            groups_now = c.get("groups", [])
            if gid[G_KIDS] in groups_now:
                merged = sorted(set(groups_now) | set(required))
                if merged != sorted(groups_now):
                    self.api.put_client(c["client"], c.get("comment") or "", merged)

        if run_gravity:
            self.gravity()

    @staticmethod
    def gravity(wait: float = GRAVITY_LOCK_WAIT) -> None:
        """`pihole -g`, one run at a time. Pi-hole's gravity.sh has no lock of its own: every run deletes and rebuilds
        one fixed temporary database and ends by moving it over the live one, so two that overlap (an update's setup
        and the nightly list refresh, a self-repair, the retry of an update) leave a mix of both, and a service that
        should be blocked can stay reachable until the next run, with every check saying all is well. Every run that
        Sinko starts takes the flock on /var/lib/sinko/gravity.lock first (the systemd service that refreshes the lists
        takes the same one with flock(1)) and waits for the one that is running, up to `wait` seconds. Pi-hole's own
        weekly run and the page's restore start gravity without asking: only the timer's hour keeps clear of those."""
        try:
            fd = open_lock_file(GRAVITY_LOCK_NAME)
        except OSError as err:
            # The lock is the safety, not the job: a folder that cannot be used must not stop the first installation.
            log.warning("could not open the lock that keeps two updates of the block lists apart (%s): going on without it",
                        short_text(err, 80))
            fd = None
        try:
            if fd is not None:
                deadline = time.monotonic() + wait
                announced = False
                while True:
                    try:
                        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                        break
                    except BlockingIOError:
                        if time.monotonic() >= deadline:
                            raise subprocess.TimeoutExpired("pihole -g", wait)   # as for a run that takes too long
                        if not announced:
                            announced = True
                            log.info("the block lists are being updated by another run: waiting for it (up to %d minutes)",
                                     wait // 60)
                        time.sleep(GRAVITY_POLL)
            log.info("updating gravity (this can take a minute)…")
            subprocess.run(["pihole", "-g"], check=True, stdout=subprocess.DEVNULL, timeout=GRAVITY_RUN_LIMIT)
        finally:
            if fd is not None:
                os.close(fd)                                                     # closing drops the lock

    def migrate_legacy(self) -> None:
        """Remove objects created by the old (pre-2.0) installer."""
        groups = self.api.group_map()
        old = groups.get("Kids")
        if not old or old.get("comment") != "Parental-control service blocklists":
            return
        log.info("migrating from the 1.x installer")
        kids_old = old["id"]
        paused_old = groups.get("Paused", {}).get("id")
        legacy_devices = [c for c in self.api.clients() if kids_old in c.get("groups", [])]
        for l in self.api.lists():
            if (l.get("address") or "").startswith("file:///etc/pihole/lists/"):
                self.api.request("DELETE", "/api/lists/%s?type=block" % Api.q(l["address"]))
        for d in self.api.domains():
            if d.get("kind") == "regex" and d.get("type") == "deny" and d.get("domain") in (".*", ".+"):
                self.api.request("DELETE", "/api/domains/deny/regex/" + Api.q(d["domain"]))
        for c in legacy_devices:
            keep = [g for g in c.get("groups", []) if g not in (kids_old, paused_old)] or [DEFAULT_GROUP]
            self.api.put_client(c["client"], c.get("comment") or "", keep)
        self.api.delete_group("Kids")
        if paused_old is not None and groups["Paused"].get("comment") == "Per-device pause":
            self.api.delete_group("Paused")
        # Re-added as kid devices once the new groups exist (readd_legacy_devices).
        self._pending_kids = [c["client"] for c in legacy_devices]

    def readd_legacy_devices(self) -> None:
        pending = self._pending_kids
        if not pending:
            return
        gid = {n: g["id"] for n, g in self.api.group_map().items()}
        required = kid_groups(gid, self.catalog)
        for c in self.api.clients():
            if c["client"] in pending:
                merged = sorted(set(c.get("groups", [])) | set(required))
                self.api.put_client(c["client"], c.get("comment") or "", merged)
        self._pending_kids = []

    def convert_to_mac(self, only: str | None = None, dry_run: bool = False) -> list:
        """Re-register children that were added by IP address under their MAC address.

        Keeps name and groups (also pb-paused) and removes the IP row only after the MAC row exists.
        Returns a line per child that was considered. Never runs on its own; `use-mac` calls it.
        """
        groups = self.api.group_map()
        clients = self.api.clients()
        devices = self.api.network_devices()
        lines = []
        for kid in kid_rows(groups, clients):
            ip = parse_ip(kid["client"])
            if ip is None or (only and parse_ip(only) != ip):
                continue
            dev = find_device(devices, kid["client"])
            mac = dev.get("hwaddr") if dev and is_mac(dev.get("hwaddr")) else None
            name = kid.get("comment") or kid["client"]
            if not mac:
                lines.append("%s (%s): its MAC address is not known yet, left as it is" % (name, kid["client"]))
                continue
            mac = mac.upper()
            existing = next((c for c in clients if c["client"].lower() == mac.lower()), None)
            merged = sorted(set(kid.get("groups", [])) | set(existing.get("groups", []) if existing else []))
            lines.append("%s: %s -> %s%s" % (name, kid["client"], mac, " (dry run)" if dry_run else ""))
            if dry_run:
                continue
            comment = kid.get("comment") or (existing.get("comment") if existing else "") or ""
            if existing:
                self.api.put_client(existing["client"], existing.get("comment") or comment, merged)
            else:
                self.api.request("POST", "/api/clients", {"client": mac, "comment": comment, "groups": merged})
            self.api.request("DELETE", "/api/clients/" + Api.q(kid["client"]))
        return lines

    def remove(self) -> None:
        """Take everything Sinko made out of Pi-hole. A client row that holds only Sinko's groups (and the Default one) is
        Sinko's own and is deleted. A row that also holds a group of the owner's (the owner had registered the device
        before, or gave it a group of their own since) is the owner's: Sinko's groups come off it and the row, its name
        and the owner's groups stay."""
        groups = self.api.group_map()
        ours = {g["id"] for n, g in groups.items() if n.startswith("pb-")}
        kids_id = groups.get(G_KIDS, {}).get("id")
        for c in self.api.clients():
            held = c.get("groups", [])
            if not set(held) & ours:
                continue
            keep = [g for g in held if g not in ours]
            if kids_id in held and set(keep) <= {DEFAULT_GROUP}:
                self.api.request("DELETE", "/api/clients/" + Api.q(c["client"]))
            else:
                self.api.put_client(c["client"], c.get("comment") or "", keep or [DEFAULT_GROUP])
        for l in self.api.lists():
            if (l.get("comment") or "").startswith(LIST_COMMENT_PREFIX):
                self.api.request("DELETE", "/api/lists/%s?type=block" % Api.q(l["address"]))
        for d in self.api.domains():
            if (d.get("kind") == "regex" and d.get("type") == "deny" and d.get("domain") == BLOCK_ALL_REGEX
                    and block_all_is_ours(d)):
                self.api.request("DELETE", "/api/domains/deny/regex/" + Api.q(BLOCK_ALL_REGEX))
            # The owner's own rule of that name stays; deleting Sinko's groups below takes them off it.
        for rule in learned_rules(self.api.domains()):
            self.api.request("DELETE", "/api/domains/deny/regex/" + Api.q(rule["regex"]))
        for name in groups:
            if name.startswith("pb-"):
                self.api.delete_group(name)

    # ----- live state -----
    def read_state(self):
        groups = self.api.group_map()
        state = parse_state(groups.get(G_STATE, {}).get("comment"))
        blocked = {s["id"]: bool(groups.get(svc_group(s["id"]), {}).get("enabled"))
                   for s in self.catalog["services"]}
        offline = bool(groups.get(G_OFFLINE, {}).get("enabled"))
        return state, blocked, offline, groups

    def write_state(self, state: dict) -> None:
        self.api.put_group(G_STATE, json.dumps(state, separators=(",", ":")), False)

    def apply(self, blocked: dict, offline: bool, groups: dict) -> None:
        changed = False
        for s in self.catalog["services"]:
            name = svc_group(s["id"])
            want = bool(blocked.get(s["id"], False))
            g = groups.get(name)
            if g is not None and bool(g["enabled"]) != want:
                self.api.put_group(name, g.get("comment") or "", want)
                changed = True
        g = groups[G_OFFLINE]
        if bool(g["enabled"]) != offline:
            self.api.put_group(G_OFFLINE, g.get("comment") or "", offline)
            changed = True
        if changed:
            self.api.flush_dns()                      # timers and bedtime must take effect at once too

    def tick(self, now: dt.datetime | None = None) -> list:
        """One scheduler pass. Returns a list of human-readable actions taken."""
        if self.clock_trusted is not None and not self.clock_trusted():
            return []                      # hold the current state: see ClockGuard
        now = now or dt.datetime.now()
        epoch = now.timestamp()
        state, blocked, offline, groups = self.read_state()
        actions = []
        changed = False
        window = in_schedule(state["schedule"], now)
        timer = state["timer"]
        timer_seen = json.dumps(timer, sort_keys=True)

        if window != state["scheduleActive"]:
            if window:                                  # bedtime starts
                if timer and timer["mode"] == "free":
                    self.apply(timer["snapshot"]["services"], True, groups)
                    state["timer"] = timer = None
                    actions.append("bedtime started: free-time timer ended early")
                elif timer:
                    timer["snapshot"]["offline"] = True
                    actions.append("bedtime started during block timer")
                else:
                    self.apply(blocked, True, groups)
                    actions.append("bedtime started: internet off")
            else:                                       # bedtime ends
                if timer:
                    timer["snapshot"]["offline"] = False
                    actions.append("bedtime ended during timer")
                else:
                    self.apply(blocked, False, groups)
                    actions.append("bedtime ended: internet on")
            state["scheduleActive"] = window
            changed = True

        if timer and timer["until"] <= epoch:
            snap = timer["snapshot"]
            self.apply(snap["services"], bool(snap["offline"]) or window, groups)
            state["timer"] = None
            changed = True
            actions.append("%s timer finished: previous rules restored" % timer["mode"])

        if changed:
            # Re-read right before writing so a schedule edited in the page a
            # moment ago is not overwritten; we only own timer + scheduleActive.
            fresh = parse_state(self.api.group_map().get(G_STATE, {}).get("comment"))
            if json.dumps(fresh["timer"], sort_keys=True) == timer_seen:
                # Nobody touched the timer meanwhile, so our decision stands.
                # Otherwise the page started/cancelled one and that wins.
                fresh["timer"] = state["timer"]
            fresh["scheduleActive"] = state["scheduleActive"]
            self.write_state(fresh)
        for a in actions:
            log.info(a)
        return actions


# --------------------------------------------------------------------------- #
# Maintenance: what the scheduler does besides bedtime and timers
# --------------------------------------------------------------------------- #
def apply_pihole_settings(conf: dict, hostname=None, ip=None, remove_hostname=False, disable_web=False) -> None:
    """What `sinko configure` does (also used when the box's address changes)."""
    ftl_set_config("webserver.serve_all", "true")
    ftl_set_config("webserver.api.cli_pw", "true")
    # The config file still holds the name added by the previous run (install.sh
    # rewrites it afterwards), so a renamed or removed name does not linger.
    old = conf.get("SINKO_HOSTNAME", "")
    hostname = hostname if hostname is not None else old
    ours = {n for n in (old, hostname) if n}
    hosts = parse_cli_array(ftl_config("dns.hosts"))
    new = hosts
    if remove_hostname or ip:
        new = [h for h in hosts if not ours & set(h.split()[1:])]
        if hostname and ip and not remove_hostname:
            new = merged_hosts(new, ip, hostname)
    if new != hosts:
        ftl_set_config("dns.hosts", json.dumps(new))
    if disable_web:
        ftl_set_config("webserver.serve_all", "false")


def write_config_value(key: str, value: str, path=None) -> None:
    """Change one KEY=value line of the settings file (adding it if there is none). Every other line, and the file's
    rights, stay as they are."""
    if not re.match(r"^[A-Za-z0-9._:/-]+\Z", value):
        raise ValueError("not a plain value: %r" % value)
    path = path or CONFIG_FILE
    with open(path, encoding="utf-8") as fh:
        lines = fh.read().splitlines()
    out, done = [], False
    for line in lines:
        name = line.split("=", 1)[0].strip()
        if "=" in line and not line.lstrip().startswith("#") and name == key:
            if not done:
                out.append("%s=%s" % (key, value))
            done = True                       # a repeated key would shadow the new value, so only one is kept
        else:
            out.append(line)
    if not done:
        out.append("%s=%s" % (key, value))
    atomic_write(path, "\n".join(out) + "\n", stat.S_IMODE(os.stat(path).st_mode))


def valid_lan_ip(text) -> bool:
    ip = parse_ip(text)
    return ip is not None and ip.version == 4 and not (ip.is_loopback or ip.is_link_local or ip.is_unspecified
                                                       or ip.is_multicast or ip.is_reserved)


def default_route_ipv4():
    """The IPv4 address this box uses towards its router, or None. Connecting a UDP socket sends nothing: it only
    makes the kernel choose the source address, so this is instant and needs no subprocess."""
    gateway = SystemProbe().default_gateway()
    if not gateway:
        return None
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        sock.settimeout(1)
        sock.connect((gateway, 9))
        ip = sock.getsockname()[0]
    except OSError:
        return None
    finally:
        sock.close()
    return ip if valid_lan_ip(ip) else None


def apply_new_address(ip: str, conf: dict, config_path=None) -> None:
    """The box got another address: point the local name at it (what `sinko configure --ip` does), then remember it."""
    apply_pihole_settings(conf, hostname=conf.get("SINKO_HOSTNAME", ""), ip=ip)
    write_config_value("SINKO_IP", ip, config_path)
    refresh_box_info(ip=ip)


# --------------------------------------------------------------------------- #
# /pb/box.json: what the page may know about the box without signing in (architecture.md, "Amendments").
# It is also the scheduler's heartbeat for the parent: the page treats a file whose `at` is far behind the box's own
# clock as "the scheduler is not running".
# --------------------------------------------------------------------------- #
BOX_INFO_FILE = "box.json"
BOX_INFO_MAX_AGE = 600                 # a file this old is rewritten even when nothing changed: it is the heartbeat
TZ_NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_+./-]{0,63}\Z")
LABEL_RE = re.compile(r"^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\Z")
# The contract between the box and the app (box.json's `api`). Raise it whenever pb-state gains or changes a key, or anything
# else the app relies on behaves differently: the app does not write pb-state to a box whose number is higher than the one it
# knows, because every parser drops the keys it does not know (architecture.md, "Shared state").
BOX_API = 1


def timezone_name():
    """The box's time zone as an IANA name ("Asia/Bahrain"), or None when it cannot be told: the target of the
    /etc/localtime link (what systemd's `timedatectl set-timezone` sets), else Debian's /etc/timezone."""
    link = os.environ.get("SINKO_LOCALTIME") or "/etc/localtime"
    names = []
    try:
        target = os.readlink(link)
        if "zoneinfo/" in target:
            names.append(target.split("zoneinfo/", 1)[1])
    except OSError:
        pass
    try:
        with open(os.environ.get("SINKO_TIMEZONE_FILE") or "/etc/timezone", encoding="ascii") as fh:
            names.append(fh.readline().strip())
    except (OSError, ValueError):
        pass
    for name in names:
        if TZ_NAME_RE.match(name) and ".." not in name.split("/"):
            return name
    return None


def utc_offset_text(when=None) -> str:
    """The box's offset from UTC right now as "+03:00"."""
    offset = (when or dt.datetime.now().astimezone()).utcoffset() or dt.timedelta(0)
    minutes = int(offset.total_seconds() // 60)
    sign = "+" if minutes >= 0 else "-"
    return "%s%02d:%02d" % (sign, abs(minutes) // 60, abs(minutes) % 60)


def system_hostname():
    """The host name of the system as avahi announces it (<name>.local): the part before the first dot, in small letters,
    or None when it is not a plain name. Read from /etc/hostname first, like the installer: the scheduler runs in a name
    space of its own (ProtectHostname=), where a name given after its start never arrives."""
    name = ""
    try:
        with open(os.environ.get("SINKO_ETC_HOSTNAME") or "/etc/hostname", encoding="utf-8", errors="replace") as fh:
            name = fh.readline().strip()
    except OSError:
        pass
    if not name:
        try:
            name = socket.gethostname()
        except OSError:
            return None
    name = name.split(".", 1)[0].lower()
    return name if LABEL_RE.match(name) else None


def box_info(conf=None, ip="default", when=None, mdns=None) -> dict:
    """The content of /pb/box.json: {"v":1,"api","version","boxId","hostname","ip","tz","utcOffset","counter","mdns","at"}.
    `api` is BOX_API. `boxId` is this box's own random number (box_id), so that the app knows the box again at another
    address, and `hostname` the name it answers to as <hostname>.local (null when either is not known). `ip` is the
    default-route IPv4 address (what the router's DNS setting needs; the page never puts a name there), null when the
    box has no route. `counter` is "a counter address is configured", `mdns` "avahi answers for this host", `at` the box's
    clock. The file is readable by everybody on the home network: the box id and the host name tell one box from another
    (avahi announces the name anyway), and the name is the owner's choice on an own install, which can say something about
    the family. Nothing else about the family is in it: not the local name of the page, the children, the rules or the
    counter's id or address."""
    conf = read_config() if conf is None else conf
    if ip == "default":
        try:
            ip = default_route_ipv4()
        except (OSError, ValueError):
            ip = None
    if mdns is None:
        mdns = unit_active("avahi-daemon")
    now = time.time() if when is None else when
    return {"v": 1, "api": BOX_API, "version": VERSION, "boxId": box_id(), "hostname": system_hostname(),
            "ip": ip if valid_lan_ip(ip) else None, "tz": timezone_name(), "utcOffset": utc_offset_text(),
            "counter": bool(telemetry_url(conf)), "mdns": bool(mdns), "at": int(now)}


def box_info_path(root=None):
    """Where box.json goes: the page's folder inside the web root. None when there is no such folder (no page
    installed, or the installer is between two versions of it): the folder is never made here, because the installer
    swaps it by renaming and a folder that already exists would make that rename put the new page inside the old."""
    folder = os.path.join(root or webroot(), "pb")
    return os.path.join(folder, BOX_INFO_FILE) if os.path.isdir(folder) else None


def write_box_info(conf=None, ip="default", force: bool = False, root=None, when=None, mdns=None) -> str:
    """Write /pb/box.json (atomically, mode 644) when its content changed or the file is older than BOX_INFO_MAX_AGE.
    Returns "written", "unchanged" or "nowhere" (there is no page folder: nothing to write, and that is not an error).
    Raises OSError when the file cannot be written."""
    path = box_info_path(root)
    if path is None:
        return "nowhere"
    info = box_info(conf, ip, when, mdns)
    old = read_json_file(path)
    if not force and isinstance(old, dict) and _is_number(old.get("at")):
        same = {k: v for k, v in old.items() if k != "at"} == {k: v for k, v in info.items() if k != "at"}
        age = info["at"] - old["at"]
        if same and -60 <= age < BOX_INFO_MAX_AGE:            # a file from the future (the clock was wrong) is not fresh
            return "unchanged"
    atomic_write(path, json.dumps(info, separators=(",", ":")), 0o644)
    return "written"


def refresh_box_info(**kw) -> None:
    """write_box_info for callers that must never fail because of it (`configure`, the address watch, the installer's
    last step): whatever goes wrong is logged at debug level and dropped."""
    try:
        write_box_info(**kw)
    except Exception as err:
        log.debug("could not write %s: %s", BOX_INFO_FILE, err)


def start_update_runner() -> bool:
    """Start `sinko update --yes --from-panel` (see start_runner)."""
    return start_runner("sinko-update", "Sinko update", ["update", "--yes", "--from-panel"], "update.log", "the update")


def start_repair_runner() -> bool:
    """Start `sinko repair` (see start_runner)."""
    return start_runner("sinko-repair", "Sinko repair", ["repair"], "repair.log", "the repair")


def start_runner(unit: str, description: str, args: list, log_name: str, what: str) -> bool:
    """Start `sinko <args>` so that it outlives the restart of this service, which the installer causes: as its own
    transient systemd unit, and if systemd refuses, as a detached process."""
    argv = [sys.executable, os.path.abspath(__file__)] + args
    # systemd-run does not pass the environment on. Forward the SINKO_* settings (test hooks, overrides), but never
    # anything that could be a secret: the command line of a unit is visible to every user and is logged.
    setenv = ["--setenv=%s=%s" % (k, v) for k, v in sorted(os.environ.items())
              if k.startswith("SINKO_") and not re.search(r"PASS|SECRET|TOKEN|KEY", k)]
    cmd = ["systemd-run", "--unit", unit, "--collect", "--quiet", "--description=" + description] + setenv + ["--"] + argv
    try:
        done = subprocess.run(cmd, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=15)
        if done.returncode == 0:
            return True
        why = done.stderr.strip()
    except (OSError, subprocess.SubprocessError) as err:
        why = str(err)
    if unit_active(unit):
        return True                           # a runner from an earlier attempt is still going; it owns the result
    log.warning("systemd-run could not start %s (%s); starting it directly", what, short_text(why, 100))
    ensure_state_dir()
    fd = os.open(state_path(log_name), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        # A detached process stays in this service's control group, so a restart of the service may still end it;
        # the scheduler then marks the update as not finished. systemd-run is the dependable way.
        proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=fd, stderr=fd, start_new_session=True, close_fds=True)
    finally:
        os.close(fd)
    threading.Thread(target=proc.wait, daemon=True).start()          # reaps it when it ends
    return True


REPAIR_FILE = "repair.json"
REPAIR_EVERY = 3600                         # at most one repair an hour, whatever restarts in between


def repair_due(epoch: float) -> bool:
    """No repair was started within the last hour (the note is in the state folder: the installer restarts the scheduler,
    and a new process must not forget that it has just tried)."""
    raw = read_json_file(state_path(REPAIR_FILE))
    at = raw.get("at") if isinstance(raw, dict) else None
    return not _is_number(at) or not 0 <= epoch - at < REPAIR_EVERY


def note_repair(epoch: float) -> None:
    ensure_state_dir()
    atomic_write(state_path(REPAIR_FILE), json.dumps({"at": epoch}))


def install_lock_held() -> bool:
    """Is the installer running (it holds install.lock for as long as it runs)?"""
    try:
        fd = open_lock_file("install.lock")
    except OSError:
        return False                         # a lock that cannot even be opened is not held by an installer
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return True
    except OSError:
        return False
    finally:
        os.close(fd)                         # (closing also drops the lock just taken)
    return False


def run_power(action: str) -> None:
    if action not in POWER_ACTIONS:
        raise ValueError("unknown power action %r" % (action,))
    subprocess.run(["systemctl", "--no-block", action], check=True, capture_output=True, timeout=30)


def recover_check() -> dict:
    """After an update whose runner is gone (power cut, killed): does this box work? {"ok": bool, "detail": text}.
    The self-check, without the question whether the scheduler runs: this is the scheduler asking. Slow (it asks
    Pi-hole and the disk): run it in a background job."""
    try:
        catalog = load_catalog_safely()
    except CatalogError as err:
        return {"ok": False, "detail": "the program's lists cannot be read (%s)" % short_text(err, 60)}
    results = selfcheck_round(catalog, scheduler=lambda: (True, "this is the scheduler"))
    failed = [text for ok, text in results if not ok]
    return {"ok": not failed, "detail": short_text(failed[0], 100) if failed else ""}


def run_self_heal() -> None:
    """Put back what Sinko needs inside Pi-hole when it went missing (a group or a list deleted by hand, a backup from
    another version restored): `sinko setup`, including the gravity update. Only pb-* objects are touched, and not
    the leftovers of the 1.x installer. Slow: run it in a background job, with a session of its own."""
    api = Api()
    try:
        api.wait_ready(30)
        api.login()
        Controller(api, load_catalog_safely()).setup(run_gravity=True, legacy=False)
    finally:
        drop_session(api)


# --------------------------------------------------------------------------- #
# Optional anonymous counter ("boxes online"): architecture.md, "Optional anonymous counter"
# --------------------------------------------------------------------------- #
PING_TIMEOUT = 10
PING_RESPONSE_MAX = 4096
MAX_COUNT = 10_000_000


class TelemetryError(Exception):
    pass


def telemetry_url(conf=None) -> str:
    """The counter's address (environment, then settings, then TELEMETRY_URL); "" when there is none or it is not
    acceptable: the id travels in the request, so it must be https (plain http only to this machine, for tests)."""
    conf = read_config() if conf is None else conf
    url = (os.environ.get("SINKO_TELEMETRY_URL") or conf.get("SINKO_TELEMETRY_URL") or TELEMETRY_URL).strip()
    try:
        parts = urllib.parse.urlsplit(url)
        host, _ = parts.hostname, parts.port
    except ValueError:
        return ""
    if not url or not host or parts.username or parts.password or parts.query or parts.fragment:
        return ""
    if parts.scheme == "https" or (parts.scheme == "http" and host in LOOPBACK_HOSTS):
        return url.rstrip("/")
    return ""


def hardware_kind(model_file=None, machine=None) -> str:
    """"orangepi-zero3", "raspberrypi", "x86" or "other": the only thing about the machine that is ever sent."""
    path = model_file or os.environ.get("SINKO_DT_MODEL") or "/proc/device-tree/model"
    try:
        with open(path, "rb") as fh:
            model = fh.read(200).decode("ascii", "ignore")             # the device tree's text ends in a NUL byte
    except OSError:
        model = ""
    squashed = re.sub(r"[^a-z0-9]", "", model.lower())
    if "orangepizero3" in squashed:
        return "orangepi-zero3"
    if "raspberrypi" in squashed:
        return "raspberrypi"
    if (machine or os.uname().machine).lower() in ("x86_64", "amd64", "i386", "i686", "x86"):
        return "x86"
    return "other"


def telemetry_body() -> str:
    """Exactly what the counter would be sent. Nothing else leaves the box: no domain, device, address, child, rule,
    language or time zone."""
    body = json.dumps({"id": install_id(), "v": VERSION, "hw": hardware_kind()}, separators=(",", ":"))
    if len(body.encode("utf-8")) > 512:
        raise TelemetryError("the payload is larger than allowed")
    return body


def _counter_post(url: str, path: str, body: str, timeout: float):
    """POST `body` (JSON) to {url}{path} and return the answer as parsed JSON, or None when the answer is not JSON or
    far too big. Raises TelemetryError when the counter cannot be reached or answers with an error. One transport for
    everything the box ever says to the counter, so that one set of rules (https, no redirect to plain http, short
    timeout, small answer, no cookies) covers all of it."""
    request = urllib.request.Request(url + path, data=body.encode("utf-8"), method="POST",
                                     headers={"Content-Type": "application/json", "User-Agent": "sinko/" + VERSION})
    try:
        with urllib.request.build_opener(_SafeRedirect).open(request, timeout=timeout) as resp:
            raw = resp.read(PING_RESPONSE_MAX + 1)
    except urllib.error.HTTPError as err:
        err.close()
        raise TelemetryError("the counter answered HTTP %s" % err.code)
    except (urllib.error.URLError, OSError, http.client.HTTPException, ValueError) as err:
        raise TelemetryError("the counter could not be reached (%s)" % short_text(getattr(err, "reason", None) or err, 80))
    try:
        return json.loads(raw[:PING_RESPONSE_MAX].decode("utf-8")) if len(raw) <= PING_RESPONSE_MAX else None
    except (ValueError, RecursionError):
        return None


def send_ping(url: str, body: str, timeout: float = PING_TIMEOUT):
    """POST `body` to {url}/v1/ping. Returns {"online", "total"} from the answer, or None when the answer holds
    numbers that make no sense. Raises TelemetryError when the counter cannot be reached."""
    data = _counter_post(url, "/v1/ping", body, timeout)
    if not isinstance(data, dict):
        return None
    online, total = data.get("online"), data.get("total")
    for value in (online, total):
        if not isinstance(value, int) or isinstance(value, bool) or not 0 <= value <= MAX_COUNT:
            return None
    return {"online": online, "total": total} if online <= total else None


def send_forget(url: str, ident: str, timeout: float = PING_TIMEOUT) -> bool:
    """Ask the counter to delete everything it holds for `ident` (POST {url}/v1/forget {"id": ...}). True when it said
    {"forgotten": true}, which it does whether or not it knew the id. Raises TelemetryError otherwise."""
    if not isinstance(ident, str) or not INSTALL_ID_RE.match(ident):
        raise TelemetryError("the id is not valid")
    data = _counter_post(url, "/v1/forget", json.dumps({"id": ident}, separators=(",", ":")), timeout)
    if not (isinstance(data, dict) and data.get("forgotten") is True):
        raise TelemetryError("the counter did not confirm that it forgot the id")
    return True


# What the box remembers about the counter, in the state folder (root only):
#   install-id       the random number sent with every ping (made when the first ping is built)
#   counter-sent     exists once the id has left this box (made just before the request is sent: a request that fails
#                    half way may still have arrived)
#   forget-pending   the answer became "no" (or the id is being replaced) and the counter has not yet confirmed that
#                    it forgot the id; nothing is sent to the counter, except the forget request, until it has
def counter_sent() -> bool:
    return os.path.exists(state_path("counter-sent"))


def note_counter_sent() -> None:
    ensure_state_dir()
    atomic_write(state_path("counter-sent"), "1\n")


def forget_pending() -> bool:
    return os.path.exists(state_path("forget-pending"))


def set_forget_pending() -> None:
    ensure_state_dir()
    atomic_write(state_path("forget-pending"), "1\n")


def drop_install_id() -> None:
    """The id and everything that says it was used: after the counter forgot it, or when it never left the box."""
    for name in ("install-id", "counter-sent", "forget-pending"):
        try:
            os.unlink(state_path(name))
        except FileNotFoundError:
            pass
    _fsync_dir(state_dir())


def forget_counter_id(url: str, send=None):
    """Make the counter forget this box's id, then delete it. Returns (status, detail):
      "none"        there was nothing to forget (no id, or it never left this box): any id file is simply deleted
      "forgotten"   the counter confirmed; the id and its markers are deleted
      "pending"     the counter could not be reached or did not confirm: the id is kept with a marker, to be asked again
      "no-address"  no counter address is configured, so nobody can be asked: the marker stays for when there is one
    Never raises on a counter that is down; never sends anything but the forget request."""
    send = send or send_forget
    ident = install_id(create=False)
    if ident is None or not (counter_sent() or forget_pending()):
        drop_install_id()                                  # a number that never left the box needs no forgetting
        return "none", ""
    set_forget_pending()                                   # durable before the request leaves
    if not url:
        return "no-address", ""
    try:
        send(url, ident)
    except TelemetryError as err:
        return "pending", short_text(err, 100)
    drop_install_id()
    return "forgotten", ""


class BackgroundJob:
    """One function at a time on a daemon thread. The scheduler's tick only starts jobs and collects what they
    returned, so a slow network can never delay bedtime."""

    def __init__(self, name: str):
        self.name = name
        self._lock = threading.Lock()
        self._busy = False
        self._outcome = None

    def busy(self) -> bool:
        with self._lock:
            return self._busy

    def start(self, fn) -> bool:
        with self._lock:
            if self._busy:
                return False
            self._busy = True
            self._outcome = None
        threading.Thread(target=self._run, args=(fn,), name="sinko-" + self.name, daemon=True).start()
        return True

    def _run(self, fn) -> None:
        try:
            outcome = ("ok", fn())
        except Exception as err:
            outcome = ("error", err)
        with self._lock:
            self._outcome = outcome

    def take(self):
        """("ok", value) or ("error", exception) of a finished run, once; None while it still runs or nothing ran."""
        with self._lock:
            outcome, self._outcome = self._outcome, None
            if outcome is not None:
                self._busy = False
        return outcome


# --------------------------------------------------------------------------- #
# Learning new addresses of blocked apps (docs/maintainers/host-model.md, step 2)
# --------------------------------------------------------------------------- #
LEARNED_PREFIX = "pb-learned:"           # a rule the box learned: comment "pb-learned:<app id> <YYYY-MM-DD>"
UNLEARNED_PREFIX = "pb-learned-no:"      # a learned rule that was taken back: kept, switched off, so it is not learned again
ZONE_REGEX_RE = re.compile(r"\(\^\|\\\.\)((?:[a-z0-9_-]+\\\.)+[a-z0-9_-]+)\$\Z")
# FTL's query status strings (get_query_status_str in FTL's datastructure.c), as web/pb-core.js reads them.
REFUSED_STATUSES = {"GRAVITY", "GRAVITY_CNAME", "REGEX", "REGEX_CNAME", "DENYLIST", "DENYLIST_CNAME"}
ANSWERED_STATUSES = {"FORWARDED", "RETRIED", "RETRIED_DNSSEC", "CACHE", "CACHE_STALE"}


def zone_regex(z: str) -> str:
    """The Pi-hole rule for a zone: the name and every name under it. A zone holds only letters, digits, "_", "-" and
    dots (HOST_RE), and only the dots are special."""
    return r"(^|\.)" + z.replace(".", r"\.") + "$"


def regex_zone(regex):
    """The zone of a rule that zone_regex wrote, or None."""
    m = ZONE_REGEX_RE.match(regex or "")
    return m.group(1).replace("\\.", ".") if m else None


def learned_rules(domains: list) -> list:
    """The rules the box learned, and the ones that were taken back, from /api/domains:
    [{"app", "zone", "day", "back", "enabled", "regex", "groups"}]."""
    out = []
    for d in domains:
        comment = d.get("comment") or ""
        if d.get("type") != "deny" or d.get("kind") != "regex":
            continue
        for prefix, back in ((LEARNED_PREFIX, False), (UNLEARNED_PREFIX, True)):
            z = regex_zone(d.get("domain")) if comment.startswith(prefix) else None
            if z is not None:
                parts = comment[len(prefix):].split()
                out.append({"app": parts[0] if parts else "", "day": parts[1] if len(parts) > 1 else "", "zone": z,
                            "back": back, "enabled": bool(d.get("enabled")), "regex": d["domain"],
                            "groups": d.get("groups", [])})
                break
    return out


def under(name: str, z: str) -> bool:
    return name == z or name.endswith("." + z)


def allowed_by_owner(name: str, domains: list) -> bool:
    """An allow rule of the owner's covers the name. Pi-hole lets an allow rule win over any block anyway; a learned rule
    under it would only clutter the list."""
    for d in domains:
        if d.get("type") != "allow" or not d.get("enabled"):
            continue
        if d.get("kind") == "exact" and d.get("domain") == name:
            return True
        if d.get("kind") == "regex":
            try:
                if re.search(d.get("domain") or "(?!)", name):
                    return True
            except re.error:
                continue                       # FTL's own syntax (";querytype=…"): FTL itself decides those
    return False


def add_learned_rule(api: Api, sid: str, z: str, gid: int, day: str) -> None:
    """The rule is in the app's own group, so it blocks while the app is blocked and stops when the app is allowed,
    like the app's list; a write through the API applies at once (FTL reloads), no gravity run."""
    api.request("POST", "/api/domains/deny/regex", {"domain": zone_regex(z), "comment": "%s%s %s" % (LEARNED_PREFIX, sid, day),
                                                    "groups": [gid], "enabled": True})


def take_back_rule(api: Api, rule: dict) -> None:
    """Allow a learned name again: the rule stays, switched off, with a comment that keeps it from being learned again."""
    api.request("PUT", "/api/domains/deny/regex/" + Api.q(rule["regex"]),
                {"type": "deny", "kind": "regex", "comment": "%s%s %s" % (UNLEARNED_PREFIX, rule["app"], rule["day"]),
                 "groups": rule["groups"] or [DEFAULT_GROUP], "enabled": False})


class LearnError(Exception):
    """The model or the lists it needs cannot be read: nothing is learned."""


class Learner:
    """Learns new addresses of blocked apps, when the parent switched it on (`learn.on` in the shared state).

    Once a minute it reads the lookups Pi-hole made since the last look (/api/queries, the history Pi-hole keeps on the
    box anyway) and blocks a name for an app only when all of these hold:
      * the name is answered (not blocked) and no list blocks it;
      * the model is at least MODEL_THRESHOLD sure it is that app's, and the app is blocked right now;
      * the name carries one of the app's own words (zone());
      * the same device was refused a name of that app's list within WINDOW seconds: the app is open and being stopped;
      * the zone is not one that must never be blocked whole (NEVER), no allow rule of the owner's covers the name, and it
        was not taken back before;
      * the app has learned fewer than PER_APP_DAY names today and the box holds fewer than MAX_RULES.
    The rule (add_learned_rule) covers the zone and lives in the app's group. Nothing is sent anywhere.
    """
    EVERY = 60                 # seconds between two looks
    WINDOW = 120               # seconds between a refusal of the app and the new name, either way
    PER_APP_DAY = 20
    MAX_RULES = 200
    ROWS = 1000                # lookups read at most in one look (a home makes far fewer in a minute)

    def __init__(self, model_file: str | None = None, lists_dir: str | None = None):
        self.model_file = model_file or MODEL_FILE
        self.lists_dir = lists_dir or LISTS_DIR
        self._loaded = None
        self._capped = set()
        self.reset()

    def reset(self) -> None:
        """Learning is off: forget what was seen, so that switching it on again looks back WINDOW seconds only."""
        self._since = None
        self._ids = set()
        self._refused = {}

    def _load(self):
        if self._loaded is None:
            try:
                every = load_app_lists(self.lists_dir, guard=True)
                apps = {sid: doms for sid, doms in every.items() if sid != "guard"}
                model = load_model(self.model_file)
                words = {sid: matcher(w) for sid, w in app_words(apps).items()}
                self._loaded = (model, Cover(apps), Cover(every), words)
            except (OSError, ValueError) as err:
                self._loaded = LearnError("cannot read the model or the lists: %s" % short_text(err, 120))
        if isinstance(self._loaded, LearnError):
            raise self._loaded
        return self._loaded

    def run(self, api: Api, groups: dict, epoch: float) -> list:
        """One look. Returns what was learned, as text."""
        model, app_cover, any_cover, words = self._load()
        since = self._since if self._since is not None else epoch - self.WINDOW
        rows = [r for r in _rows(api.request("GET", "/api/queries?from=%d&length=%d" % (int(since), self.ROWS)),
                                 "queries", lambda r: r) if r.get("id") not in self._ids]
        seen = sorted(filter(None, (self._read_row(r) for r in rows)), key=lambda row: row[0])     # by time only
        times = [float(r["time"]) for r in rows if _is_number(r.get("time"))]
        if times:
            # The next look starts at the second of the newest lookup read (Pi-hole's `from` takes whole seconds); the
            # lookups of that second that were read now are not read twice.
            self._since = max(times)
            self._ids = {r.get("id") for r in rows if _is_number(r.get("time")) and float(r["time"]) >= int(self._since)}
        for t, ip, name, status, cname in seen:
            if status in REFUSED_STATUSES:
                sid = app_cover(name) or (app_cover(cname) if cname else None)
                if sid:
                    self._refused.setdefault((ip, sid), []).append(t)
        horizon = (self._since or epoch) - 2 * self.WINDOW
        self._refused = {k: [t for t in v if t >= horizon] for k, v in self._refused.items() if max(v) >= horizon}

        found = {}
        for t, ip, name, status, cname in seen:
            if status not in ANSWERED_STATUSES or name in found or any_cover(name):
                continue
            p, sid = model.score(name)
            group = groups.get(svc_group(sid)) if sid else None
            if p < MODEL_THRESHOLD or not group or not group.get("enabled") or sid not in words:
                continue
            z = zone(name, words[sid])
            if z is None or z in NEVER or not HOST_RE.match(z):
                continue
            if any(abs(t - r) <= self.WINDOW for r in self._refused.get((ip, sid), ())):
                found[name] = (sid, z, ip, group["id"])
        return self._learn(api, found, epoch) if found else []

    @staticmethod
    def _read_row(r: dict):
        client = r.get("client")
        ip = client.get("ip") if isinstance(client, dict) else None
        name, t = r.get("domain"), r.get("time")
        if not isinstance(name, str) or not _is_number(t) or not isinstance(ip, str) or ip in ("", "0.0.0.0", "::"):
            return None                        # Pi-hole's privacy level hides names or devices: nothing to learn from
        name = name.lower().rstrip(".")
        if len(name) > 253 or not HOST_RE.match(name):
            return None
        cname = r.get("cname")
        cname = cname.lower().rstrip(".") if isinstance(cname, str) and HOST_RE.match(cname.lower().rstrip(".")) else None
        return float(t), ip, name, str(r.get("status") or "").upper(), cname

    def _learn(self, api: Api, found: dict, epoch: float) -> list:
        domains = api.domains()
        rules = learned_rules(domains)
        known = {r["zone"] for r in rules}
        back = [r["zone"] for r in rules if r["back"]]
        day = time.strftime("%Y-%m-%d", time.localtime(epoch))
        total = sum(1 for r in rules if not r["back"])
        today = {}
        for r in rules:
            if not r["back"] and r["day"] == day:
                today[r["app"]] = today.get(r["app"], 0) + 1
        actions = []
        for name, (sid, z, ip, gid) in found.items():
            if z in known or any(under(name, b) for b in back) or allowed_by_owner(name, domains):
                continue
            if total >= self.MAX_RULES or today.get(sid, 0) >= self.PER_APP_DAY:
                if (sid, day) not in self._capped:
                    self._capped.add((sid, day))
                    actions.append("not learning more addresses of %s today: %d a day and %d in all at most"
                                   % (sid, self.PER_APP_DAY, self.MAX_RULES))
                continue
            add_learned_rule(api, sid, z, gid, day)
            known.add(z)
            total += 1
            today[sid] = today.get(sid, 0) + 1
            actions.append("learned a new address of %s: %s (the app was being stopped on %s)" % (sid, z, ip))
        if any(a.startswith("learned") for a in actions):
            api.flush_dns()                    # an answer the box already holds for the name must not outlive the rule
        return actions


# --------------------------------------------------------------------------- #
# What Sinko did for the family: the savings ledger (architecture.md, "Savings ledger (pb-ledger)")
# --------------------------------------------------------------------------- #
# The page's card "What Sinko did for you" needs running totals that Pi-hole cannot give: its long-term database keeps only
# database.maxDBdays days (30 on a box Sinko set up, 91 by default), and nothing in it says how long the children's internet
# was off or whether bedtime was kept. So the scheduler keeps a small daily ledger of counts in the root-only state folder
# (savings.json) and hands the page a compact copy in the disabled group pb-ledger, which only a signed-in parent can read.
# Never a file under /pb/: every device at home can read those without the password, and docs/privacy.md promises that they
# say nothing about the children or the rules.
G_LEDGER = "pb-ledger"           # disabled, never joined by a client: its comment is the page's copy of the ledger
SAVINGS_FILE = "savings.json"
LEDGER_KEEP_DAYS = 35            # daily rows kept in savings.json; older ones are folded into the running totals
LEDGER_REFRESH = 15 * 60         # seconds between two reads of Pi-hole's database (the first right after the start)
LEDGER_PUBLISH_EVERY = 60 * 60   # pb-ledger is written at most this often: every group write makes Pi-hole reload its lists
LEDGER_SETTLE = 5 * 60           # a day is read whole this long after it ended: FTL writes its database once a minute
LEDGER_STEP_MAX = 120            # seconds one pass may count, however long ago the last counted pass was
LEDGER_BACKFILL = 6              # whole days before today read on the first run, so that the week is full on day one
LEDGER_WEEK = 7                  # days in pb-ledger, today included
LEDGER_MAX_CHARS = 4000          # pb-ledger's comment stays shorter than this
LEDGER_APPS = 8                  # apps per day, and in the totals, at most
LEDGER_NIGHT_SEEN = 0.9          # a bedtime night counts when the scheduler saw this share of it ...
LEDGER_NIGHT_OFF = 0.97          # ... and it was kept when the internet was off for this share of what was seen
LEDGER_LOOK_KIDS = 60            # seconds between two looks at whether a child's device exists at all
LEDGER_COUNT_MAX = 10 ** 12      # no count of a home comes near this; a bigger number in savings.json is not ours
DAY_RE = re.compile(r"[0-9]{4}-[0-9]{2}-[0-9]{2}")
SID_RE = re.compile(r"[a-z0-9][a-z0-9_-]{0,39}")

# What stopped a lookup, by FTL's status code (QUERY_STATUS). For the first two kinds, the query's list_id is the id of the
# block list (gravity.db's adlist) or of the rule (domainlist) that stopped it.
STOP_GRAVITY = {1, 9}            # a block list, also through a CNAME
STOP_REGEX = {4, 10}             # a deny regex: Sinko's block-everything rule, a learned rule, or one of the owner's
STOP_DENY = {5, 11}              # an exact deny rule: always the owner's
STOP_UPSTREAM = {6, 7, 8, 18}    # the upstream service refused the name: nothing on the box did it


def day_start(day: dt.date) -> float:
    """The box-local midnight that begins `day`, in epoch seconds (a day with a clock change is 23 or 25 hours long)."""
    return dt.datetime.combine(day, dt.time()).timestamp()


def _is_day(value) -> bool:
    if not isinstance(value, str) or not DAY_RE.fullmatch(value):
        return False
    try:
        dt.date.fromisoformat(value)
    except ValueError:
        return False
    return True


def _ledger_count(value):
    """A count of the ledger (a whole number, never a bool or a float), or None."""
    return value if _is_int(value) and 0 <= value < LEDGER_COUNT_MAX else None


def _ledger_seconds(value) -> float:
    return float(value) if _is_number(value) and 0 <= value < LEDGER_COUNT_MAX else 0.0


def _ledger_apps(value):
    """{app id: count} with the entries that make sense, or None when it is not an object."""
    if not isinstance(value, dict):
        return None
    return {sid: n for sid, n in value.items() if isinstance(sid, str) and SID_RE.fullmatch(sid) and _ledger_count(n) is not None}


def _hhmm_minutes(text: str) -> int:
    return int(text[:2]) * 60 + int(text[3:])


def bedtime_night(sched: dict, now: dt.datetime) -> str:
    """The day the bedtime that is on now belongs to: the day it started (in_schedule's rule: Thursday 21:00 to Friday
    06:00 is Thursday's night)."""
    start, end = _hhmm_minutes(sched["start"]), _hhmm_minutes(sched["end"])
    day = now.date()
    if start > end and now.hour * 60 + now.minute < end:
        day -= dt.timedelta(days=1)
    return day.isoformat()


def bedtime_seconds(sched: dict, night: str) -> int:
    """How long the bedtime night that starts on the day `night` is planned to be, in real seconds, which is what the
    scheduler counts: the night the clocks go forward is an hour shorter than its times say, and the night they go back an
    hour longer (a day with a clock change is 23 or 25 hours long, as in day_start)."""
    start, end = _hhmm_minutes(sched["start"]), _hhmm_minutes(sched["end"])
    day = dt.date.fromisoformat(night)
    begins = dt.datetime.combine(day, dt.time(start // 60, start % 60))
    ends = dt.datetime.combine(day + dt.timedelta(days=1) if start > end else day, dt.time(end // 60, end % 60))
    return max(int(round(ends.timestamp() - begins.timestamp())), 0)


def stop_source(status, list_id, adlists: dict, rules: dict, services) -> tuple:
    """What stopped one lookup, from the list or rule FTL names (list_id) and the comment gravity.db holds on it:
    ("ads", None) a general block list (any list that is not Sinko's), ("app", sid) the list of an app the family blocked
    (comment pb:<sid>) or a rule the box learned for it (pb-learned:<sid>), ("off", None) Sinko's block-everything rule
    (internet off, bedtime, a paused device), ("guard", None) the list of outside DNS services, ("own", None) the owner's
    own rules, ("upstream", None) the upstream service, ("other", None) whatever cannot be told: a list deleted since, the
    list of an app this release does not know, a status that is no stop."""
    if status in STOP_GRAVITY:
        comment = adlists.get(list_id)
        if comment is None:
            return "other", None
        if not comment.startswith(LIST_COMMENT_PREFIX):
            return "ads", None
        sid = comment[len(LIST_COMMENT_PREFIX):]
        if sid == "guard":
            return "guard", None
        return ("app", sid) if sid in services else ("other", None)
    if status in STOP_REGEX:
        comment = rules.get(list_id)
        if comment is None:
            return "other", None
        if comment in BLOCK_ALL_OURS:
            return "off", None
        if comment.startswith(LEARNED_PREFIX):
            parts = comment[len(LEARNED_PREFIX):].split()
            if parts and parts[0] in services:
                return "app", parts[0]
        return "own", None
    if status in STOP_DENY:
        return "own", None
    if status in STOP_UPSTREAM:
        return "upstream", None
    return "other", None


def stop_by_name(status, domain, names: dict, services) -> tuple:
    """stop_source for an FTL that keeps no list_id: the stopped name is all there is. A block-list stop of a name on an
    app's list is that app's (a general list that holds the same name cannot be told apart), of a name on the guard list
    the guard's, and of any other name an ad list's. A regex stop is an app's only when the name is under a zone the box
    learned for it: Sinko's block-everything rule and the owner's own rules cannot be told apart by name."""
    if not isinstance(domain, str) or not domain or domain == "hidden":
        return "other", None
    name = domain.lower().rstrip(".")
    if status in STOP_GRAVITY:
        if service_of(name, names.get("guard", {})):
            return "guard", None
        sid = service_of(name, names.get("apps", {}))
        return ("app", sid) if sid in services else ("ads", None)
    if status in STOP_REGEX:
        for z, sid in names.get("zones", ()):
            if sid in services and under(name, z):
                return "app", sid
        return "other", None
    if status in STOP_DENY:
        return "own", None
    if status in STOP_UPSTREAM:
        return "upstream", None
    return "other", None


def classify_stops(rows, adlists: dict, rules: dict, services, names=None) -> dict:
    """Counts by what stopped them, from rows of Pi-hole's long-term database grouped by status and list_id ({"status",
    "list_id", "n"}), or, from an FTL that keeps no list_id, by status and name ({"status", "domain", "n"}, with `names`
    from stop_names). {"ads": n, "apps": {sid: n}, "off": n, "guard": n, "own": n, "upstream": n, "other": n}."""
    out = {"ads": 0, "apps": {}, "off": 0, "guard": 0, "own": 0, "upstream": 0, "other": 0}
    for row in rows:
        n, status = row.get("n"), row.get("status")
        if not _is_int(n) or n <= 0 or not _is_int(status):
            continue
        if "list_id" in row:
            kind, sid = stop_source(status, row["list_id"], adlists, rules, services)
        else:
            kind, sid = stop_by_name(status, row.get("domain"), names or {}, services)
        if kind == "app":
            out["apps"][sid] = out["apps"].get(sid, 0) + n
        else:
            out[kind] += n
    return out


def stop_names(services, rule_rows: list, lists_dir: str | None = None) -> dict:
    """What stop_by_name needs: the app of each name on the apps' lists, the guard list's names, and the zones the box
    learned ({"apps": {name: sid}, "guard": {name: "guard"}, "zones": [(zone, sid)]})."""
    apps = {}
    for sid in sorted(services):
        for entry in list_domains(sid, lists_dir):
            apps[bare_domain(entry).lower()] = sid
    guard = {bare_domain(entry).lower(): "guard" for entry in list_domains("guard", lists_dir)}
    zones = []
    for r in rule_rows:
        comment = _text(r.get("comment"))
        if r.get("type") == 3 and r.get("enabled") and comment.startswith(LEARNED_PREFIX):
            z, parts = regex_zone(_text(r.get("domain"))), comment[len(LEARNED_PREFIX):].split()
            if z and parts:
                zones.append((z, parts[0]))
    return {"apps": apps, "guard": guard, "zones": zones}


def read_stops(windows: list, services, setting=None, sql=None, lists_dir: str | None = None) -> dict:
    """Count what Pi-hole stopped, by what stopped it, in each window of the ledger (Ledger.windows), read-only from Pi-hole's
    long-term database and gravity.db's comments. It runs programs and can take a while on a busy day: only ever in the
    ledger's background job, never on the tick thread. Only whole numbers reach the SQL (sql_ints and int()).

    Returns {"days": {day: {"ads": n, "apps": {sid: n}, "whole": bool}}, "adLists": n, "why": None}. What cannot be counted
    is None, never 0, and `why` says why: Pi-hole keeps no history (database.maxDBdays 0, or no database file), a database
    cannot be read, or the privacy level keeps out what is needed. A window that would only fill a gap (the first run's
    days before today) is left out unless the database holds the whole of it."""
    setting = setting or ftl_try
    sql = sql or sql_rows
    out = {"days": {}, "adLists": None, "why": None}

    def unknown(why):
        out["why"] = why
        out["days"] = {day: {"ads": None, "apps": None, "whole": whole} for day, _s, _e, whole, gap in windows if not gap}
        return out

    def ask(db, text):
        for attempt in range(3):
            try:
                return sql(db, text)
            except SqlError as err:
                # FTL writes its database once a minute, and a reader that meets that moment is told it is locked.
                if attempt == 2 or not re.search(r"locked|busy", str(err), re.I):
                    raise
                time.sleep(1)
        return []

    if os.environ.get("SINKO_GRAVITY_DB"):
        gravity_db = os.environ["SINKO_GRAVITY_DB"]
    else:
        value, err = setting("files.gravity")
        gravity_db = value.strip() if err is None and value and value.strip() else GRAVITY_DB
    try:
        adlist_rows = ask(gravity_db, "SELECT id, comment, enabled, type FROM adlist")
        rule_rows = ask(gravity_db, "SELECT id, type, domain, comment, enabled FROM domainlist")
    except (SqlError, ValueError) as err:
        return unknown("gravity.db cannot be read (%s)" % short_text(err, 100))
    adlists = {r["id"]: _text(r.get("comment")) for r in adlist_rows if _is_int(r.get("id"))}
    rules = {r["id"]: _text(r.get("comment")) for r in rule_rows if _is_int(r.get("id"))}
    out["adLists"] = sum(1 for r in adlist_rows if r.get("enabled") and not r.get("type")
                         and not _text(r.get("comment")).startswith(LIST_COMMENT_PREFIX))

    kept, err = setting("database.maxDBdays")
    if err is None and kept.strip() == "0":
        return unknown("Pi-hole keeps no history (database.maxDBdays is 0)")
    if os.environ.get("SINKO_FTL_DB"):
        ftl_db = os.environ["SINKO_FTL_DB"]
    else:
        value, err = setting("files.database")
        if err is None and not value.strip():
            return unknown("Pi-hole keeps no history (files.database is empty)")
        ftl_db = value.strip() if err is None else FTL_DB
    level, err = setting("misc.privacylevel")
    level = int(level.strip()) if err is None and level.strip().isdigit() else 0
    if level >= 3:
        return unknown("Pi-hole's privacy level 3 keeps no history")
    try:
        cols = {t: {r.get("name") for r in ask(ftl_db, "PRAGMA table_info(%s)" % t)} for t in ("query_storage", "queries")}
        # FTL 6 notes which list or rule stopped a lookup (list_id). Without it (an older database) only the name can say,
        # and a privacy level of 1 or more hides the name.
        table, key, names = next((t for t in ("query_storage", "queries") if "list_id" in cols[t]), None), "list_id", None
        if table is None:
            if not {"timestamp", "status", "domain"} <= cols["queries"]:
                return unknown("Pi-hole's database has no table of lookups")
            if level >= 1:
                return unknown("this Pi-hole notes no list ids and its privacy level %d hides the names" % level)
            table, key, names = "queries", "domain", stop_names(services, rule_rows, lists_dir)
        first = ask(ftl_db, "SELECT MIN(timestamp) AS t FROM %s" % table)
        oldest = first[0].get("t") if first else None
        for day, start, end, whole, gap in windows:
            if gap and not (_is_number(oldest) and oldest < start):
                continue                       # the database does not hold the whole day: a gap stays a gap
            rows = ask(ftl_db, "SELECT status, %s, COUNT(*) AS n FROM %s WHERE timestamp >= %d AND timestamp < %d "
                               "AND status IN (%s) GROUP BY status, %s"
                       % (key, table, int(start), int(end), sql_ints(sorted(BLOCKED_STATUS)), key))
            if key == "domain" and any(r.get("domain") == "hidden" for r in rows):
                out["days"][day] = {"ads": None, "apps": None, "whole": whole}
                out["why"] = "Pi-hole's privacy level hid the names on %s" % day
                continue
            got = classify_stops(rows, adlists, rules, services, names)
            out["days"][day] = {"ads": got["ads"], "apps": got["apps"], "whole": whole}
    except (SqlError, ValueError) as err:
        return unknown("Pi-hole's database cannot be read (%s)" % short_text(err, 100))
    return out


def parse_ledger(text):
    """pb-ledger's comment as data, or None when it is not the JSON of an object (nothing yet, a hand edit)."""
    try:
        data = json.loads(text, parse_constant=_no_constants, parse_int=_json_int) if isinstance(text, str) and text else None
    except (ValueError, RecursionError):
        return None
    return data if isinstance(data, dict) else None


def ledger_text(payload: dict) -> str:
    """pb-ledger's comment: compact JSON shorter than LEDGER_MAX_CHARS. Should a family's apps make it longer, each day loses
    its smallest apps first, then the oldest days go; the totals always stay."""
    p = json.loads(json.dumps(payload))

    def text():
        return json.dumps(p, separators=(",", ":"))
    for keep in (LEDGER_APPS, 5, 3, 1, 0):
        for day in p["days"]:
            day["apps"] = dict(list(day["apps"].items())[:keep])
        if len(text()) < LEDGER_MAX_CHARS:
            return text()
    while len(p["days"]) > 1 and len(text()) >= LEDGER_MAX_CHARS:
        p["days"].pop(0)
    return text()


def same_ledger(stored, wanted) -> bool:
    """Do two copies say the same (the time they were made apart)?"""
    if not isinstance(stored, dict) or not isinstance(wanted, dict):
        return False
    return {k: v for k, v in stored.items() if k != "at"} == {k: v for k, v in wanted.items() if k != "at"}


class Ledger:
    """The counts behind the page's card "What Sinko did for you". Kept by the scheduler (Maintenance, on its own thread
    only) in /var/lib/sinko/savings.json, root only, and shown to the page as pb-ledger (payload, ledger_text).

    savings.json, version 1 (architecture.md, "Savings ledger (pb-ledger)"); days are box-local "YYYY-MM-DD" and null is
    "not known", never 0:
      {"v": 1, "since": day|null, "keptSince": day|null, "adLists": n|null,
       "days": {day: {"ads": n|null, "apps": {sid: n}|null, "final": bool, "off": s, "seen": s, "kept": 1|0|null}},
       "night": {"d": day, "seen": s, "off": s, "planned": s}|null,
       "before": {"ads": n, "apps": {sid: n}, "off": s, "nights": n, "kept": n}}
    "ads"/"apps" are the stops Pi-hole's database showed (read_stops), "final" says the day was read whole after it ended,
    "seen" and "off" are the seconds the scheduler watched the day and the children's internet was off in them, "kept" is
    the bedtime night that started on that day. "night" is the bedtime that is on (or was on when the scheduler stopped),
    and "before" the totals of the rows folded away after LEDGER_KEEP_DAYS days."""

    def __init__(self, path: str | None = None):
        self.path = path                     # None: savings.json in the state folder, looked up when it is read
        self.data = None
        self.dirty = False                   # counted since the last save
        self._last = None                    # the monotonic clock at the last counted pass
        self._was_off = False
        self._folded = None                  # the day of the last fold

    @classmethod
    def in_memory(cls) -> "Ledger":
        """A ledger that starts empty instead of reading savings.json (the mock's demo week, tests)."""
        ledger = cls()
        ledger.data = cls._fresh()
        return ledger

    # ----- the file -----
    def file(self) -> str:
        return self.path or state_path(SAVINGS_FILE)

    def load(self) -> dict:
        if self.data is None:
            path = self.file()
            self.data = self._clean(read_json_file(path))
            if self.data is None:
                self.data = self._fresh()
                if os.path.exists(path):
                    # Never a reason to stop the scheduler: the file is replaced at the next save.
                    log.warning("%s could not be read: starting it again (the totals on the page start from today)", SAVINGS_FILE)
                    self.dirty = True
        return self.data

    def save(self) -> None:
        data = self.load()
        if self.path is None:
            ensure_state_dir()
        out = json.loads(json.dumps(data))
        for row in list(out["days"].values()) + ([out["night"]] if out["night"] else []):
            for key in ("off", "seen"):
                row[key] = round(row[key], 1)
        out["before"]["off"] = round(out["before"]["off"], 1)
        atomic_write(self.file(), json.dumps(out, sort_keys=True, separators=(",", ":")))
        self.dirty = False

    @staticmethod
    def _fresh() -> dict:
        return {"v": 1, "since": None, "keptSince": None, "adLists": None, "days": {}, "night": None,
                "before": {"ads": 0, "apps": {}, "off": 0.0, "nights": 0, "kept": 0}}

    @classmethod
    def _clean(cls, raw):
        """savings.json as this version keeps it, or None when it is not one (corrupt, another program's, another version).
        A field that makes no sense loses only itself."""
        if not isinstance(raw, dict) or raw.get("v") != 1 or not isinstance(raw.get("days"), dict):
            return None
        data = cls._fresh()
        for key in ("since", "keptSince"):
            data[key] = raw[key] if _is_day(raw.get(key)) else None
        data["adLists"] = _ledger_count(raw.get("adLists"))
        for day, row in raw["days"].items():
            if _is_day(day) and isinstance(row, dict):
                ads = _ledger_count(row.get("ads"))
                apps = _ledger_apps(row.get("apps")) if ads is not None else None
                kept = row.get("kept") if _is_int(row.get("kept")) and row.get("kept") in (0, 1) else None
                data["days"][day] = {"ads": ads, "apps": apps if apps is not None or ads is None else {},
                                     "final": row.get("final") is True, "off": _ledger_seconds(row.get("off")),
                                     "seen": _ledger_seconds(row.get("seen")), "kept": kept}
        night = raw.get("night")
        if isinstance(night, dict) and _is_day(night.get("d")):
            data["night"] = {"d": night["d"], "seen": _ledger_seconds(night.get("seen")), "off": _ledger_seconds(night.get("off")),
                             "planned": int(_ledger_seconds(night.get("planned")))}
        before = raw.get("before") if isinstance(raw.get("before"), dict) else {}
        data["before"] = {"ads": _ledger_count(before.get("ads")) or 0, "apps": _ledger_apps(before.get("apps")) or {},
                          "off": _ledger_seconds(before.get("off")), "nights": _ledger_count(before.get("nights")) or 0,
                          "kept": _ledger_count(before.get("kept")) or 0}
        return data

    def _row(self, day: str) -> dict:
        return self.load()["days"].setdefault(day, {"ads": None, "apps": None, "final": False, "off": 0.0, "seen": 0.0,
                                                    "kept": None})

    # ----- what the scheduler sees on every pass -----
    def observe(self, now: dt.datetime, mono: float, offline: bool, kids: bool, active: bool, sched: dict) -> bool:
        """One pass of the scheduler that applied the rules on a believed clock. The time since the last such pass (at most
        LEDGER_STEP_MAX: a scheduler that stopped, or a clock that was not believed, does not know what happened meanwhile) is
        added to the day as watched, and as off while pb-offline is on and a child's device exists (with none, nobody's
        internet was off). While bedtime is on (scheduleActive), it is added to that night too. Returns True when an off
        period or a bedtime night has just ended: the page should hear of it soon."""
        data = self.load()
        step = 0.0 if self._last is None else min(max(mono - self._last, 0.0), LEDGER_STEP_MAX)
        self._last = mono
        today = now.date()
        if data["keptSince"] is None:
            data["keptSince"] = today.isoformat()
        off = offline and kids
        parts = [(today, step)]
        began = now - dt.timedelta(seconds=step)
        if began.date() != today:                       # the step crossed midnight: each day gets its own share
            before = (dt.datetime.combine(today, dt.time()) - began).total_seconds()
            parts = [(began.date(), before), (today, step - before)]
        for day, secs in parts:
            row = self._row(day.isoformat())
            row["seen"] += secs
            if off:
                row["off"] += secs
        ended = self._was_off and not off
        self._was_off = off
        night = data["night"]
        key = None
        if active:
            # scheduleActive is what the tick decided with its own clock, a moment before this pass's `now`: in the last
            # second of a bedtime it can still say "on" while `now` is past the end (or the parent has just edited the
            # times). That is still the night that is open, never a new one of today's date that ends 15 seconds later.
            key = bedtime_night(sched, now) if in_schedule(sched, now) else (night["d"] if night is not None else None)
        if night is not None and night["d"] != key:
            self._close_night()
            ended, night = True, None
        if key is not None:
            if night is None:
                night = data["night"] = {"d": key, "seen": 0.0, "off": 0.0, "planned": 0}
            night["planned"] = bedtime_seconds(sched, key)
            if kids:                                    # a night with no child's device kept nobody's bedtime
                night["seen"] += step
                if offline:
                    night["off"] += step
        if self._folded != today:
            self.fold(today)
        self.dirty = True
        return ended

    def _close_night(self) -> None:
        """Bedtime ended (or the night it belonged to is over): kept when the scheduler saw practically all of it and the
        internet was off for practically all it saw; not kept when it saw it but the internet was on (a parent switched it
        back on, a free-time timer); not known when it saw too little (the box was off, there was no child's device)."""
        data = self.load()
        night, data["night"] = data["night"], None
        if data["keptSince"] is None or night["d"] < data["keptSince"]:
            # A night that began before the scheduler counted anything (the first start ever came after midnight, in the
            # middle of it): the nights are counted from "keptSince", and the page reads one before it as not known.
            return
        planned = night["planned"]
        kept = None
        if planned > 0 and night["seen"] >= LEDGER_NIGHT_SEEN * planned:
            kept = 1 if night["off"] >= LEDGER_NIGHT_OFF * night["seen"] else 0
        row = self._row(night["d"])
        if kept is not None or row["kept"] is None:     # a night that was cut in two (the bedtime was edited) keeps what it knew
            row["kept"] = kept

    # ----- what Pi-hole's database says, read by the background job -----
    def windows(self, now: dt.datetime) -> list:
        """What read_stops should count: [(day, start, end, whole, gap)]. Today so far; every day of the last week the ledger
        holds and has not read whole since it ended (yesterday only LEDGER_SETTLE after midnight, when FTL has written its
        end); and the LEDGER_BACKFILL days before today that the ledger has nothing for and that came before it began
        counting (keptSince; until anything was counted at all, all of them) as gaps, counted only when the database holds
        the whole day, so that the week is full on the first day. Not only on the first read: a first read in the
        LEDGER_SETTLE after midnight has to leave yesterday for later, and must not leave it a gap for good."""
        data = self.load()
        today = now.date()
        out = [(today.isoformat(), day_start(today), now.timestamp(), False, False)]
        settled = now.timestamp() - day_start(today) >= LEDGER_SETTLE
        for back in range(1, LEDGER_WEEK + 1):
            day = today - dt.timedelta(days=back)
            if back == 1 and not settled:
                continue
            row = data["days"].get(day.isoformat())
            whole = (day.isoformat(), day_start(day), day_start(day + dt.timedelta(days=1)), True)
            if row is not None and not row["final"]:
                # A day with no counts yet is read only when the database holds the whole of it, like a gap.
                out.append(whole + (row["ads"] is None,))
            elif row is None and back <= LEDGER_BACKFILL and (
                    data["since"] is None or (data["keptSince"] is not None and day.isoformat() < data["keptSince"])):
                out.append(whole + (True,))
        return out

    def merge(self, result: dict, now: dt.datetime) -> None:
        """Take what read_stops counted. What it could not count leaves what was counted before alone. A day's count only
        grows: a smaller one means Pi-hole's database lost rows (flushed, or past its days), and what was counted stays. A
        day read whole after it ended is final."""
        data = self.load()
        if not isinstance(result, dict):
            return
        lists = _ledger_count(result.get("adLists"))
        if lists is not None:
            data["adLists"] = lists
        days = result.get("days") if isinstance(result.get("days"), dict) else {}
        for day, got in sorted(days.items()):
            if not _is_day(day) or not isinstance(got, dict):
                continue
            ads, apps = _ledger_count(got.get("ads")), _ledger_apps(got.get("apps"))
            if ads is None or apps is None:
                continue
            row = self._row(day)
            if row["final"]:
                continue
            if row["ads"] is None or ads + sum(apps.values()) >= row["ads"] + sum(row["apps"].values()):
                row["ads"], row["apps"] = ads, apps
            row["final"] = got.get("whole") is True
            if data["since"] is None or day < data["since"]:
                data["since"] = day
        self.fold(now.date())
        self.dirty = True

    def fold(self, today: dt.date) -> None:
        """Rows older than LEDGER_KEEP_DAYS days go into the running totals ("before"), which so outlive both the rows and
        Pi-hole's own limit. A row too old to be read whole again is final as it is. Rows of days after today (the clock
        was set back) are left alone: the clock comes right again."""
        data = self.load()
        self._folded = today
        oldest = (today - dt.timedelta(days=LEDGER_KEEP_DAYS - 1)).isoformat()
        last_read = (today - dt.timedelta(days=LEDGER_WEEK)).isoformat()
        b = data["before"]
        for day in sorted(data["days"]):
            row = data["days"][day]
            if day < oldest:
                if row["ads"] is not None:
                    b["ads"] += row["ads"]
                    for sid, n in row["apps"].items():
                        b["apps"][sid] = b["apps"].get(sid, 0) + n
                if data["keptSince"] is not None and day >= data["keptSince"]:
                    b["off"] += row["off"]
                if row["kept"] is not None:
                    b["nights"] += 1
                    b["kept"] += row["kept"]
                del data["days"][day]
                self.dirty = True
            elif day < last_read and not row["final"]:
                row["final"] = True
                self.dirty = True

    # ----- the page's copy -----
    def payload(self, now: dt.datetime, services, ad_lists: int) -> dict:
        """What pb-ledger holds (architecture.md, "Savings ledger (pb-ledger)"): today and the days of the week before it that
        the ledger has, oldest first, and the totals since "since" (stops) and "keptSince" (time off, nights). Whole numbers
        only, and only apps of the catalog (`services`)."""
        data = self.load()
        today = now.date().isoformat()
        since = min(data["since"], today) if data["since"] else None
        kept_since = min(data["keptSince"], today) if data["keptSince"] else None

        def top(apps):
            known = [(sid, int(n)) for sid, n in (apps or {}).items() if sid in services and n > 0]
            return dict(sorted(known, key=lambda kv: (-kv[1], kv[0]))[:LEDGER_APPS])

        def off_of(day, row):
            if kept_since is None or day < kept_since or (day != today and row["seen"] <= 0):
                return None                     # the scheduler did not watch that day
            return int(row["off"])
        days = []
        for back in range(LEDGER_WEEK - 1, -1, -1):
            day = (now.date() - dt.timedelta(days=back)).isoformat()
            row = data["days"].get(day)
            if row is None and day != today:
                continue                        # a day the box has nothing for is a gap
            row = row or {"ads": None, "apps": None, "off": 0.0, "seen": 0.0, "kept": None}
            days.append({"d": day, "ads": row["ads"], "apps": top(row["apps"]), "offSec": off_of(day, row), "kept": row["kept"]})
        b = data["before"]
        rows = list(data["days"].items())
        apps = dict(b["apps"])
        for _day, row in rows:
            for sid, n in (row["apps"] or {}).items():
                apps[sid] = apps.get(sid, 0) + n
        tot = {"ads": None if since is None else b["ads"] + sum(r["ads"] for _d, r in rows if r["ads"] is not None),
               "apps": top(apps),
               "offSec": None if kept_since is None else int(b["off"] + sum(r["off"] for d, r in rows if d >= kept_since)),
               "nights": b["nights"] + sum(1 for _d, r in rows if r["kept"] is not None),
               "nightsKept": b["kept"] + sum(r["kept"] for _d, r in rows if r["kept"] is not None)}
        return {"v": 1, "at": int(now.timestamp()), "today": today, "since": since, "keptSince": kept_since,
                "adLists": int(ad_lists), "days": days, "tot": tot}


def ledger_lines(payload: dict, lists=None) -> list:
    """`diagnose`'s summary of the ledger: counts only. `lists`: the number of other block lists, None when not known."""
    if payload["since"] is None and payload["keptSince"] is None:
        return ["  nothing counted yet"]
    tot = payload["tot"]
    out = ["  stops counted since %s, time off and bedtime since %s; %s block list(s) besides Sinko's"
           % (payload["since"] or "-", payload["keptSince"] or "-", "?" if lists is None else lists)]
    out.append("  in all: %s ads and trackers stopped; apps %s; %s hours off; bedtime kept %d of %d nights"
               % ("?" if tot["ads"] is None else tot["ads"], ", ".join("%s %d" % kv for kv in tot["apps"].items()) or "none",
                  "?" if tot["offSec"] is None else "%.1f" % (tot["offSec"] / 3600.0), tot["nightsKept"], tot["nights"]))
    for day in payload["days"]:
        out.append("  %s  ads %-7s apps %-6s off %-8s bedtime %s"
                   % (day["d"], "?" if day["ads"] is None else day["ads"], sum(day["apps"].values()),
                      "?" if day["offSec"] is None else "%.1f h" % (day["offSec"] / 3600.0),
                      {1: "kept", 0: "not kept", None: "-"}[day["kept"]]))
    return out


class Maintenance:
    """The scheduler's side jobs: update check and install, power requests, address watch, anonymous counter, learning
    new addresses of blocked apps, the savings ledger.

    `Controller.tick` stays the only code that changes the parent's rules; the learner adds only its own (pb-learned:,
    see Learner). These jobs only touch the keys of the shared state that belong to the scheduler (update.*, community,
    and clearing request markers), and every one of them is wrapped:
    a failing job is logged (not every 15 seconds) and never stops the tick or the other jobs. Anything slow (network,
    systemd, pihole-FTL) runs in a BackgroundJob; the tick thread only reads files and talks to Pi-hole's API.
    """
    CHECK_FIRST = 120                 # seconds after start, then every day (or when the page asks)
    CHECK_EVERY = 24 * 3600
    CHECK_RETRY = 1800                # a check that failed (offline, GitHub's limit) is tried again after this plus up to as much
    ADDRESS_FIRST = 30
    ADDRESS_EVERY = 300
    MIN_RUN_GAP = 300                 # between two update runs
    RUNNER_GRACE = 180                # a run that says "running" and has no runner (no lock held) for this long is over
    FAILED_BLOCKS_AUTO = 7 * 24 * 3600
    TRANSIENT_RETRY = 1800            # ... but after a failure of the network or the disk, the same release is tried again after this
    AUTO_WINDOW = (3, 5)              # box time, hours: 03:00 up to 05:00
    REQUEST_MAX_AGE = 15 * 60         # a request is for now: one whose time is further than this from the box's clock is dropped
    REQUEST_TIME_FROM = 10 ** 11      # markers from here up are times in milliseconds (what the page writes); any other marker is opaque
    COMPLAIN_EVERY = 1800
    PING_FIRST = 300
    PING_EVERY = 6 * 3600
    PING_JITTER = 1800                # +-, so the boxes do not all call in at the same minute
    PING_RETRY = 1800
    BOXINFO_FIRST = 10                # box.json: first write soon after start, then every five minutes
    BOXINFO_EVERY = 300
    CLOCK_STEP = 30                   # seconds: the box's clock moved this much more (or less) than time passed: it was set
    HEAL_CHECK_EVERY = 300            # looking for missing lists (missing groups are seen on every pass)
    HEAL_STREAK = 3                   # passes in a row that must see something missing (FTL may be rebuilding gravity)
    HEAL_EVERY = 3600                 # at most one repair an hour
    PAGE_LOOK_EVERY = 60              # the page's version file is read this often (it needs pihole-FTL's settings: a job)
    REPAIR_AFTER = 600                # the page and the program must have been of different versions this long (seconds)

    def __init__(self, api=None, config_path=None, monotonic=time.monotonic, job_factory=BackgroundJob, clock_ok=None,
                 check=None, start_runner=None, power=None, default_ip=None, apply_address=None, ping=None, body=None,
                 jitter=None, box_info=None, forget=None, heal=None, recover=None, catalog=None, page_version=None,
                 start_repair=None, learner=None, ledger=None, stops=None):
        self.api = api
        self.config_path = config_path or CONFIG_FILE
        self.mono = monotonic
        self._job_factory = job_factory
        self.clock_ok = clock_ok or (lambda: True)
        self.check = check or check_for_update
        self.start_runner = start_runner or start_update_runner
        self.power = power or run_power
        self.default_ip = default_ip or default_route_ipv4
        self.apply_address = apply_address or apply_new_address
        self.ping = ping or send_ping
        self.body = body or telemetry_body
        self.jitter = jitter or random.uniform
        self.box_info = box_info or write_box_info
        self.forget = forget or send_forget
        self.heal = heal or run_self_heal
        self.recover = recover or recover_check
        self.catalog = catalog or load_catalog_safely
        # The repair of a half-finished update (see _page) is off unless both are given: the scheduler gives the real ones,
        # and a test that does not mean to start an installer cannot do it by accident.
        self.page_version = page_version
        self.start_repair = start_repair
        self.learner = learner or Learner()
        # The savings ledger (see _ledger) is off unless a Ledger is given, like the repair: the scheduler gives the real one,
        # and a test that is about something else neither reads this machine's Pi-hole database nor adds a group.
        self.ledger = ledger
        self.stops = stops or read_stops
        started = monotonic()
        self._next_check = started + self.CHECK_FIRST
        self._next_address = started + self.ADDRESS_FIRST
        self._next_ping = started + self.PING_FIRST
        self._next_forget = started
        self._next_boxinfo = started + self.BOXINFO_FIRST
        self._next_heal_check = started
        self._next_heal = started
        self._next_page_look = started
        self._next_learn = started
        self._next_ledger = started       # the stops are read right after the start, then every LEDGER_REFRESH
        self._next_ledger_save = started + LEDGER_REFRESH
        self._ledger_read_at = None       # the box's time when the last read of the stops that is back began (None: none yet)
        self._ledger_today = None         # the box's day at the last pass that counted (a new one makes the read due)
        self._ledger_hold = None          # until when a copy waits for the first read of a new day (monotonic)
        self._ledger_written = None       # when pb-ledger was last written (or first found to say the same after the start)
        self._ledger_day = None           # the box's day at that moment
        self._ledger_event = False        # an off period or a bedtime night ended since then
        self._ledger_why = None           # why the stops cannot be counted, as last logged
        self._kids = None                 # a child's device exists (asked every LEDGER_LOOK_KIDS seconds while it matters)
        self._next_kids = started
        self._ad_lists = None             # (when to ask again, how many) from /api/lists, while the ledger does not know
        self._mismatch_since = None       # when the page and the program were first seen to be of different versions
        self._heal_streak = 0
        self._lists_missing = []
        self._catalog = None
        self._was_trusted = None          # whether the clock was believed on the pass before (None: no pass yet)
        self._last_pass = None            # (the box's clock, the monotonic clock) at the previous pass: a step shows as a difference
        self._clock_stepped = False       # the clock was set since box.json was last written
        self._check_forced = False
        self._force_check = False
        self._jobs = {}
        self._callbacks = {}
        self._state = None
        self._groups = {}
        self._last_logged = {}
        self._actions = []
        self.tick_ok = True               # the scheduler's loop says whether this pass's tick worked (see Scheduler)

    # ----- plumbing -----
    def conf(self) -> dict:
        return read_config(self.config_path)

    def run(self, now: dt.datetime) -> list:
        """One pass of every side job. Never raises. Returns what it did, as text."""
        self._actions = []
        epoch = now.timestamp()
        self._note_clock_step(epoch)
        self._state = None
        steps = (("jobs", self._collect), ("reconcile", self._reconcile), ("check", self._check),
                 ("update", self._update), ("power", self._power), ("address", self._address),
                 ("box.json", self._boxinfo), ("telemetry", self._telemetry), ("self-repair", self._heal),
                 ("page", self._page), ("learning", self._learn), ("savings ledger", self._ledger))
        try:
            self._cur()
        except LookupError:
            # The shared state is not there: `sinko setup` has not run yet, or somebody deleted it (or restored a
            # backup that lacks it). Nothing can be asked of the page, but the repair is exactly for this.
            steps = (("jobs", self._collect), ("self-repair", self._heal))
        except Exception as err:
            self._complain("state", err)
            return []
        for name, step in steps:
            try:
                step(now, epoch)
            except Exception as err:
                self._complain(name, err)
                self._state = None
        for line in self._actions:
            log.info(line)
        return self._actions

    def _note_clock_step(self, epoch: float) -> None:
        """Remember that the box's clock was set (by the time server, after a start with the last saved time): between two
        passes it moved by another amount than the monotonic clock, which only ever counts real time. box.json carries the
        box's clock and the page reads it as the scheduler's pulse; see _boxinfo."""
        mono = self.mono()
        last, self._last_pass = self._last_pass, (epoch, mono)
        if last is not None and abs((epoch - last[0]) - (mono - last[1])) > self.CLOCK_STEP:
            self._clock_stepped = True
            log.debug("the box's clock was set (it moved %d s while %d s passed)", epoch - last[0], mono - last[1])

    def _complain(self, name: str, err) -> None:
        """Log a failure of a side job at most once every 30 minutes per job (a network that is down would otherwise
        fill the log with a line every 15 seconds)."""
        log.debug("maintenance job %s failed", name, exc_info=err if isinstance(err, BaseException) else None)
        now = self.mono()
        last = self._last_logged.get(name)
        if last is None or now - last >= self.COMPLAIN_EVERY:
            self._last_logged[name] = now
            log.warning("%s: %s (shown at most every %d minutes)", name, short_text(err, 160), self.COMPLAIN_EVERY // 60)

    def _read(self) -> dict:
        groups = self._groups = self.api.group_map()
        if G_STATE not in groups:
            raise LookupError("the shared state does not exist yet")
        return parse_state(groups[G_STATE].get("comment"))

    def _cur(self):
        if self._state is None:
            self._state = self._read()
        return self._state

    def _change(self, mutate) -> bool:
        """Apply `mutate` to the state as it is right now (re-read, so what the page wrote a moment ago is kept) and
        write it only if something changed: every write makes Pi-hole reload."""
        self._state = None
        return patch_state(self.api, mutate)

    def _spawn(self, name: str, fn, callback) -> bool:
        job = self._jobs.get(name)
        if job is None:
            job = self._jobs[name] = self._job_factory(name)
        if job.busy():
            return False
        self._callbacks[name] = callback
        return job.start(fn)

    def _collect(self, now, epoch) -> None:
        for name, job in list(self._jobs.items()):
            outcome = job.take()
            if outcome is None:
                continue
            try:
                self._callbacks.pop(name)(outcome, epoch)
            except Exception as err:
                self._complain(name, err)
                self._state = None

    @staticmethod
    def _slot(state: dict, kind: str):
        return {"update": (state["update"], "request"), "check": (state["update"], "checkRequest"),
                "power": (state["power"], "request")}[kind]

    def _take_marker(self, kind: str, marker, extra=None):
        """The request protocol: store the marker as handled, clear it in the state, and only then may the caller act.

        Returns what was seen in the state (a dict: {"action": ...} for power), or None when the caller must not act:
        the page wrote another request in between (that one is picked up on the next tick). If the state cannot be
        written the marker is forgotten again, so a request is never lost.
        """
        previous = load_handled().get(kind)
        set_handled(kind, marker)
        seen = {}

        def clear(state):
            node, key = self._slot(state, kind)
            if node[key] != marker:
                seen["aborted"] = True
                return
            node[key] = None
            if kind == "power":
                seen["action"], node["action"] = node["action"], None
            if extra:
                extra(state)
        try:
            self._change(clear)
        except BaseException:
            set_handled(kind, previous)
            raise
        if seen.pop("aborted", False):
            set_handled(kind, previous)
            return None
        return seen

    def _clear_stale(self, kind: str, marker) -> None:
        """A request that must not be acted on is in the state: one this box already acted on (it was cut off before the
        clearing, or the page was slow), or one that is too old (see _request_is_old). Remove it, and do not act."""
        def clear(state):
            node, key = self._slot(state, kind)
            if node[key] == marker:
                node[key] = None
                if kind == "power":
                    node["action"] = None
        self._change(clear)

    def _request_is_old(self, marker, epoch: float) -> bool:
        """A request is for now. The page writes its time in milliseconds on the box's clock, and a request whose time is more than
        REQUEST_MAX_AGE away from the box's clock (before or after) was not made by a parent a moment ago. The one that matters is in a
        backup: a restore puts the backup's description of the shared state back, and with it every request that was waiting when the backup
        was made. The page puts today's fields back right after, but a pass of this scheduler can land in between, and a request that this
        box never handled looks new to it. A marker that is not a time (the protocol keeps markers opaque) is never old, and neither is any
        request while the box's clock is not believed: those are acted on as before."""
        return (_is_number(marker) and marker >= self.REQUEST_TIME_FROM and self.clock_ok()
                and abs(epoch - marker / 1000.0) > self.REQUEST_MAX_AGE)

    # ----- the update's result -----
    def _reconcile(self, now, epoch) -> None:
        u = self._cur()["update"]
        stale_latest = bool(u["latest"]) and not is_newer(u["latest"], VERSION)
        if not stale_latest and u["status"] != "running":
            return
        result = read_update_result() if u["status"] == "running" else None
        seen = {}

        def mutate(state):
            up = state["update"]
            if up["latest"] and not is_newer(up["latest"], VERSION):
                up["latest"] = up["notes"] = None                       # that release is installed now
            if up["status"] != "running":
                return
            if result is not None and result["at"] >= up["at"] - 5:
                failed = result["status"] == "failed"
                up["status"] = result["status"]
                up["from"] = result["from"] or up["from"]
                up["to"] = result["to"] or up["to"]
                up["error"] = result["error"] if failed else None
                up["rolledBack"] = result["rolledBack"] if failed else None
                up["at"] = result["at"]
                if result["status"] == "ok" and up["latest"] and result["to"] and not is_newer(up["latest"], result["to"]):
                    up["latest"] = up["notes"] = None
                # The retry rule (failure_is_transient) knows a failure by the release the STATE names. A run that stopped
                # before it knew which release (no room on the card, say) says none, and the state keeps the one it had set.
                seen["result"] = dict(result, to=up["to"])
            elif self._runner_gone(up, epoch):
                seen["gone"] = up["at"]                                 # decided below, once the box has been looked at
        self._change(mutate)
        if "result" in seen:
            if seen["result"]["status"] == "failed":
                note_failure(seen["result"])                            # before the file goes: it says whether to retry soon
            clear_update_result()                                       # only after the state holds it
            self._actions.append("update %s" % ("finished" if seen["result"]["status"] == "ok" else "failed"))
        elif "gone" in seen:
            started = seen["gone"]
            self._spawn("recover", self.recover, lambda outcome, e: self._recovered(outcome, e, started))

    def _runner_gone(self, up: dict, epoch: float) -> bool:
        """The update says "running" but nothing is running it: the box lost power in the middle of it, or the runner
        was killed or never started. The runner holds a lock for as long as it lives, so a free lock is the proof; the
        grace is for a runner that has not taken the lock yet. Not decided on a clock that is not believed."""
        return abs(epoch - up["at"]) > self.RUNNER_GRACE and self.clock_ok() and not RunLock.is_held()

    def _recovered(self, outcome, epoch, started) -> None:
        """What the box looks like after a run that died: the answer of recover_check(). If the new version is in place
        and everything passes, the update did finish (the box lost power during its own check, say); if the old one
        still works, that is said; if neither passes, that is said too, and the page asks the parent for help."""
        status, value = outcome
        if status == "error":
            self._complain("update check after an interrupted update", value)
            value = {"ok": False, "detail": "the check could not run"}

        def mutate(state):
            up = state["update"]
            if up["status"] != "running" or up["at"] != started or RunLock.is_held():
                return                                                  # decided by somebody else in the meantime
            up["at"] = epoch
            if value["ok"] and up["to"] == VERSION:
                up["status"], up["error"], up["rolledBack"] = "ok", None, None
                if up["latest"] and not is_newer(up["latest"], VERSION):
                    up["latest"] = up["notes"] = None
            elif value["ok"]:
                up["status"], up["rolledBack"] = "failed", True
                up["error"] = "The update did not finish. This box still works with version %s." % VERSION
            else:
                up["status"], up["rolledBack"] = "failed", False
                up["error"] = short_text("The update did not finish, and the box does not pass its own check (%s)."
                                         % (value.get("detail") or "no reason given"))
        if self._change(mutate):
            self._actions.append("update did not finish (the box was checked)")

    # ----- update check -----
    def _check_enabled(self) -> bool:
        try:
            return classify_ref(release_settings(self.conf())["ref"])[0] != "branch"      # a developer box is never offered a release
        except UpdateError:
            return False

    def _check(self, now, epoch) -> None:
        u = self._cur()["update"]
        forced = False
        marker = u["checkRequest"]
        if marker is not None:
            if load_handled().get("check") == marker:
                self._clear_stale("check", marker)
            elif self._request_is_old(marker, epoch):
                self._clear_stale("check", marker)
                self._actions.append("check request ignored: it is too old to be a parent's")
            elif self._take_marker("check", marker) is not None:
                forced = True
                self._actions.append("check requested by the page")
        if not self._check_enabled():
            return
        forced = forced or self._force_check
        if not (forced or (self.mono() >= self._next_check and self.clock_ok())):
            return
        conf = self.conf()
        if self._spawn("check", lambda: self.check(conf), self._check_done):
            self._next_check = self.mono() + self.CHECK_EVERY
            self._check_forced, self._force_check = forced, False
        elif forced:
            self._force_check = True           # a check is running already: ask again when it is done

    def _check_done(self, outcome, epoch) -> None:
        status, value = outcome
        if status == "error":
            self._complain("update check", value)      # offline or rate limited: the old answer stays
            # Not tomorrow: a cable that was out at the check's minute, or GitHub's 60 requests an hour per address
            # (one address can be a whole street), would hold back a security update for a day. The spread keeps the
            # boxes that failed together from asking together again.
            self._next_check = self.mono() + self.CHECK_RETRY + self.jitter(0, self.CHECK_RETRY)
            return
        latest = value["version"] if value else None
        notes = value["notes"] if value else None
        forced = self._check_forced

        def mutate(state):
            u = state["update"]
            if u["latest"] != latest or u["notes"] != notes or forced or not 0 <= epoch - u["checked"] < 86400:
                u["latest"], u["notes"], u["checked"] = latest, notes, epoch
        self._change(mutate)
        if latest:
            self._actions.append("update %s is available" % latest)

    # ----- update run -----
    def _update(self, now, epoch) -> None:
        st = self._cur()
        u = st["update"]
        marker = u["request"]
        if marker is not None and load_handled().get("update") == marker:
            self._clear_stale("update", marker)
            return
        if marker is not None and self._request_is_old(marker, epoch):
            self._clear_stale("update", marker)
            self._actions.append("update request ignored: it is too old to be a parent's")
            return
        too_soon = u["status"] in ("ok", "failed") and 0 <= epoch - u["at"] < self.MIN_RUN_GAP
        if marker is not None:
            if u["status"] == "running":
                if self._take_marker("update", marker) is not None:
                    self._actions.append("update request ignored: an update is already running")
                return
            if too_soon:
                return                         # keep the request; it is acted on when the gap is over
            self._begin_update(epoch, marker, "update requested by the page")
            return
        if (u["auto"] and u["latest"] and is_newer(u["latest"], VERSION) and u["status"] != "running" and not too_soon
                and self.AUTO_WINDOW[0] <= now.hour < self.AUTO_WINDOW[1] and self.clock_ok()
                and not self._failed_recently(u, epoch)):
            self._begin_update(epoch, None, "automatic update to %s" % u["latest"])

    def _failed_recently(self, u: dict, epoch: float) -> bool:
        """This release failed here lately, so the night's automatic update leaves it alone: for a week when the
        release itself was the trouble, for half an hour when it was only the network or the disk."""
        if not (u["status"] == "failed" and u["to"] == u["latest"]):
            return False
        wait = self.TRANSIENT_RETRY if failure_is_transient(u) else self.FAILED_BLOCKS_AUTO
        return epoch - u["at"] < wait

    def _begin_update(self, epoch: float, marker, why: str) -> None:
        def running(state):
            up = state["update"]
            up["status"], up["at"], up["error"], up["rolledBack"] = "running", epoch, None, None
            up["from"], up["to"] = VERSION, up["latest"]
        if marker is not None:
            if self._take_marker("update", marker, running) is None:
                return
        else:
            self._change(running)
        clear_update_result()                  # the runner's result is the only one the next reconcile may see
        self._actions.append(why)
        if not self._spawn("runner", self.start_runner, self._runner_started):
            self._runner_started(("ok", False), epoch)

    def _runner_started(self, outcome, epoch) -> None:
        status, value = outcome
        if status == "ok" and value:
            return
        if status == "error":
            self._complain("update runner", value)
        else:
            self._complain("update runner", "it could not be started")

        def failed(state):
            up = state["update"]
            if up["status"] == "running" and not RunLock.is_held():
                up["status"], up["error"], up["at"] = "failed", "The update could not be started.", epoch
                up["rolledBack"] = None            # nothing was installed and nothing was checked: not known, so not claimed
        self._change(failed)

    # ----- power -----
    def _power(self, now, epoch) -> None:
        st = self._cur()
        marker = st["power"]["request"]
        if marker is None:
            return
        if load_handled().get("power") == marker:
            self._clear_stale("power", marker)
            return
        if self._request_is_old(marker, epoch):
            self._clear_stale("power", marker)
            self._actions.append("power request ignored: it is too old to be a parent's")
            return
        if st["update"]["status"] == "running":
            # Never cut the power in the middle of an installation, and never keep the request for later either: it
            # would sit in the shared state, survive a power cycle, and fire at a moment nobody chose, with the page
            # long since saying something else. The page does not offer the buttons while an update runs and withdraws
            # a request nobody answered; a request that still gets here (a second phone, bad timing) is dropped.
            if self._take_marker("power", marker) is not None:
                self._actions.append("power request ignored: an update is running")
            return
        seen = self._take_marker("power", marker)
        if seen is None or seen.get("action") not in POWER_ACTIONS:
            return
        action = seen["action"]
        self._actions.append("power request: %s" % action)
        self._spawn("power", lambda: self.power(action), self._power_done)

    def _power_done(self, outcome, epoch) -> None:
        if outcome[0] == "error":
            self._complain("power request", outcome[1])

    # ----- address watch -----
    def _address(self, now, epoch) -> None:
        if self.mono() < self._next_address:
            return
        self._next_address = self.mono() + self.ADDRESS_EVERY
        conf = self.conf()
        known = conf.get("SINKO_IP")
        if not known:
            return                             # not a box this program installed
        current = self.default_ip()
        if not current or current == known or not valid_lan_ip(current):
            return
        self._actions.append("address changed from %s to %s" % (known, current))
        self._spawn("address", lambda: self.apply_address(current, conf, self.config_path), self._address_done)

    def _address_done(self, outcome, epoch) -> None:
        if outcome[0] == "error":
            self._complain("address change", outcome[1])       # retried at the next address check

    # ----- box.json (what the page may know about the box, and the scheduler's pulse for the parent) -----
    def _boxinfo(self, now, epoch) -> None:
        """Refresh /pb/box.json every five minutes, in a job of its own (it asks the web server's settings, systemd and
        the routing table: nothing the tick should wait for). Only while the rules are being applied (the file says
        "the scheduler works"), not while an update runs (the installer swaps the folder the file lives in), and
        straight away once the clock is believed (the time in the file has to match it), and straight away when the clock
        was set later on (a box that started on its last saved time and believed it after ten minutes without a time
        server writes that time; when the internet comes back and the clock jumps, the file would be hours or days
        behind for up to five minutes, and the page would call the scheduler dead and tell the parent to unplug a healthy
        box). A failure to write is logged now and then and never reaches the tick."""
        trusted = bool(self.clock_ok())
        became_trusted, self._was_trusted = trusted and self._was_trusted is False, trusted
        if not self.tick_ok or not trusted:
            return
        if self._cur()["update"]["status"] == "running" or RunLock.is_held():
            return
        now_please = became_trusted or self._clock_stepped
        if not now_please and self.mono() < self._next_boxinfo:
            return
        conf = self.conf()
        if self._spawn("boxinfo", lambda: self.box_info(conf, force=now_please), self._boxinfo_done):
            self._next_boxinfo = self.mono() + self.BOXINFO_EVERY
            self._clock_stepped = False

    def _boxinfo_done(self, outcome, epoch) -> None:
        if outcome[0] == "error":
            self._complain("box.json", outcome[1])
            self._next_boxinfo = self.mono() + 60                 # the folder may only be missing for a moment

    # ----- anonymous counter -----
    def _telemetry(self, now, epoch) -> None:
        """Nothing is sent unless the parent said yes (the state is the only authority) AND a counter address is
        configured. When the answer is "no" the counter is asked to forget the box's id (see _forget)."""
        st = self._cur()
        on = st["telemetry"]["on"]
        if on is not True and st["community"] is not None:
            self._change(lambda state: state.update(community=None))          # an old number must not outlive the "no"
        self._forget(on)
        if on is not True or forget_pending():                                # never a ping while a forget is pending
            return
        url = telemetry_url(self.conf())
        if not url or self.mono() < self._next_ping or not self.clock_ok():
            return
        self._next_ping = self.mono() + self.PING_EVERY + self.jitter(-self.PING_JITTER, self.PING_JITTER)
        self._spawn("ping", lambda: self._send_ping(url), self._ping_done)

    def _send_ping(self, url: str):
        body = self.body()
        note_counter_sent()                    # before the request leaves: one that fails half way may still have arrived
        return self.ping(url, body)

    def _forget(self, on) -> None:
        """The counter forgets the box when the answer became "no" (the page, `sinko telemetry off`, `reset-id`): ask it
        to delete the id, then delete the id here. If that fails the id stays with a marker and it is asked again every
        ping interval; nothing else is sent to the counter in the meantime."""
        pending = forget_pending()
        if not pending and not (on is False and (counter_sent() or install_id(create=False) is not None)):
            return
        if self.mono() < self._next_forget:
            return
        job = self._jobs.get("ping")
        if job is not None and job.busy():
            return                             # let a ping that is on its way land first: forgetting comes after it
        url = telemetry_url(self.conf())
        if self._spawn("forget", lambda: forget_counter_id(url, self.forget), self._forget_done):
            self._next_forget = self.mono() + self.PING_EVERY + self.jitter(-self.PING_JITTER, self.PING_JITTER)

    def _forget_done(self, outcome, epoch) -> None:
        status, value = outcome
        if status == "error":
            self._complain("anonymous counter (forgetting the id)", value)
            return
        what, detail = value
        if what == "pending":
            self._complain("anonymous counter (forgetting the id)", detail)       # asked again after a ping interval
        elif what == "forgotten":
            self._next_forget = self.mono()                                      # nothing left to wait for
            self._actions.append("the counter forgot this box's id")

    # ----- self-repair: what Sinko needs inside Pi-hole went missing -----
    def _heal(self, now, epoch) -> None:
        """A group or a list of a service is missing from Pi-hole (deleted in the admin pages, or a backup from another
        version was restored): run what `sinko setup` does, gravity included, in a background job, at most once an
        hour, and say so in the log at most every half hour. Only pb-* objects are ever touched."""
        if "Default" not in self._groups:
            return                             # an answer without even Pi-hole's own group is not one to act on
        try:
            if self._catalog is None:
                self._catalog = self.catalog()
        except CatalogError:
            return                             # nothing to compare with: the loop reports an unreadable catalog
        names = [G_KIDS, G_GUARD, G_OFFLINE, G_PAUSED, G_STATE] + [svc_group(s["id"]) for s in self._catalog["services"]]
        missing = [n for n in names if n not in self._groups]
        if missing or self._lists_missing or self.mono() >= self._next_heal_check:      # while in doubt, look on every pass
            self._next_heal_check = self.mono() + self.HEAL_CHECK_EVERY
            comments = {l.get("comment") for l in self.api.lists()}
            ids = [s["id"] for s in self._catalog["services"]] + ["guard"]
            self._lists_missing = [i for i in ids if LIST_COMMENT_PREFIX + i not in comments]
        if not missing and not self._lists_missing:
            self._heal_streak = 0
            return
        self._heal_streak += 1                 # FTL may be rebuilding gravity: it has to look like this for a while
        if (self._heal_streak < self.HEAL_STREAK or self.mono() < self._next_heal
                or os.path.exists(state_path("removed")) or self._update_going()):
            return
        what = ", ".join(missing[:3] + ["the list of " + i for i in self._lists_missing[:3]])
        if self._spawn("heal", self.heal, self._heal_done):
            self._next_heal = self.mono() + self.HEAL_EVERY
            self._heal_streak = 0
            self._lists_missing = []
            self._next_heal_check = self.mono() + 60
            if self._gate_allows("heal-start"):
                log.warning("Pi-hole lacks %s: setting Sinko up again (at most once an hour)", what)

    # ----- learning new addresses of blocked apps -----
    def _learn(self, now, epoch) -> None:
        """Once a minute while the parent has it switched on (`learn.on`), and only while the clock is believed (a
        learned rule carries its day, and the daily limit counts by it). See Learner."""
        if not self._cur()["learn"]["on"]:
            self.learner.reset()
            return
        if self.mono() < self._next_learn or not self.clock_ok():
            return
        self._next_learn = self.mono() + Learner.EVERY
        self._actions.extend(self.learner.run(self.api, self._groups, epoch))

    # ----- what Sinko did for the family (the savings ledger) -----
    def _ledger(self, now, epoch) -> None:
        """The counts behind the page's card "What Sinko did for you" (Ledger). On every pass whose rules were applied on a
        believed clock: the time the children's internet was off and the bedtime nights. Every LEDGER_REFRESH, and right after
        the start: the stops, read from Pi-hole's database in a job of their own (slow on a busy day, and it runs programs).
        Now and then a copy for the page (_publish_ledger). savings.json is written with each read of the stops (or every
        LEDGER_REFRESH, should that job hang) and when the scheduler stops, so a power cut loses at most that much."""
        if self.ledger is None or not self.tick_ok or not self.clock_ok():
            return
        st = self._cur()
        offline = bool(self._groups.get(G_OFFLINE, {}).get("enabled"))
        active = st["scheduleActive"]
        kids = self._kids_present() if offline or active else False
        if self.ledger.observe(now, self.mono(), offline, kids, active, st["schedule"]):
            self._ledger_event = True
        today = now.date()
        if self._ledger_today is not None and today != self._ledger_today:
            # A new day. Until a read of it is back, a copy for the page would say that today's stops are not known, and the
            # next write could be an hour away: _publish_ledger waits for that read (at most _ledger_hold). It is the one
            # LEDGER_SETTLE after midnight, which also reads yesterday whole, rather than whichever of every LEDGER_REFRESH.
            wait = max(0.0, day_start(today) + LEDGER_SETTLE - now.timestamp())
            self._next_ledger = self.mono() + wait
            self._ledger_hold = self.mono() + wait + LEDGER_REFRESH
        self._ledger_today = today
        if self.mono() >= self._next_ledger:
            windows, services = self.ledger.windows(now), self._services()
            if self._spawn("savings", lambda: self.stops(windows, services),
                           lambda outcome, _epoch, at=now: self._ledger_done(outcome, at)):
                self._next_ledger = self.mono() + LEDGER_REFRESH
        if self.ledger.dirty and self.mono() >= self._next_ledger_save:
            self._save_ledger()
        self._publish_ledger(now)

    def _ledger_done(self, outcome, at) -> None:
        """The stops were read (`at` is the box's time when the read began: the days it names are of that time)."""
        status, value = outcome
        self._ledger_read_at = at.timestamp()          # also when it failed: the copy that waits for it says "not known"
        if status == "error":
            self._complain("savings ledger", value)
        else:
            self.ledger.merge(value, at)
            why = value.get("why") if isinstance(value, dict) else None
            if why != self._ledger_why:
                self._ledger_why = why
                if why:
                    log.info("what the box stopped is not counted for now: %s", why)
        self._save_ledger()

    def _save_ledger(self) -> None:
        self._next_ledger_save = self.mono() + LEDGER_REFRESH
        try:
            self.ledger.save()
        except OSError as err:
            self._complain("savings ledger", err)

    def _services(self) -> set:
        """The ids of the catalog's apps (the only apps the ledger names)."""
        try:
            if self._catalog is None:
                self._catalog = self.catalog()
            return {s["id"] for s in self._catalog["services"]}
        except CatalogError:
            return set()

    def _kids_present(self) -> bool:
        """Is there a child's device at all (a client in pb-kids)? Asked of Pi-hole once a minute, and only while the
        internet is off or bedtime is on: with no child's device, nobody's internet was off."""
        if self._kids is None or self.mono() >= self._next_kids:
            kid_id = self._groups.get(G_KIDS, {}).get("id")
            self._kids = kid_id is not None and any(kid_id in c.get("groups", []) for c in self.api.clients())
            self._next_kids = self.mono() + LEDGER_LOOK_KIDS
        return self._kids

    def _ad_lists_now(self) -> int:
        """How many block lists that are not Sinko's are switched on: the ledger's count from gravity.db, or, until it has
        one, Pi-hole's own answer (asked at most once an hour)."""
        known = self.ledger.load()["adLists"]
        if known is not None:
            return known
        if self._ad_lists is None or self.mono() >= self._ad_lists[0]:
            n = sum(1 for l in self.api.lists() if l.get("enabled") and l.get("type", "block") == "block"
                    and not l.get("comment", "").startswith(LIST_COMMENT_PREFIX))
            self._ad_lists = (self.mono() + LEDGER_PUBLISH_EVERY, n)
        return self._ad_lists[1]

    def _publish_ledger(self, now) -> None:
        """Give the page its copy (pb-ledger, made when missing: disabled, and no client ever joins it) when it says
        something new, but not more often than Pi-hole should reload its lists, which every group write makes it do: once
        after the start (when the first stops are in), then when LEDGER_PUBLISH_EVERY has passed since the last write, the
        box's day has changed, or an off period or a bedtime night has ended. The group is compared with what the ledger
        says, so a restored backup or a hand edit is put right at the next such moment. Never while an update runs (the
        installer restarts Pi-hole), nor after Sinko was removed on purpose; and after midnight not before the first read of
        the new day is back (see _ledger), whatever the reason to write. A write that fails is tried again on the next pass:
        what made it due stays due."""
        if os.path.exists(state_path("removed")) or self._update_going() or self._ledger_read_at is None:
            return
        mono, today = self.mono(), now.date().isoformat()
        if (self._ledger_read_at < day_start(now.date()) and self._ledger_hold is not None and mono < self._ledger_hold):
            return
        if self._ledger_written is not None and not (mono - self._ledger_written >= LEDGER_PUBLISH_EVERY
                                                     or today != self._ledger_day or self._ledger_event):
            return
        text = ledger_text(self.ledger.payload(now, self._services(), self._ad_lists_now()))
        group = self._groups.get(G_LEDGER)
        if group is not None and not group.get("enabled") and same_ledger(parse_ledger(group.get("comment")), json.loads(text)):
            if self._ledger_written is None:
                self._ledger_written = mono   # what the group already says after a start counts as the last write
        else:
            if group is None:
                self.api.add_group(G_LEDGER, text, False)
            else:
                self.api.put_group(G_LEDGER, text, False)
            self._ledger_written = mono
        self._ledger_day, self._ledger_event = today, False

    def close(self) -> None:
        """The scheduler stops cleanly: keep what the ledger counted since its last save."""
        if self.ledger is not None and self.ledger.dirty:
            try:
                self.ledger.save()
            except OSError as err:
                log.warning("could not keep what the box counted: %s", short_text(err, 100))

    # ----- the page and the program are of one version -----
    def _page(self, now, epoch) -> None:
        """An update that is cut off (the power goes) between the replacing of the program and the replacing of the page
        leaves a box with a new program and the old page, or the other way round after a rollback. The box still filters
        and keeps bedtime, but nothing else puts it right: the update says "already the newest version" (the program has
        it), the check of the box says the versions differ, and a box nobody can log in to cannot be told to install
        again. So: when the page and the program have been of different versions for ten minutes, with no update or
        installation running and the box not removed on purpose, `sinko repair` installs this version again from the
        copy on the box (nothing is downloaded), as a unit of its own because the installer restarts this scheduler. At
        most once an hour, and the note of the last try is kept on disk, because the restart forgets everything here."""
        if self.page_version is None or self.start_repair is None:
            return
        if self._repair_blocked():
            self._mismatch_since = None
            return
        if self.mono() < self._next_page_look:
            return
        self._next_page_look = self.mono() + self.PAGE_LOOK_EVERY
        self._spawn("page", self.page_version, self._page_seen)

    def _repair_blocked(self) -> bool:
        """Sinko was removed on purpose, or something is installing (the installer, an update, a rollback, a repair): the
        two versions are then expected, and the ten minutes begin only when the box is quiet again."""
        return os.path.exists(state_path("removed")) or install_lock_held() or self._update_going()

    def _page_seen(self, outcome, epoch) -> None:
        status, shown = outcome
        if status == "error":
            self._complain("version of the page", shown)
            return
        now = self.mono()
        if shown == VERSION:
            self._mismatch_since = None
            return
        if self._mismatch_since is None:
            self._mismatch_since = now
            return
        if (now - self._mismatch_since < self.REPAIR_AFTER or not self.clock_ok() or self._repair_blocked()
                or read_version_file(os.path.join(APP_DIR, "src")) != VERSION or not repair_due(epoch)):
            return
        log.warning("the page (%s) and the program (%s) have been of different versions for %d minutes (an update was "
                    "probably cut short): installing this version again from the copy on the box (at most once an hour)",
                    short_text(shown or "no version", 20), VERSION, (now - self._mismatch_since) // 60)
        note_repair(epoch)
        self._mismatch_since = None
        self._actions.append("page and program differ: repairing")
        if not self._spawn("repair", self.start_repair, self._repair_started):
            self._repair_started(("ok", False), epoch)

    def _repair_started(self, outcome, epoch) -> None:
        status, value = outcome
        if status == "error":
            self._complain("repair", value)
        elif not value:
            self._complain("repair", "it could not be started")

    def _update_going(self) -> bool:
        """An update is being installed (the installer sets everything up itself, and may be in the middle of it)."""
        try:
            running = self._cur()["update"]["status"] == "running"
        except LookupError:
            running = False
        return running or RunLock.is_held()

    def _gate_allows(self, key: str) -> bool:
        now = self.mono()
        last = self._last_logged.get(key)
        if last is None or now - last >= self.COMPLAIN_EVERY:
            self._last_logged[key] = now
            return True
        return False

    def _heal_done(self, outcome, epoch) -> None:
        if outcome[0] == "error":
            self._complain("self-repair", outcome[1])                          # tried again after the hour
        elif self._gate_allows("heal-done"):
            log.info("Sinko is set up in Pi-hole again")

    def _ping_done(self, outcome, epoch) -> None:
        status, value = outcome
        if status == "error":
            self._complain("anonymous counter", value)
            self._next_ping = self.mono() + self.PING_RETRY
            return
        if value is None:
            return                                              # an answer with numbers that make no sense: show none

        def store(state):
            if state["telemetry"]["on"] is True:                # not if the parent switched it off while the ping was away
                state["community"] = {"online": value["online"], "at": epoch}
        self._change(store)


# --------------------------------------------------------------------------- #
# Commands
# --------------------------------------------------------------------------- #
def seed_telemetry_answer(api: Api, conf: dict) -> bool:
    """The installer asked whether the anonymous counter may run (or was told) and recorded the answer as
    SINKO_TELEMETRY in the settings. The answer itself lives in the shared state, so copy it there, but only while the
    state has none: whatever the parent has since answered on the page wins."""
    value = (conf.get("SINKO_TELEMETRY") or "").strip().lower()
    answer = True if value in ("1", "true", "yes", "on") else False if value in ("0", "false", "no", "off") else None
    if answer is None:
        return False                       # not decided at install time: the page asks later

    def seed(state):
        if state["telemetry"]["on"] is None:
            state["telemetry"]["on"] = answer
    return patch_state(api, seed)


def removed_flag() -> str:
    return state_path("removed")


def cmd_setup(args) -> int:
    api = Api()
    api.wait_ready()
    api.login()
    try:
        try:
            os.unlink(removed_flag())              # setting up again: the scheduler may repair what goes missing
        except OSError:
            pass
        ctl = Controller(api, load_catalog())
        ctl.setup(run_gravity=False)
        ctl.readd_legacy_devices()
        seed_telemetry_answer(api, read_config())
        try:
            ensure_state_dir("cache")
        except OSError as err:
            log.warning("cannot create %s: %s (updates will not work until it exists)", state_dir(), err)
        if not args.no_gravity:
            ctl.gravity()
    finally:
        api.logout()
    print("sinko: Pi-hole objects are up to date")
    return 0


def cmd_telemetry(args) -> int:
    """`sinko telemetry on|off|status|payload|reset-id`. The answer lives in the shared state (the page shows and
    sets the same one); nothing here ever prints the id except `payload`, which shows what would be sent."""
    if args.action == "payload":
        print(telemetry_body())
        return 0
    conf = read_config()
    if args.action == "reset-id":
        return reset_counter_id(telemetry_url(conf))
    try:
        api = Api()
        api.login()
    except TRANSPORT_ERRORS as err:
        print("sinko: Pi-hole could not be reached (%s)" % short_text(err, 80), file=sys.stderr)
        return 2
    try:
        groups = api.group_map()
        if G_STATE not in groups:
            print("sinko: Sinko is not set up in Pi-hole yet. Run: sudo sinko setup", file=sys.stderr)
            return 1
        if args.action in ("on", "off"):
            answer = args.action == "on"

            def record(state):
                state["telemetry"]["on"] = answer
                if not answer:
                    state["community"] = None             # an old number must not outlive the "no"
            patch_state(api, record)
        state = parse_state(api.group_map()[G_STATE].get("comment"))
    except TRANSPORT_ERRORS as err:
        print("sinko: Pi-hole could not be read or written (%s)" % short_text(err, 80), file=sys.stderr)
        return 2
    finally:
        drop_session(api)
    on = state["telemetry"]["on"]
    configured = bool(telemetry_url(conf))
    print("Anonymous counter: %s" % ("on" if on else "off" if on is False else "not decided yet"))
    if on and not configured:
        print("No counter address is set up on this box, so nothing is sent.")
    elif on:
        print("It sends the data shown by: sudo sinko telemetry payload (every 6 hours or so). Switch off: sudo sinko telemetry off")
    elif on is False:
        print("Nothing is sent.")
    else:
        print("Nothing is sent until it is switched on: sudo sinko telemetry on")
    if on is False and args.action == "off":
        # Switching off also makes the counter forget this box (the scheduler would do it a moment later; here the
        # person at the keyboard sees how it went).
        what, detail = forget_counter_id(telemetry_url(conf))
        print(forget_report(what, detail))
    if state["community"] and on is not False:
        print("Boxes online at the last answer: %d" % state["community"]["online"])
    return 0


def cmd_learn(args) -> int:
    """`sinko learn on|off|status|list|forget NAME`. The switch lives in the shared state (`learn.on`), where the page
    will show it too; what was learned lives in Pi-hole, as rules of the apps' own groups (see Learner)."""
    name = (args.name or "").strip().lower().rstrip(".")
    if args.action == "forget" and not (name and len(name) <= 253 and HOST_RE.match(name)):
        print("sinko: say which learned address to allow again, e.g.: sudo sinko learn forget example.com", file=sys.stderr)
        return 1
    try:
        api = Api()
        api.login()
    except TRANSPORT_ERRORS as err:
        print("sinko: Pi-hole could not be reached (%s)" % short_text(err, 80), file=sys.stderr)
        return 2
    taken = []
    try:
        groups = api.group_map()
        if G_STATE not in groups:
            print("sinko: Sinko is not set up in Pi-hole yet. Run: sudo sinko setup", file=sys.stderr)
            return 1
        if args.action in ("on", "off"):
            want = args.action == "on"
            patch_state(api, lambda state: state.update(learn={"on": want}))
        if args.action == "forget":
            for rule in learned_rules(api.domains()):
                if not rule["back"] and under(name, rule["zone"]):
                    take_back_rule(api, rule)
                    taken.append(rule)
        state = parse_state(api.group_map()[G_STATE].get("comment"))
        rules = learned_rules(api.domains())
    except TRANSPORT_ERRORS as err:
        print("sinko: Pi-hole could not be read or written (%s)" % short_text(err, 80), file=sys.stderr)
        return 2
    finally:
        drop_session(api)
    if args.action == "forget":
        if not taken:
            print("sinko: no learned address covers %s (see: sudo sinko learn list)" % name, file=sys.stderr)
            return 1
        for rule in taken:
            print("Allowed again: %s (%s). It will not be learned again." % (rule["zone"], rule["app"]))
        return 0
    if args.action == "list":
        if not rules:
            print("Nothing was learned yet.")
        for rule in sorted(rules, key=lambda r: (r["app"], r["day"], r["zone"])):
            print("%-16s %-10s %s%s" % (rule["app"], rule["day"], rule["zone"], "   (allowed again)" if rule["back"] else ""))
        return 0
    on = state["learn"]["on"]
    print("Learning new addresses of blocked apps: %s" % ("on" if on else "off"))
    try:
        print("The model on this box knows %d apps (%s)." % (len(load_model().apps), MODEL_FILE))
    except (OSError, ValueError) as err:
        print("The model cannot be read, so nothing is learned: %s" % short_text(err, 120))
    learned = [r for r in rules if not r["back"]]
    today = time.strftime("%Y-%m-%d")
    print("Learned: %d address%s (%d today), %d allowed again. At most %d a day for each app and %d in all."
          % (len(learned), "" if len(learned) == 1 else "es", sum(1 for r in learned if r["day"] == today),
             len(rules) - len(learned), Learner.PER_APP_DAY, Learner.MAX_RULES))
    print("See them: sudo sinko learn list. " + ("Switch off: sudo sinko learn off" if on else "Switch on: sudo sinko learn on"))
    return 0


def forget_report(what: str, detail: str) -> str:
    return {"none": "This box's number never left the box; it was deleted.",
            "forgotten": "The counter was asked to forget this box's number, and did. It is deleted here too.",
            "pending": "The counter could not be reached (%s). This box keeps trying and sends nothing else until it has "
                       "been forgotten there." % detail,
            "no-address": "No counter address is set up on this box, so the counter could not be asked to forget its "
                          "number; it forgets numbers by itself after about half a year. Nothing is sent."}[what]


def reset_counter_id(url: str) -> int:
    """`sinko telemetry reset-id`: the counter forgets the old id (when it ever got it), then a new random one is made."""
    what, detail = forget_counter_id(url)
    if what == "pending":
        print("sinko: the counter could not be reached (%s), so the old id was not replaced. It is kept, and forgotten "
              "as soon as the counter answers; nothing else is sent until then." % detail, file=sys.stderr)
        return 1
    if what == "no-address":
        drop_install_id()                          # nobody can be asked, and nothing can be sent without an address
    reset_install_id()
    print("sinko: a new random id was made, and the old one is forgotten%s. Nothing was sent with it."
          % (" here (no counter address is set up, so the counter itself was not asked)" if what == "no-address" else
             " by the counter" if what == "forgotten" else ""))
    return 0


def drop_session(api) -> None:
    """Give a Pi-hole API session back before it is forgotten. FTL has a small, fixed number of seats
    (webserver.api.max_sessions, 16) and a session that is dropped without a logout keeps one for half an hour: a
    scheduler that fails every few seconds would lock the parent out of the page. Never raises."""
    if api is None:
        return
    try:
        api.logout()
    except Exception:
        pass


class CatalogError(Exception):
    """The service catalog (services.json and the list files) cannot be read."""


def load_catalog_safely():
    """load_catalog() for a long-running process: its SystemExit (a command line tool's way to stop) becomes an
    exception that the scheduler can survive."""
    try:
        return load_catalog()
    except SystemExit as err:
        raise CatalogError(str(err.code))
    except (OSError, ValueError, KeyError, TypeError) as err:
        raise CatalogError("%s: %s" % (type(err).__name__, short_text(err, 100)))


def _list_file_problem(path: str, is_catalog: bool) -> bool:
    """True when the file is missing, empty, or (services.json) not JSON: what a write that a power cut interrupted
    can leave behind."""
    try:
        if os.stat(path).st_size == 0:
            return True
        if is_catalog:
            with open(path, encoding="utf-8") as fh:
                json.load(fh)
    except (OSError, ValueError):
        return True
    return False


def repair_catalog_files() -> list:
    """Put back the service lists (and services.json) that cannot be read, from a copy of this very version that is
    known to be whole: the source tree the installer ran from, else the verified copy kept for rollback. Only files
    that cannot be read are written (each atomically); everything else is left exactly as it is. Returns the names
    written, [] when there was nothing to do or nothing to do it from."""
    lists_dir = os.path.join(APP_DIR, "lists")

    def restore_from(folder):
        """The names written from `folder`, or None when that copy is not whole itself (then it is no help)."""
        try:
            names = ["services.json"] + [s["id"] + ".txt" for s in load_catalog(folder)["services"]] + ["guard.txt"]
        except (SystemExit, OSError, ValueError, KeyError, TypeError):
            return None
        written = []
        for name in dict.fromkeys(names):
            target = os.path.join(lists_dir, name)
            if _list_file_problem(target, name == "services.json"):
                with open(os.path.join(folder, name), "rb") as fh:
                    atomic_write(target, fh.read(), 0o644)
                written.append(name)
        return written
    try:
        src = os.path.join(APP_DIR, "src")
        if read_version_file(src) == VERSION:
            done = restore_from(os.path.join(src, "lists"))
            if done is not None:
                return done
        cached = cache_file(VERSION)
        if not os.path.isfile(cached):
            return []
        os.makedirs(APP_DIR, exist_ok=True)
        scrap = tempfile.mkdtemp(dir=APP_DIR, prefix=".stage-")
        try:
            if unpack_release(cached, scrap) != VERSION:
                return []
            return restore_from(os.path.join(scrap, "sinko", "lists")) or []
        except UpdateError:
            return []
        finally:
            shutil.rmtree(scrap, ignore_errors=True)
    except OSError as err:
        log.debug("could not repair the lists: %s", err)
        return []


class Scheduler:
    """The loop of `sinko run`. One `step()` is one pass; it never raises an Exception whatever Pi-hole answered and
    whatever is in the shared state, and it gives every Pi-hole session back.

    A pass that fails is retried after 5, 10, 20 ... 120 seconds, and a failure is logged when it is new and then at
    most every 30 minutes. While passes fail because of a bug (not because Pi-hole is down) the side jobs still run:
    "Update now" is the way a fixed release reaches a box whose scheduler fails, and a parent can still restart it.
    """
    MAX_BACKOFF = 120

    REPAIR_EVERY = 3600

    def __init__(self, clock=None, maintenance=None, gate=None, repair=None, monotonic=time.monotonic):
        self.clock = clock or ClockGuard()
        self.maintenance = maintenance if maintenance is not None else Maintenance(
            clock_ok=self.clock.trusted, page_version=PageWatch().version, start_repair=start_repair_runner, ledger=Ledger())
        self.gate = gate or LogGate()
        self.repair = repair or repair_catalog_files
        self.mono = monotonic
        self.api = None
        self.catalog = None
        self.backoff = 5
        self.ticks = 0
        self._next_repair = 0.0

    def _load_catalog(self):
        """The service catalog; when it cannot be read, put back the files that cannot (from a whole copy of this
        version), at most once an hour, and try again."""
        try:
            return load_catalog_safely()
        except CatalogError:
            if self.mono() < self._next_repair:
                raise
            self._next_repair = self.mono() + self.REPAIR_EVERY
            try:
                fixed = self.repair()
            except Exception as err:                        # a repair that fails is no worse than none
                log.debug("could not repair the lists: %s", err)
                fixed = []
            if not fixed:
                raise
            log.warning("scheduler: put back %s, which could not be read (an update was probably cut short)",
                        ", ".join(fixed[:4]) + (" and more" if len(fixed) > 4 else ""))
            return load_catalog_safely()

    def step(self) -> float:
        """One pass. Returns the number of seconds to wait before the next."""
        ok = False
        try:
            if self.api is None:
                self.api = Api()
                self.api.login()
            if self.catalog is None:
                self.catalog = self._load_catalog()
            Controller(self.api, self.catalog, clock_trusted=self.clock.trusted).tick()
            ok = True
        except Exception as err:
            self._failed(err)
        if ok:
            self.ticks += 1
            self._pulse()
            self.backoff = 5
            wait = TICK_SECONDS
        else:
            wait = self.backoff
            self.backoff = min(self.backoff * 2, self.MAX_BACKOFF)
        self._side_jobs(ok)
        return wait

    def _side_jobs(self, tick_ok: bool) -> None:
        """Update requests, power requests, the update check, address watch, counter, box.json. Not while Pi-hole does
        not answer (they all need it), but yes while the pass fails for another reason."""
        if self.api is None:
            return
        try:
            self.maintenance.api = self.api
            self.maintenance.tick_ok = tick_ok
            self.maintenance.run(dt.datetime.now())          # never raises; a failing job is logged and skipped
        except Exception as err:
            self._complain("side jobs", err)
        if not tick_ok:
            drop_session(self.api)
            self.api = None

    def _failed(self, err) -> None:
        transport = isinstance(err, TRANSPORT_ERRORS)
        if self.gate.allow((type(err).__name__, short_text(err, 80))):
            log.warning("scheduler: %s: %s (retrying in %ss; the same message is shown at most every 30 minutes)",
                        type(err).__name__, short_text(err, 160), self.backoff, exc_info=None if transport else err)
        if transport:
            drop_session(self.api)                       # FTL restarting, a rotated cli_pw, a hiccup: start afresh
            self.api = None

    def _pulse(self) -> None:
        try:
            write_heartbeat(self.ticks)
        except OSError as err:
            self._complain("heartbeat", err)

    def _complain(self, what: str, err) -> None:
        if self.gate.allow((what, type(err).__name__)):
            log.warning("scheduler: %s: %s (shown at most every 30 minutes)", what, short_text(err, 160))

    def close(self) -> None:
        close = getattr(self.maintenance, "close", None)
        if close is not None:
            close()                                       # what the savings ledger counted since its last save
        drop_session(self.api)
        self.api = None


def cmd_run(args) -> int:
    stop = {"flag": False}

    def _stop(*_):
        stop["flag"] = True
    signal.signal(signal.SIGTERM, _stop)
    signal.signal(signal.SIGINT, _stop)

    try:
        ensure_state_dir("cache")
    except OSError as err:
        log.error("cannot create %s: %s (updates and requests from the page will not work)", state_dir(), err)
    scheduler = Scheduler()
    log.info("scheduler %s started", VERSION)
    try:
        while not stop["flag"]:
            wait = scheduler.step()
            for _ in range(int(wait)):
                if stop["flag"]:
                    break
                time.sleep(1)
    finally:
        scheduler.close()
    log.info("scheduler stopped")
    return 0


def kid_rows(groups: dict, clients: list) -> list:
    kid_id = groups.get(G_KIDS, {}).get("id")
    return [c for c in clients if kid_id in c.get("groups", [])]


def kid_shadows(kid: dict, groups: dict, catalog: dict, clients: list, devices: list) -> list:
    paused_id = groups.get(G_PAUSED, {}).get("id")
    needed = needed_pb_groups(groups, catalog, paused_id in kid.get("groups", []))
    return shadowing_rows(kid, devices, clients, needed)


def build_status(api: Api, catalog: dict) -> dict:
    ctl = Controller(api, catalog)
    state, blocked, offline, groups = ctl.read_state()
    paused_id = groups.get(G_PAUSED, {}).get("id")
    clients = api.clients()
    devices = api.network_devices()
    return {
        "version": VERSION,
        "internet_off": offline,
        "blocked": sorted(k for k, v in blocked.items() if v),
        "devices": [{"client": c["client"], "name": c.get("comment") or "",
                     "paused": paused_id in c.get("groups", []),
                     # IP/subnet rows FTL uses instead of this device's row (empty = filtered as intended)
                     "shadowed_by": [{"client": r["client"], "groups": group_names(r["groups"], groups)}
                                     for r in kid_shadows(c, groups, catalog, clients, devices)]}
                    for c in kid_rows(groups, clients)],
        "timer": state["timer"],
        "schedule": state["schedule"],
        "bedtime_now": state["scheduleActive"],
        # What the scheduler knows about updates. The page's request markers are not part of the picture.
        "update": {k: v for k, v in state["update"].items() if k not in ("request", "checkRequest")},
        # The parent's answer (null = not asked yet). Never the counter's id: that is shown by `telemetry payload` only.
        "telemetry": {"on": state["telemetry"]["on"]},
    }


def cmd_status(args) -> int:
    api = Api()
    api.login()
    try:
        out = build_status(api, load_catalog())
    finally:
        api.logout()
    print(json.dumps(out, indent=2, ensure_ascii=False))
    return 0


class Report:
    """The lines `doctor` prints. Only FIX makes the command fail; WARN and info are advice."""

    def __init__(self, out=print):
        self.out = out
        self.fixes = []
        self.warnings = []

    def _emit(self, tag: str, msg: str) -> None:
        self.out("  " + tag.ljust(6) + msg)

    def ok(self, msg: str) -> None:
        self._emit("ok", msg)

    def info(self, msg: str) -> None:
        self._emit("info", msg)

    def warn(self, msg: str) -> None:
        self.warnings.append(msg)
        self._emit("WARN", msg)

    def fix(self, msg: str) -> None:
        self.fixes.append(msg)
        self._emit("FIX", msg)

    def check(self, cond: bool, msg: str) -> None:
        (self.ok if cond else self.fix)(msg)

    def finish(self) -> int:
        if self.fixes:
            self.out("\n%d problem(s) found." % len(self.fixes))
        elif self.warnings:
            self.out("\nNo problems, but %d warning(s) above." % len(self.warnings))
        else:
            self.out("\nAll good.")
        return 1 if self.fixes else 0


def identity_warning(rep: Report, label: str, kid: dict, dev, groups: dict, clients: list) -> None:
    """A child registered by IP address is only filtered while it keeps that address."""
    ip = parse_ip(kid["client"])
    if ip is None:
        return
    mac = dev.get("hwaddr") if dev and is_mac(dev.get("hwaddr")) else None
    notes = []
    if ip.version == 6:
        notes.append("an IPv6 address; phones rotate their IPv6 privacy addresses, which silently ends the filtering")
    if mac:
        kid_id = groups.get(G_KIDS, {}).get("id")
        loose = []
        for other in device_ips(dev):
            o = parse_ip(other)
            if o is None or o == ip or o.is_link_local:
                continue
            row = winning_row(o, clients)
            if row is None or kid_id not in row.get("groups", []):
                loose.append(other)
        notes.append("its MAC address %s is known now, so it can be added by MAC (sudo sinko use-mac %s)"
                     % (mac, kid["client"]))
        if loose:
            notes.append("it also uses %s, which no rule covers" % ", ".join(loose))
    elif ip.version == 4:
        return                                         # nothing better is known yet
    rep.warn("%s is registered by its address: %s." % (label, "; ".join(notes)))


SILENT_HINT = ("Check that its Wi-Fi really uses this box for DNS: a Private Wi-Fi address, Private DNS, "
               "a VPN or mobile data can bypass it.")


def kid_checks(rep: Report, catalog: dict, groups: dict, clients: list, devices: list, now: float) -> None:
    """Checks on the children's devices: is each one really filtered, and does it reach the box?"""
    kids = kid_rows(groups, clients)
    rep.info("%d child device(s) added" % len(kids))
    for kid in kids:
        label = "%s (%s)" % (kid.get("comment") or kid["client"], kid["client"])
        for row in kid_shadows(kid, groups, catalog, clients, devices):
            rep.fix("%s is not filtered: Pi-hole applies the client row %s (groups: %s) to %s instead. "
                    "Remove that row in the Pi-hole admin under Clients, or give it the pb groups if it is only this device."
                    % (label, row["client"], ", ".join(group_names(row["groups"], groups)), row["ip"]))
        if not (is_mac(kid["client"]) or parse_ip(kid["client"]) is not None):
            continue                                  # a subnet or host name row: no device to look up
        dev = find_device(devices, kid["client"])
        identity_warning(rep, label, kid, dev, groups, clients)
        if dev is None:
            rep.warn("%s has not been seen on the network yet. %s" % (label, SILENT_HINT))
        elif (dev.get("lastQuery") or 0) < now - 24 * 3600:
            rep.warn("%s has sent no DNS query to this box in the last 24 hours. %s" % (label, SILENT_HINT))


# --------------------------------------------------------------------------- #
# What `doctor` learns from the machine itself (tests substitute their own probe)
# --------------------------------------------------------------------------- #
class SystemProbe:
    """Reads the routing table, IPv6 state and Pi-hole's log. Paths can be overridden with SINKO_* variables."""

    def free_disk_bytes(self):
        """Free space on the box's disk (the root file system, where /opt and /var/lib are), or None."""
        try:
            return shutil.disk_usage(os.environ.get("SINKO_DISK_PATH", "/")).free
        except OSError:
            return None

    def cpu_temp_c(self):
        """CPU temperature in degrees Celsius from the first thermal zone, or None (a PC, a VM, no sensor)."""
        try:
            with open(os.environ.get("SINKO_THERMAL_FILE", "/sys/class/thermal/thermal_zone0/temp"), encoding="ascii") as fh:
                raw = float(fh.read().strip())
        except (OSError, ValueError):
            return None
        temp = raw / 1000.0 if abs(raw) > 1000 else raw                  # the kernel reports millidegrees
        return temp if -50 <= temp <= 200 else None

    def clock_synchronized(self):
        return ntp_synchronized(timeout=5)             # someone is waiting for the doctor anyway; a slow answer is not "no"

    @staticmethod
    def _lines(env: str, default: str) -> list:
        try:
            with open(os.environ.get(env, default), encoding="utf-8", errors="replace") as fh:
                return fh.read().splitlines()
        except OSError:
            return []

    def default_gateway(self):
        """IPv4 address of the default gateway (usually the router), or None."""
        best = None
        for line in self._lines("SINKO_ROUTE_FILE", "/proc/net/route")[1:]:
            f = line.split()
            if len(f) < 8 or f[1] != "00000000" or not int(f[3], 16) & 0x2:      # default route via a gateway
                continue
            metric = int(f[6])
            if best is None or metric < best[0]:
                best = (metric, socket.inet_ntoa(struct.pack("<L", int(f[2], 16))))
        return best[1] if best else None

    def ipv6_addresses(self) -> list:
        """(address, scope) of this box's IPv6 addresses; scope 0 means global."""
        out = []
        for line in self._lines("SINKO_IF_INET6_FILE", "/proc/net/if_inet6"):
            f = line.split()
            if len(f) >= 6:
                out.append((str(ipaddress.IPv6Address(int(f[0], 16))), int(f[3], 16)))
        return out

    def ipv6_default_route(self) -> bool:
        for line in self._lines("SINKO_IPV6_ROUTE_FILE", "/proc/net/ipv6_route"):
            f = line.split()
            if len(f) >= 10 and f[0] == "0" * 32 and f[1] == "00" and f[9] != "lo":
                flags = int(f[8], 16)
                if flags & 0x1 and not flags & 0x200:                              # up, not a reject route
                    return True
        return False

    def own_addresses(self) -> set:
        own = {"127.0.0.1", "::1"} | {a for a, _ in self.ipv6_addresses()}
        if read_config().get("SINKO_IP"):
            own.add(read_config()["SINKO_IP"])
        return own

    def ftl_log_tail(self, nbytes: int = 512 * 1024) -> str:
        path = os.environ.get("SINKO_FTL_LOG")
        if not path:
            try:
                path = ftl_config("files.log.ftl")
            except (OSError, subprocess.SubprocessError):
                path = "/var/log/pihole/FTL.log"
        try:
            with open(path, "rb") as fh:
                fh.seek(0, os.SEEK_END)
                fh.seek(max(0, fh.tell() - nbytes))
                return fh.read().decode("utf-8", errors="replace")
        except OSError:
            return ""


RELAY_MIN_QUERIES = 30            # fewer LAN queries than this in an hour: too little data to judge
FTL_LOG_TIME = re.compile(r"^(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d)")


def recent_client_counts(history: dict, now: float, seconds: int = 3600) -> dict:
    """Queries per client address in the last `seconds`, from /api/history/clients (10-minute slots)."""
    counts = {}
    for slot in history.get("history") or []:
        if (slot.get("timestamp") or 0) < now - seconds:
            continue
        for ip, n in (slot.get("data") or {}).items():
            if ip != "others":
                counts[ip] = counts.get(ip, 0) + int(n)
    return counts


def rate_limited_hosts(log_text: str, now: float, seconds: int = 24 * 3600) -> set:
    """Addresses FTL.log says it rate-limited recently ('Rate-limiting 10.0.1.39 for at least 44 seconds')."""
    hosts = set()
    for line in log_text.splitlines():
        m = re.search(r"[Rr]ate-limiting (\S+) (?:for at least|as it made)", line)
        if not m:
            continue
        stamp = FTL_LOG_TIME.match(line)
        if stamp:
            try:
                if time.mktime(time.strptime(stamp.group(1), "%Y-%m-%d %H:%M:%S")) < now - seconds:
                    continue
            except (ValueError, OverflowError):
                pass
        hosts.add(m.group(1))
    return hosts


def network_checks(rep: Report, api: Api, probe, now: float) -> None:
    """Things that leave the box looking healthy while nothing is filtered: DNS that never reaches it."""
    gateway = probe.default_gateway()
    if gateway:
        try:
            history = api.request("GET", "/api/history/clients?N=0")
        except ApiError as err:
            history = None
            rep.info("per-client query counts not available (%s); cannot tell if the router relays DNS" % err)
        if history is not None and not history.get("history"):
            rep.info("per-client query counts are hidden (Pi-hole privacy level); cannot tell if the router relays DNS")
        elif history is not None:
            own = probe.own_addresses()
            lan = {ip: n for ip, n in recent_client_counts(history, now).items() if ip not in own}
            total, from_router = sum(lan.values()), lan.get(gateway, 0)
            if total < RELAY_MIN_QUERIES:
                rep.info("only %d DNS queries from the network in the last hour: too few to tell if the router relays DNS" % total)
            elif from_router * 2 > total:
                rep.fix("the router (%s) sent %d of %d DNS queries in the last hour: it is relaying DNS for the whole "
                        "network, so per-child rules cannot match. Make the router give out this box as the DHCP DNS "
                        "server, not its own or its WAN DNS." % (gateway, from_router, total))
            else:
                rep.ok("DNS queries come from the devices themselves (%d of %d from the router)" % (from_router, total))
        if gateway in rate_limited_hosts(probe.ftl_log_tail(), now):
            rep.warn("Pi-hole rate-limited the router (%s) recently: a strong sign that the router relays DNS for all "
                     "devices (see the Pi-hole log %s)." % (gateway, "FTL.log"))
    if any(scope == 0 for _, scope in probe.ipv6_addresses()) or probe.ipv6_default_route():
        rep.warn("this network uses IPv6. If the router hands out its own IPv6 DNS server, devices can skip the filter: "
                 "turn that off in the router (see the README).")
    blocking_check(rep, api)


def ftl_try(key: str):
    """(value, error) for a Pi-hole setting; the error is None when it could be read."""
    try:
        return ftl_config(key), None
    except (OSError, subprocess.SubprocessError) as err:
        return None, err


def blocking_check(rep: Report, api: Api) -> None:
    """Pi-hole's global blocking switch (pihole disable) turns every rule off."""
    state = None
    try:
        state = api.request("GET", "/api/dns/blocking").get("blocking")
    except ApiError:
        pass
    configured, _ = ftl_try("dns.blocking.active")
    if state == "disabled" or configured == "false":
        rep.fix("Pi-hole blocking is switched off, so nothing is filtered. Turn it on with: sudo pihole enable")
    elif state == "failure":
        rep.fix("Pi-hole's DNS service reports a failure. Check: sudo systemctl status pihole-FTL")
    elif state == "enabled" or configured == "true":
        rep.ok("Pi-hole blocking is on")


def mac_names_check(rep: Report) -> None:
    """FTL only looks at a device's MAC row when resolver.macNames is on (FTL get_client_groupids())."""
    value, err = ftl_try("resolver.macNames")
    if err is not None:
        if not isinstance(err, FileNotFoundError):
            rep.info("resolver.macNames is not available in this Pi-hole version")
    elif value == "true":
        rep.ok("resolver.macNames is true (rules for devices added by MAC can match)")
    else:
        rep.fix("resolver.macNames is %s: Pi-hole then ignores MAC-based client rules, so children added by MAC are not "
                "filtered. Fix: sudo pihole-FTL --config resolver.macNames true" % (value or "off"))


def block_all_check(rep: Report, groups: dict, domains: list) -> None:
    """The rule behind 'internet off' and 'pause': a deny rule for "^.*$" that applies to pb-offline and pb-paused."""
    rule = next((d for d in domains if d.get("kind") == "regex" and d.get("type") == "deny"
                 and d.get("domain") == BLOCK_ALL_REGEX), None)
    ours = {groups[n]["id"] for n in (G_OFFLINE, G_PAUSED) if n in groups}
    if rule is None:
        rep.fix("the rule that blocks everything for 'internet off' and 'pause' is missing (run: sudo sinko setup)")
    elif not rule.get("enabled"):
        rep.fix("the %s rule is switched off, so 'internet off' and 'pause' block nothing. %s" % (
            BLOCK_ALL_REGEX, "It is your own: switch it on in the Pi-hole admin under Domains." if not block_all_is_ours(rule)
            else "Run: sudo sinko setup"))
    elif not ours <= set(rule.get("groups", [])):
        rep.fix("the %s rule does not apply to Sinko's groups, so 'internet off' and 'pause' block nothing "
                "(run: sudo sinko setup)" % BLOCK_ALL_REGEX)
    elif block_all_is_ours(rule):
        rep.ok("the rule behind 'internet off' and 'pause' is in place")
    else:
        rep.info("your own %s rule also serves 'internet off' and 'pause': domains it allows are still reachable then"
                 % BLOCK_ALL_REGEX)


def doctor_api_checks(rep: Report, api: Api, catalog: dict, probe=None, now: float | None = None) -> None:
    """Everything `doctor` learns from the Pi-hole API (needs a logged-in `api`)."""
    probe = probe or SystemProbe()
    now = time.time() if now is None else now
    groups = api.group_map()
    missing = [n for n in [G_KIDS, G_GUARD, G_OFFLINE, G_PAUSED, G_STATE]
               + [svc_group(s["id"]) for s in catalog["services"]] if n not in groups]
    rep.check(not missing, "all groups present" + (" (missing: %s)" % ", ".join(missing) if missing else ""))
    wanted = {LIST_COMMENT_PREFIX + i for i in [s["id"] for s in catalog["services"]] + ["guard"]}
    lists = [l for l in api.lists() if l.get("comment") in wanted]       # (a blocked service of a newer release keeps its list)
    empty = [l["comment"] for l in lists if not l.get("number")]
    rep.check(len(lists) == len(wanted), "%d service lists registered" % len(lists))
    rep.check(not empty, "all lists compiled into gravity" +
              (" (empty: %s — run 'pihole -g')" % ", ".join(empty) if empty else ""))
    block_all_check(rep, groups, api.domains())
    kid_checks(rep, catalog, groups, api.clients(), api.network_devices(), now)
    mac_names_check(rep)
    network_checks(rep, api, probe, now)


DISK_WARN_BYTES = 300 * 1024 * 1024
TEMP_WARN_C = 80.0


def health_checks(rep: Report, state, probe=None) -> None:
    """What a box needs besides working rules: the version it runs and whether an update waits, room on the disk, a
    CPU that is not too hot, a clock that is right, and the state of the anonymous counter. `state` is None when
    Pi-hole could not be asked; the lines that need it are then left out."""
    probe = probe or SystemProbe()
    rep.info("running version %s" % VERSION)
    if state is not None:
        update = state["update"]
        if update["latest"] and is_newer(update["latest"], VERSION):
            rep.info("update available: %s (install it with: sudo sinko update)" % update["latest"])
        if update["status"] == "failed" and update["error"]:
            rep.info("the last update did not work: %s" % update["error"])
    free = probe.free_disk_bytes()
    if free is not None:
        if free < DISK_WARN_BYTES:
            rep.warn("only %d MB of disk space is free. Updates and the Pi-hole database need room: delete what is not "
                     "needed, or use a larger card." % (free // (1024 * 1024)))
        else:
            rep.ok("%d MB of disk space free" % (free // (1024 * 1024)))
    temp = probe.cpu_temp_c()
    if temp is not None:
        if temp > TEMP_WARN_C:
            rep.warn("the CPU is at %.0f C (above %.0f C). Give the box air, and keep it out of the sun and away from heaters."
                     % (temp, TEMP_WARN_C))
        else:
            rep.ok("CPU temperature is %.0f C" % temp)
    synced = probe.clock_synchronized()
    if synced is False:
        rep.warn("the clock is not synchronised with a time server. Bedtime and timers follow the box's time, which can be "
                 "wrong until it is: check that the box can reach the internet.")
    elif synced is True:
        rep.ok("the clock is synchronised")
    if state is not None:
        on = state["telemetry"]["on"]
        rep.info("anonymous counter: %s%s" % ("on" if on else "off" if on is False else "not decided yet",
                 " (no counter address is set up, so nothing is sent)" if on and not telemetry_url() else ""))


def cmd_doctor(args) -> int:
    rep = Report()
    try:
        rep.check(subprocess.run(["systemctl", "is-active", "--quiet", "pihole-FTL"]).returncode == 0,
                  "pihole-FTL service is running")
    except OSError:
        pass
    # "is-active" alone is true for the second before each crash of a scheduler that restarts over and over.
    sched_state, sched_text = scheduler_status()
    rep.check(sched_state in ("ok", "starting"), "sinko scheduler: " + sched_text)
    try:
        rep.check(ftl_config("webserver.serve_all") == "true", "webserver.serve_all is true")
        rep.check(ftl_config("webserver.api.cli_pw") == "true", "webserver.api.cli_pw is true")
        webroot_path = ftl_config("webserver.paths.webroot")
        problems = page_file_problems(webroot_path)
        rep.check(not problems, "web page installed in %s%s" % (
            webroot_path, " (missing: %s)" % ", ".join(problems[:3]) if problems else ""))
    except (OSError, subprocess.SubprocessError) as err:
        rep.fix("pihole-FTL CLI available (%s)" % err)
    state = None
    api = None
    try:
        api = Api()
        api.login()
        doctor_api_checks(rep, api, load_catalog())
        state = parse_state(api.group_map().get(G_STATE, {}).get("comment"))
        base = lists_base()
        if base.startswith("http"):
            try:
                with urllib.request.urlopen(base + "/guard.txt", timeout=15) as resp:
                    rep.check(resp.status == 200, "list server reachable (%s)" % base)
            except (OSError, urllib.error.URLError) as err:
                rep.fix("list server reachable (%s: %s)" % (base, err))
    except TRANSPORT_ERRORS as err:
        rep.fix("Pi-hole API reachable (%s)" % short_text(err, 100))
    finally:
        drop_session(api)
    health_checks(rep, state)
    return rep.finish()


# --------------------------------------------------------------------------- #
# Diagnostics: `diagnose` (a read-only report) and `watch` (follow the DNS log)
# --------------------------------------------------------------------------- #
GRAVITY_DB = "/etc/pihole/gravity.db"
FTL_DB = "/etc/pihole/pihole-FTL.db"
DNSMASQ_LOG = "/var/log/pihole/pihole.log"
DEFAULT_DIAGNOSE_SERVICES = ("youtube", "instagram")

# FTL's query status codes (enum query_status in FTL's enums.h).
QUERY_STATUS = {0: "unknown", 1: "blocked (gravity)", 2: "forwarded", 3: "cached", 4: "blocked (regex)",
                5: "blocked (denylist)", 6: "blocked upstream (IP)", 7: "blocked upstream (NULL)",
                8: "blocked upstream (NXRA)", 9: "blocked (gravity, CNAME)", 10: "blocked (regex, CNAME)",
                11: "blocked (denylist, CNAME)", 12: "retried", 13: "retried (DNSSEC)", 14: "in progress",
                15: "blocked (database busy)", 16: "blocked (special domain)", 17: "cached (stale)",
                18: "blocked upstream (EDE15)"}
BLOCKED_STATUS = {1, 4, 5, 6, 7, 8, 9, 10, 11, 15, 16, 18}
SQL_LITERAL = re.compile(r"^[A-Za-z0-9._:/%^|@*,-]+$")


class SqlError(Exception):
    pass


def sql_str(value: str) -> str:
    """A quoted SQL string. The sqlite3 command line cannot bind parameters, so only plain
    domain/address text (no quotes, no spaces) is accepted."""
    if not SQL_LITERAL.match(value):
        raise ValueError("unsafe value for SQL: %r" % (value,))
    return "'" + value + "'"


def sql_ints(values) -> str:
    return ",".join(str(int(v)) for v in values) or "NULL"


def sql_rows(db: str, sql: str) -> list:
    """Run one read-only query and return its rows as dicts.

    Uses Pi-hole's own sqlite shell (`pihole-FTL sqlite3 -readonly -json`); without pihole-FTL on the
    PATH (tests, a development machine) the standard library's sqlite3 module reads the file instead.
    """
    exe = shutil.which("pihole-FTL")
    if exe and os.environ.get("SINKO_SQL_BACKEND") != "python":
        try:
            out = subprocess.run([exe, "sqlite3", "-readonly", "-json", db, sql],
                                 capture_output=True, text=True, timeout=60)
        except (OSError, subprocess.SubprocessError) as err:
            raise SqlError(str(err))
        if out.returncode != 0:
            raise SqlError((out.stderr or out.stdout).strip() or "exit status %d" % out.returncode)
        text = out.stdout.strip()
        try:
            return json.loads(text) if text else []        # no rows: the shell prints nothing
        except ValueError as err:
            raise SqlError("unreadable sqlite3 output: %s" % err)
    import sqlite3
    try:
        con = sqlite3.connect("file:%s?mode=ro" % urllib.parse.quote(db), uri=True)
        con.row_factory = sqlite3.Row
        try:
            return [dict(r) for r in con.execute(sql)]
        finally:
            con.close()
    except sqlite3.Error as err:
        raise SqlError(str(err))


def db_path(env: str, key: str, default: str) -> str:
    if os.environ.get(env):
        return os.environ[env]
    value, err = ftl_try(key)
    return value if value and err is None else default


def list_domains(sid: str, lists_dir: str | None = None) -> list:
    """Entries of a service's list as Pi-hole stores them in gravity: '||example.com^'."""
    try:
        with open(os.path.join(lists_dir or LISTS_DIR, sid + ".txt"), encoding="utf-8") as fh:
            lines = [l.strip() for l in fh]
    except OSError:
        return []
    return [l for l in lines if l.startswith("||") and l.endswith("^")]


def bare_domain(abp: str) -> str:
    return abp[2:-1]


def sample_domains(sid: str, count: int = 3) -> list:
    """A few of a service's gravity entries to test, preferring its best-known name (youtube.com, not googlevideo.com)."""
    word = sid.split("-")[0]

    def rank(entry: str) -> int:
        name = bare_domain(entry)
        return 0 if name == sid + ".com" else 1 if word in name else 2
    return sorted(list_domains(sid), key=rank)[:count]      # sorted() is stable: file order within a rank


def effective_groups(kid: dict, devices: list, clients: list) -> list:
    """What FTL applies to each address a child uses: [{"ip", "groups", "via"}].

    A MAC row is used only when no IP/subnet row matches the address, so each address gets the
    longest-prefix matching row if there is one (see winning_row).
    """
    own_ip = parse_ip(kid["client"])
    dev = find_device(devices, kid["client"])
    if own_ip is not None:
        addrs = [kid["client"]]
    elif is_mac(kid["client"]) and dev:
        addrs = [a for a in device_ips(dev) if parse_ip(a) is not None and not parse_ip(a).is_link_local]
    else:
        addrs = []
    out = []
    for addr in addrs:
        row = winning_row(parse_ip(addr), clients)
        use = row if row is not None else kid
        out.append({"ip": addr, "groups": list(use.get("groups", [])), "via": use["client"]})
    return out or [{"ip": None, "groups": list(kid.get("groups", [])), "via": kid["client"]}]


def gather_diagnose(api: Api, catalog: dict, targets: list, now: float, sql=sql_rows, probe=None) -> dict:
    """Collect everything `diagnose` reports. Read-only. Errors are recorded, never raised."""
    facts = {"now": now, "errors": [], "targets": [], "kids": [], "allow_rules": [],
             "sources_1h": {}, "sources_24h": {}, "gateway": None}
    groups = api.group_map()
    clients = api.clients()
    devices = api.network_devices()
    lists = {l.get("comment"): l for l in api.lists() if (l.get("comment") or "").startswith(LIST_COMMENT_PREFIX)}
    facts["groups"] = groups
    facts["clients"] = clients
    facts["service_ids"] = {s["id"] for s in catalog["services"]}
    try:
        facts["blocking"] = api.request("GET", "/api/dns/blocking").get("blocking")
    except ApiError:
        facts["blocking"] = None
    facts["gateway"] = (probe or SystemProbe()).default_gateway()
    gravity_db = db_path("SINKO_GRAVITY_DB", "files.gravity", GRAVITY_DB)
    ftl_db = db_path("SINKO_FTL_DB", "files.database", FTL_DB)

    def query(db, text, what):
        try:
            return sql(db, text)
        except (SqlError, ValueError) as err:
            facts["errors"].append("%s: %s" % (what, err))
            return None

    by_id = {s["id"]: s for s in catalog["services"]}
    for sid in targets:
        t = {"id": sid, "name": by_id[sid]["name"], "group": groups.get(svc_group(sid)),
             "list": lists.get(LIST_COMMENT_PREFIX + sid), "domains": sample_domains(sid),
             "gravity": {}, "allow_hits": [], "queries": []}
        if not t["domains"]:
            facts["errors"].append("%s: its list file %s is missing or empty, so its domains cannot be checked"
                                   % (sid, os.path.join(LISTS_DIR, sid + ".txt")))
        for d in t["domains"]:
            rows = query(gravity_db, "SELECT adlist_id, count(*) AS n FROM gravity WHERE domain = %s GROUP BY adlist_id"
                         % sql_str(d), "gravity.db")
            t["gravity"][d] = None if rows is None else {r["adlist_id"]: r["n"] for r in rows}
        facts["targets"].append(t)

    rules = query(gravity_db, "SELECT d.type, d.domain, d.enabled, group_concat(g.group_id) AS groups FROM domainlist d "
                  "LEFT JOIN domainlist_by_group g ON g.domainlist_id = d.id WHERE d.type IN (0, 2) GROUP BY d.id", "gravity.db")
    facts["allow_rules"] = [r for r in rules or [] if r.get("enabled")]
    for t in facts["targets"]:
        for d in t["domains"]:
            name = bare_domain(d)
            for r in facts["allow_rules"]:
                try:
                    hit = r["domain"] == name if r["type"] == 0 else bool(re.search(r["domain"], name))
                except re.error:
                    hit = False
                if hit:
                    t["allow_hits"].append("%s allow rule %s" % ("exact" if r["type"] == 0 else "regex", r["domain"]))
            anti = query(gravity_db, "SELECT count(*) AS n FROM antigravity WHERE domain IN (%s, %s)"
                         % (sql_str(d), sql_str(name)), "gravity.db")
            if anti and anti[0]["n"]:
                t["allow_hits"].append("an allow list contains %s" % name)

    for kid in kid_rows(groups, clients):
        ips = device_ips(find_device(devices, kid["client"]) or {})
        if parse_ip(kid["client"]) is not None:
            ips = [kid["client"]] + [a for a in ips if a != kid["client"]]
        k = {"client": kid["client"], "label": kid.get("comment") or kid["client"],
             "eff": effective_groups(kid, devices, clients), "ips": ips}
        for e in k["eff"]:
            e["blocked"] = {}
            for t in facts["targets"]:
                if not t["domains"]:
                    continue
                hit = query(gravity_db, "SELECT 1 AS hit FROM vw_gravity WHERE domain = %s AND group_id IN (%s) LIMIT 1"
                            % (sql_str(t["domains"][0]), sql_ints(e["groups"])), "gravity.db")
                e["blocked"][t["id"]] = None if hit is None else bool(hit)
        facts["kids"].append(k)

    for window, key in ((3600, "sources_1h"), (86400, "sources_24h")):
        rows = query(ftl_db, "SELECT client, COUNT(*) AS n FROM queries WHERE timestamp > %d GROUP BY client "
                     "ORDER BY n DESC" % int(now - window), "pihole-FTL.db")
        facts[key] = {r["client"]: r["n"] for r in rows or []}
    for t in facts["targets"]:
        names = [bare_domain(d) for d in sample_domains(t["id"], 6)]
        if not names or t["group"] is None:
            continue
        where = " OR ".join("domain = %s OR domain LIKE %s" % (sql_str(n), sql_str("%." + n)) for n in names)
        modified = int(t["group"].get("date_modified") or 0)
        rows = query(ftl_db, "SELECT client, status, CASE WHEN timestamp >= %d THEN 'after' ELSE 'before' END AS period, "
                     "COUNT(*) AS n FROM queries WHERE timestamp > %d AND (%s) GROUP BY client, status, period "
                     "ORDER BY n DESC" % (modified, int(now - 86400), where), "pihole-FTL.db")
        t["queries"] = rows or []
        t["modified"] = modified
    # What the scheduler counted for the page's card "What Sinko did for you" (counts only, never a name).
    ledger = Ledger()
    lists = ledger.load()["adLists"]
    facts["ledger"] = ledger_lines(ledger.payload(dt.datetime.fromtimestamp(now), facts["service_ids"], lists or 0), lists)
    return facts


def diagnose_findings(facts: dict) -> list:
    """Likely reasons a toggled service is still reachable, most likely first. Pure: works on gather_diagnose()'s facts."""
    found = []
    groups = facts["groups"]
    if facts.get("blocking") == "disabled":
        found.append("Pi-hole blocking is switched off, so nothing is filtered. Turn it on: sudo pihole enable")
    for t in facts["targets"]:
        g, lst = t["group"], t["list"]
        if g is None:
            found.append("%s: its group pb-svc-%s does not exist. Run: sudo sinko setup" % (t["name"], t["id"]))
        elif not g.get("enabled"):
            found.append("%s: its group is disabled, which means NOT blocked. The toggle on the page did not take effect "
                         "(or a timer or bedtime changed it back)." % t["name"])
        if lst is None:
            found.append("%s: its block list is not registered in Pi-hole. Run: sudo sinko setup" % t["name"])
        elif not lst.get("enabled"):
            found.append("%s: its block list is disabled in Pi-hole. Run: sudo sinko setup" % t["name"])
        elif not lst.get("number"):
            found.append("%s: its block list holds 0 domains in gravity. Run: sudo pihole -g (and check that the list "
                         "server is reachable: sudo sinko doctor)" % t["name"])
        searched = {d: hits for d, hits in t["gravity"].items() if hits is not None}
        if searched and not any(searched.values()):
            found.append("%s: none of its domains (%s) is in gravity. Pi-hole stores them as ||domain^; run: sudo pihole -g"
                         % (t["name"], ", ".join(searched)))
        for hit in dict.fromkeys(t["allow_hits"]):
            found.append("%s: an allow rule overrides the block: %s. Remove it in the Pi-hole admin under Domains." % (t["name"], hit))
    if not facts["kids"]:
        found.append("No child device is added, and rules only apply to devices added on the page. Add the device.")
    for k in facts["kids"]:
        for e in k["eff"]:
            missing = [t for t in facts["targets"] if t["group"] is not None and t["group"].get("enabled")
                       and t["group"]["id"] not in e["groups"]]       # (a missing or disabled group is reported above)
            if not missing:
                continue
            names = ", ".join(group_names(e["groups"], groups)) if len(e["groups"]) < 8 else group_summary(e["groups"], groups, facts.get("service_ids"))
            where = "" if e["ip"] is None else " at %s" % e["ip"]
            apps = " and ".join(t["name"] for t in missing)
            if e["via"] != k["client"]:
                found.append("%s%s is treated as the client row %s (groups: %s), which overrides its own row, so %s %s not "
                             "blocked for it. Remove that row in the Pi-hole admin under Clients (or give it the pb groups)."
                             % (k["label"], where, e["via"], names, apps, "is" if len(missing) == 1 else "are"))
            else:
                found.append("%s%s: the groups Pi-hole applies (%s) lack %s, so %s %s not blocked for it. Run: sudo sinko setup"
                             % (k["label"], where, names, ", ".join("pb-svc-" + t["id"] for t in missing), apps,
                                "is" if len(missing) == 1 else "are"))
    seen = facts["sources_24h"]
    for k in facts["kids"]:
        if k["ips"] and seen and not any(ip in seen for ip in k["ips"]):
            found.append("%s: no DNS query from %s reached this box in the last 24 hours. The device is not using the box for "
                         "DNS (router DNS setting, IPv6 DNS, Private DNS, a VPN or mobile data). Run: sudo sinko watch"
                         % (k["label"], ", ".join(k["ips"][:3])))
    gw = facts.get("gateway")
    if gw and facts["sources_1h"] and sum(facts["sources_1h"].values()) >= RELAY_MIN_QUERIES:
        total = sum(n for ip, n in facts["sources_1h"].items() if ip not in ("127.0.0.1", "::1"))
        if total and facts["sources_1h"].get(gw, 0) * 2 > total:
            found.append("The router (%s) sends most DNS queries, so per-child rules cannot match. Make the router give out this "
                         "box as the DHCP DNS server." % gw)
    if not found:
        for t in facts["targets"]:
            late = [q for q in t["queries"] if q["period"] == "after" and q["status"] not in BLOCKED_STATUS]
            if late:
                who = ", ".join("%s (%d)" % (q["client"], q["n"]) for q in late[:4])
                found.append("%s was still answered normally after its group last changed, from %s, although the rules look "
                             "right. Run: sudo sinko watch while opening it on the device." % (t["name"], who))
    if not found and facts["errors"]:
        found.append("Nothing wrong found in what could be read, but some checks could not run (see 'Could not read' above).")
    elif not found:
        found.append("Nothing wrong found on the box: the rules look right. Run: sudo sinko watch, then open the app "
                     "on the child's device, to see whether its queries reach the box.")
    return found


def group_summary(ids, groups: dict, service_ids=None) -> str:
    """'Default, pb-kids, pb-guard, pb-offline, 19/19 services' instead of every service group by name. With
    `service_ids` (the catalog's) only those services count: the group of a blocked service that only a newer release
    knows is kept, and must not make it read 19/20."""
    def known(name):
        return service_ids is None or name[len(SVC_PREFIX):] in service_ids
    names = group_names(ids, groups)
    svc_total = len([n for n in groups if n.startswith(SVC_PREFIX) and known(n)])
    svc = [n for n in names if n.startswith(SVC_PREFIX) and known(n)]
    other = [n for n in names if not n.startswith(SVC_PREFIX)]
    return ", ".join(other + (["%d/%d service groups" % (len(svc), svc_total)] if svc or svc_total else []))


def render_diagnose(facts: dict, findings: list) -> list:
    """The text of `diagnose`."""
    out = []
    add = out.append
    groups = facts["groups"]
    add("Blocking: %s" % (facts.get("blocking") or "unknown"))
    add("\nGroups (enabled = the service is blocked)")
    for name in sorted(n for n in groups if n.startswith("pb-") and n not in (G_STATE, G_LEDGER)):
        if name.startswith(SVC_PREFIX) and name[len(SVC_PREFIX):] not in [t["id"] for t in facts["targets"]]:
            continue
        add("  %-24s %s" % (name, "ENABLED" if groups[name].get("enabled") else "disabled"))
    add("\nBlock lists")
    for t in facts["targets"]:
        l = t["list"]
        add("  pb:%-14s %s" % (t["id"], "not registered" if l is None else
            "%s  domains=%s  abp=%s  groups=%s" % ("enabled" if l.get("enabled") else "DISABLED", l.get("number"),
                                                    l.get("abp_entries"), ",".join(group_names(l.get("groups", []), groups)))))
    add("\nGravity (searched as ||domain^, the form Pi-hole stores)")
    for t in facts["targets"]:
        for d, hits in t["gravity"].items():
            add("  %-12s %-34s %s" % (t["id"], d, "database unreadable" if hits is None else
                ("in list(s) %s" % ", ".join("#%s" % i for i in hits)) if hits else "NOT FOUND"))
    add("\nAllow rules that match these domains")
    hits = [(t["name"], h) for t in facts["targets"] for h in dict.fromkeys(t["allow_hits"])]
    add("\n".join("  %s: %s" % x for x in hits) if hits else "  none (%d enabled allow rule(s) in total)" % len(facts["allow_rules"]))
    add("\nClient rows")
    for c in facts["clients"]:
        add("  %-22s %-14s %s" % (c["client"], (c.get("comment") or "")[:14], group_summary(c.get("groups", []), groups, facts.get("service_ids"))))
    add("\nWhat Pi-hole applies to each child")
    if not facts["kids"]:
        add("  no child device is added")
    for k in facts["kids"]:
        for e in k["eff"]:
            verdict = ", ".join("%s %s" % (tid, {True: "blocked", False: "NOT blocked", None: "?"}[b])
                                for tid, b in e["blocked"].items())
            add("  %s%s via %s: %s" % (k["label"], "" if e["ip"] is None else " @ " + e["ip"], e["via"], verdict or "-"))
    add("\nQuery sources, last hour")
    add("\n".join("  %-40s %d" % (ip, n) for ip, n in list(facts["sources_1h"].items())[:10]) or "  none")
    add("\nQueries for these apps, last 24 hours (before/after the group last changed)")
    shown = False
    for t in facts["targets"]:
        for q in t["queries"]:
            shown = True
            add("  %-10s %-34s %-26s %-6s %d" % (t["id"], q["client"], QUERY_STATUS.get(q["status"], q["status"]), q["period"], q["n"]))
    if not shown:
        add("  none")
    if facts.get("ledger"):
        add("\nWhat the box counted for the family (savings.json, counts only)")
        add("\n".join(facts["ledger"]))
    if facts["errors"]:
        add("\nCould not read")
        add("\n".join("  " + e for e in facts["errors"]))
    add("\nFindings, most likely first")
    add("\n".join("  %d. %s" % (i, f) for i, f in enumerate(findings, 1)))
    return out


# ---- watch: follow the DNS log --------------------------------------------- #
LOG_PREFIX = re.compile(r"dnsmasq\[\d+\]: (?:\d+ \S+/\d+ )?(?P<msg>.+)$")      # the id/port part exists with log-queries=extra
QUERY_LINE = re.compile(r"^query\[(?P<qtype>[A-Za-z0-9]+)\] (?P<domain>\S+) from (?P<client>\S+)$")


def service_domain_map(catalog: dict, lists_dir: str | None = None, only=None) -> dict:
    """{'youtube.com': 'youtube', ...} for the given services (default: all)."""
    out = {}
    for s in catalog["services"]:
        if only and s["id"] not in only:
            continue
        for d in list_domains(s["id"], lists_dir):
            out[bare_domain(d).lower()] = s["id"]
    return out


def build_domain_map(catalog: dict, lists_dir: str | None = None) -> dict:
    """{"v": 1, "domains": {"youtube.com": "youtube", ...}}: which app a domain belongs to.

    The parent page loads this (installed as pb/domains.json) so real queries can be shown as
    "YouTube" instead of "googlevideo.com". Lookups match the longest domain suffix, like service_of().
    """
    return {"v": 1, "domains": dict(sorted(service_domain_map(catalog, lists_dir).items()))}


def service_of(domain: str, dmap: dict):
    d = domain.lower().rstrip(".")
    while d:
        if d in dmap:
            return dmap[d]
        d = d.partition(".")[2]
    return None


class WatchState:
    """Turns pihole.log lines into per-client counts for the watched services."""

    def __init__(self, dmap: dict):
        self.dmap = dmap
        self.last_client = {}                  # domain -> client of its latest query (the log has no query id)
        self.counts = {}                       # client -> {"queries", "blocked", "answered", "services": {sid: n}}

    def feed(self, line: str):
        """Returns (client, service, outcome, domain) when the line belongs to a watched service, else None.
        outcome is 'query', 'blocked' or 'answered'."""
        m = LOG_PREFIX.search(line)
        if not m:
            return None
        msg = m.group("msg").strip()
        q = QUERY_LINE.match(msg)
        if q:
            sid = service_of(q.group("domain"), self.dmap)
            if sid is None:
                return None
            self.last_client[q.group("domain").lower()] = q.group("client")
            c = self.counts.setdefault(q.group("client"), {"queries": 0, "blocked": 0, "answered": 0, "services": {}})
            c["queries"] += 1
            c["services"][sid] = c["services"].get(sid, 0) + 1
            return q.group("client"), sid, "query", q.group("domain")
        head, sep, _answer = msg.rpartition(" is ")
        if not sep:
            return None
        reason, _, domain = head.rpartition(" ")
        sid = service_of(domain, self.dmap)
        client = self.last_client.get(domain.lower())
        if sid is None or client is None:
            return None
        if "blocked" in reason or "denied" in reason:
            self.counts[client]["blocked"] += 1
            return client, sid, "blocked", domain
        if reason in ("reply", "cached", "cached-stale", "config"):
            self.counts[client]["answered"] += 1
            return client, sid, "answered", domain
        return None


def watch_log(path: str, dmap: dict, seconds: float, out=print, clock=time.time, sleep=time.sleep, poll: float = 0.5,
              names: dict | None = None) -> WatchState:
    """Follow `path` for `seconds`, printing the lines for watched services. Returns the counts."""
    state = WatchState(dmap)
    names = names or {}
    deadline = clock() + seconds
    fh = None
    inode = None
    try:
        while clock() < deadline:
            try:
                st = os.stat(path)
            except OSError:
                st = None
            if st is not None and (fh is None or st.st_ino != inode):      # first open, or the log was rotated
                if fh:
                    fh.close()
                fh = open(path, encoding="utf-8", errors="replace")
                if inode is None:
                    fh.seek(0, os.SEEK_END)                                 # only what happens from now on
                inode = st.st_ino
            line = fh.readline() if fh else ""
            if not line:
                sleep(poll)
                continue
            ev = state.feed(line)
            if ev:
                client, sid, outcome, domain = ev
                stamp = time.strftime("%H:%M:%S")
                if outcome == "query":
                    out("  %s  %s asks for %s (%s)" % (stamp, names.get(client, client), domain, sid))
                else:
                    out("  %s    -> %s" % (stamp, "BLOCKED" if outcome == "blocked" else "answered normally"))
    except KeyboardInterrupt:
        out("  (stopped)")
    finally:
        if fh:
            fh.close()
    return state


def watch_summary(state: WatchState, kid_names: dict, minutes: float) -> list:
    """What `watch` concluded."""
    out = []
    if not state.counts:
        out.append("No query for these apps reached the box in %g minute(s). The device is not using this box for DNS: "
                   "check the router's DNS setting, IPv6 DNS, Private DNS, a VPN or mobile data (see: sudo sinko doctor)."
                   % minutes)
        return out
    for client, c in sorted(state.counts.items(), key=lambda x: -x[1]["queries"]):
        who = kid_names.get(client)
        out.append("  %s%s: %d quer%s (%s); %d blocked, %d answered normally"
                   % (client, " = child device " + who if who else " (not a registered child device)", c["queries"],
                      "y" if c["queries"] == 1 else "ies", ", ".join("%s %d" % kv for kv in sorted(c["services"].items())),
                      c["blocked"], c["answered"]))
        if c["answered"] and not c["blocked"]:
            out.append("    -> answered normally: no child rule matches this address (%s). Check: sudo sinko doctor"
                       % ("it is registered, so look for a row that overrides it" if who else "add it as a child device"))
        elif c["blocked"]:
            out.append("    -> blocking works for this address")
    return out


def kid_address_names(groups: dict, clients: list, devices: list) -> dict:
    """{address: child's name} for every address a registered child is known to use."""
    names = {}
    for kid in kid_rows(groups, clients):
        label = kid.get("comment") or kid["client"]
        if parse_ip(kid["client"]) is not None:
            names[str(parse_ip(kid["client"]))] = label
        dev = find_device(devices, kid["client"])
        for a in device_ips(dev) if dev else []:
            names.setdefault(a, label)
    return names


def cmd_diagnose(args) -> int:
    api = Api()
    api.login()
    try:
        catalog = load_catalog()
        ids = {s["id"] for s in catalog["services"]}
        unknown = [s for s in args.services if s not in ids]
        if unknown:
            print("sinko: unknown service(s): %s (known: %s)" % (", ".join(unknown), ", ".join(sorted(ids))), file=sys.stderr)
            return 1
        targets = args.services or [s for s in DEFAULT_DIAGNOSE_SERVICES if s in ids]
        facts = gather_diagnose(api, catalog, targets, time.time())
    finally:
        api.logout()
    print("\n".join(render_diagnose(facts, diagnose_findings(facts))))
    return 0


def cmd_watch(args) -> int:
    catalog = load_catalog()
    ids = {s["id"] for s in catalog["services"]}
    unknown = [s for s in args.service if s not in ids]
    if unknown:
        print("sinko: unknown service(s): %s" % ", ".join(unknown), file=sys.stderr)
        return 1
    dmap = service_domain_map(catalog, only=set(args.service) or None)
    path = db_path("SINKO_DNSMASQ_LOG", "files.log.dnsmasq", DNSMASQ_LOG)
    logging_on, _ = ftl_try("dns.queryLogging")
    if logging_on == "false":
        print("Query logging is switched off, so there is nothing to watch. Turn it on: sudo pihole-FTL --config dns.queryLogging true")
        return 1
    api = Api()
    api.login()
    try:
        groups = api.group_map()
        names = kid_address_names(groups, api.clients(), api.network_devices())
    finally:
        api.logout()
    print("Watching %s for %g minute(s). Turn Wi-Fi off and on on the child's device, then open the app or m.youtube.com "
          "in its browser. Ctrl-C stops early." % (path, args.minutes))
    state = watch_log(path, dmap, args.minutes * 60, names=names)
    print("\nSummary")
    print("\n".join(watch_summary(state, names, args.minutes)))
    return 0


def cmd_configure(args) -> int:
    apply_pihole_settings(read_config(), args.hostname, args.ip, args.remove_hostname, args.disable_web)
    if not args.disable_web and not args.remove_hostname:
        refresh_box_info(ip=args.ip or "default", force=True)       # the page learns the new address and name at once
    print("sinko: Pi-hole settings applied")
    return 0


def cmd_box_info(args) -> int:
    """`sinko box-info [--write]`: print what /pb/box.json holds, or write it (nothing is written when the box has no
    page folder: that is not an error)."""
    if not args.write:
        print(json.dumps(box_info(), indent=2))
        return 0
    try:
        what = write_box_info(force=True)
    except OSError as err:
        print("sinko: could not write %s (%s)" % (BOX_INFO_FILE, short_text(err, 100)), file=sys.stderr)
        return 1
    print("sinko: %s" % ("there is no page folder to write %s into" % BOX_INFO_FILE if what == "nowhere"
                         else "%s written" % BOX_INFO_FILE))
    return 0


def patch_state(api: Api, mutate) -> bool:
    """Read the shared state, let `mutate(state)` change what the caller owns, and write it back only if it changed
    (every write makes Pi-hole reload). False when nothing was written."""
    groups = api.group_map()
    if G_STATE not in groups:
        return False
    state = parse_state(groups[G_STATE].get("comment"))
    before = json.dumps(state, sort_keys=True)
    mutate(state)
    if json.dumps(state, sort_keys=True) == before:
        return False
    api.put_group(G_STATE, json.dumps(state, separators=(",", ":")), False)
    return True


def note_rollback(undone: str, restored: str) -> None:
    """After a rollback by hand, tell the scheduler that `undone` is not wanted: its auto-update rule skips a release
    that failed in the last 7 days, so the box does not install the same release again the next night."""
    def mark(state):
        update = state["update"]
        update.update(status="failed", to=undone, at=time.time(), error="Went back to %s by hand." % restored,
                      rolledBack=True)                  # the older version was installed and passed its self-check
        update["from"] = restored
    try:
        api = Api()
        api.login()
        try:
            patch_state(api, mark)
        finally:
            api.logout()
    except TRANSPORT_ERRORS as err:
        log.warning("could not record the rollback in the shared state: %s", err)


def note_update(result: dict) -> None:
    """After an update by hand that worked, tell the page. The scheduler copies a result into the shared state only for an
    update the page started (the state says "running"), so without this the page would go on showing what it showed before:
    after a rollback by hand, "the update did not finish" for a week while the newer version runs fine."""
    def mark(state):
        update = state["update"]
        if update["status"] == "running":
            return                                      # a run the page started owns the card, and its own result lands there
        update.update(status="ok", to=result["to"], at=result["at"], error=None, rolledBack=None)
        update["from"] = result["from"]
        if update["latest"] and result["to"] and not is_newer(update["latest"], result["to"]):
            update["latest"] = update["notes"] = None   # that release is installed now
    try:
        api = Api()
        api.login()
        try:
            patch_state(api, mark)
        finally:
            api.logout()
    except TRANSPORT_ERRORS as err:
        log.warning("could not record the update in the shared state: %s", err)


def cmd_update(args) -> int:
    conf = read_config(CONFIG_FILE)               # (the name is looked up now: the file that keep_pin and settle_pin write)
    updater = Updater(conf)
    try:
        ref = args.ref or release_settings(conf)["ref"]
        kind, _ = classify_ref(ref)
    except UpdateError as err:
        print("sinko: %s" % err, file=sys.stderr)
        return 1
    if args.check:
        if kind == "branch":
            print("This box follows the developer branch '%s': updates are fetched with git, there is no release to check." % ref)
            return 0
        try:
            release = check_for_update(conf, fetch=updater.fetch, ref=ref)
        except UpdateError as err:
            print("sinko: could not check for updates: %s" % err, file=sys.stderr)
            return 1
        if release:
            print("Update available: Sinko %s (this box has %s). Install it with: sudo sinko update"
                  % (release["version"], VERSION))
        elif kind == "tag" and not args.ref:
            # A pinned box asks for its own release only: "the newest version" would be false when a newer one exists.
            print("This box is pinned to %s (it has %s), so newer releases are not looked for. To follow the newest "
                  "release again: sudo sinko update --ref latest" % (ref, VERSION))
        elif kind == "tag":
            print("Sinko %s is installed and %s is not newer." % (VERSION, ref))
        else:
            print("Sinko %s is the newest version." % VERSION)
        return 0
    saved_pin = conf.get("SINKO_REF")             # as the settings file has it now: what a failed run must leave
    asked = not (args.yes or args.from_panel)
    if asked and not sys.stdin.isatty():
        print("sinko: run 'sudo sinko update --yes' to update without being asked.", file=sys.stderr)
        return 1

    def confirm(current, to_version):
        try:
            answer = input("Update Sinko from %s to %s? [y/N] " % (current, to_version or "the latest version of " + ref))
        except EOFError:
            return False
        return answer.strip().lower() in ("y", "yes")
    try:
        result = updater.update(ref=args.ref, force=args.force, confirm=confirm if asked else None)
    except UpdateError as err:                 # UpdateLocked, or the folder the update works in cannot be used
        print("sinko: %s" % err, file=sys.stderr)
        return 1
    if result is None:
        print("Nothing was changed.")
        return 1
    if result["status"] == "ok":
        if args.ref:
            settle_pin(args.ref)
        if not args.from_panel:
            note_update(result)                         # the scheduler records an update the page started; this one, nobody else
        return 0
    print("sinko: the update failed. %s" % result["error"], file=sys.stderr)
    if args.ref:
        keep_pin(saved_pin, args.ref)
    print("To see what is wrong with this box: sudo sinko doctor", file=sys.stderr)    # for the person at the keyboard
    return 1


def describe_ref(ref: str) -> str:
    kind = classify_ref(ref)[0]
    return ("the newest release" if kind == "latest" else "release %s" % ref if kind == "tag"
            else "the development branch '%s'" % ref)


def keep_pin(was, wanted: str, config_path=None) -> None:
    """A failed `sinko update --ref X` leaves SINKO_REF as it was. Only a successful update saves the choice (settle_pin),
    but the installer of the release that failed has already written X into the settings by the time it stops, and when the
    old version could not be put back (or there was no copy of it) nothing writes it again. `was` is what the settings said
    before the run (None: no such line, which means "latest")."""
    path = config_path or CONFIG_FILE
    before = was or "latest"
    if (read_config(path).get("SINKO_REF") or "latest") != before:
        try:
            write_config_value("SINKO_REF", before, path)
        except (OSError, ValueError) as err:
            print("sinko: could not put the setting back to %s in %s (%s)" % (before, path, short_text(err, 80)), file=sys.stderr)
            return
    try:
        follows = describe_ref(before)
    except UpdateError:
        return
    print("The update failed, so the choice of %s was not kept: this box still follows %s." % (wanted, follows), file=sys.stderr)


def settle_pin(ref: str, config_path=None) -> None:
    """`sinko update --ref X` pins the box to X (the installer saved it when it ran; when it had nothing to install the
    setting is saved here), so that "Update now" on the page and the nightly update follow X and not the newest
    release. Say so, and how to follow releases again: without it a box can stay behind for good without anyone knowing."""
    path = config_path or CONFIG_FILE
    if (read_config(path).get("SINKO_REF") or "latest") != ref:
        try:
            write_config_value("SINKO_REF", ref, path)
        except (OSError, ValueError) as err:
            print("sinko: could not save the choice of %s in %s (%s)" % (ref, path, short_text(err, 80)), file=sys.stderr)
            return
    kind, _ = classify_ref(ref)
    if kind == "latest":
        print("This box follows the newest release again.")
    elif kind == "tag":
        print("This box is now pinned to %s: updates from the page and at night follow it, not the newest release. "
              "To follow the newest release again: sudo sinko update --ref latest" % ref)
    else:
        print("This box now follows the development branch '%s' and is never offered releases. To follow the newest "
              "release again: sudo sinko update --ref latest --force" % ref)


def cmd_rollback(args) -> int:
    try:
        result = Updater().rollback()
    except UpdateLocked as err:
        print("sinko: %s" % err, file=sys.stderr)
        return 1
    if result["status"] != "ok":
        print("sinko: could not go back. %s" % result["error"], file=sys.stderr)
        return 1
    print("Sinko is back at version %s." % result["to"])
    note_rollback(result["from"], result["to"])
    return 0


def note_repaired() -> None:
    """The update that was cut short has been finished by the repair (or, when it was the way back that was cut short,
    the previous version is back), and the shared state still says it failed (the scheduler wrote that when it found
    the box in two versions): say what is true now. Never raises."""
    def mark(state):
        up = state["update"]
        if up["status"] == "failed" and up["to"] == VERSION:
            up.update(status="ok", error=None, rolledBack=None, at=time.time())
        elif up["status"] == "failed" and up["from"] == VERSION and up["rolledBack"] is not True:
            # The way back was cut off (the program had been put back, the page not yet): this version is what runs now.
            up.update(rolledBack=True, at=time.time(),
                      error="The update did not finish; the previous version (%s) was put back by the repair." % VERSION)
        if up["latest"] and not is_newer(up["latest"], VERSION):
            up["latest"] = up["notes"] = None
    try:
        api = Api()
        api.login()
        try:
            patch_state(api, mark)
        finally:
            drop_session(api)
    except TRANSPORT_ERRORS as err:
        log.warning("could not record the repair in the shared state: %s", short_text(err, 100))


def cmd_repair(args) -> int:
    """`sinko repair`: the page and the program are of different versions (an update was cut short): install this version
    again from the copy of it on the box, /opt/sinko/src. Nothing is downloaded, so it works without the internet. The
    scheduler starts it by itself, as a unit of its own, after ten minutes of such a state."""
    conf = read_config(CONFIG_FILE)
    try:
        lock = Updater._take_lock()                 # the update's lock: no update, rollback or repair runs at the same time
    except UpdateError as err:
        print("sinko: %s" % err, file=sys.stderr)
        return 1
    try:
        if os.path.exists(removed_flag()):
            print("sinko: Sinko was removed from this box on purpose, so nothing is repaired. To set it up again: sudo sinko setup",
                  file=sys.stderr)
            return 1
        src = os.path.join(APP_DIR, "src")
        have = read_version_file(src)
        if have != VERSION:
            print("sinko: there is no copy of version %s on this box to install again (%s holds %s)."
                  % (VERSION, src, have or "no version"), file=sys.stderr)
            return 1
        shown = page_version()
        if shown == VERSION:
            print("The page and the program are both version %s: nothing to repair." % VERSION)
            return 0
        try:
            Updater._require_free_space()
            ref = release_settings(conf)["ref"]
        except UpdateError as err:
            print("sinko: %s" % err, file=sys.stderr)
            return 1
        print("The page is %s and the program is %s. Installing %s again from %s ..." % (shown or "missing", VERSION, VERSION, src))
        sync_disks()
        code = run_installer(src, ref)
        if code != 0:
            print("sinko: the installer stopped with an error (exit status %s)." % code, file=sys.stderr)
            return 1
        sync_disks()
        ok, detail = run_installed_selfcheck()
        if not ok:
            print("sinko: it was installed again, but the box does not pass its own check (%s)." % (detail or "no reason given"),
                  file=sys.stderr)
            return 1
        note_repaired()
        print("Sinko %s is installed again, and the page and the program agree." % VERSION)
        return 0
    finally:
        lock.release()


def cmd_selfcheck(args) -> int:
    return run_selfcheck(args.wait)


def cmd_password_state(args) -> int:
    api = Api()
    api.wait_ready()
    return 0 if api.password_set() else 3


def cmd_domain_map(args) -> int:
    print(json.dumps(build_domain_map(load_catalog()), separators=(",", ":")))
    return 0


def cmd_use_mac(args) -> int:
    api = Api()
    api.login()
    try:
        lines = Controller(api, load_catalog()).convert_to_mac(args.address, args.dry_run)
    finally:
        api.logout()
    print("\n".join(lines) if lines else "Nothing to convert: no child device is registered by IP address.")
    return 0


def cmd_remove(args) -> int:
    api = Api()
    api.login()
    try:
        try:
            ensure_state_dir()
            atomic_write(removed_flag(), "1\n")        # so that a scheduler that is still running does not set it all up again
        except OSError as err:
            log.warning("could not leave the note that Sinko was removed: %s", err)
        Controller(api, load_catalog()).remove()
    finally:
        drop_session(api)
    print("sinko: removed its groups, lists and rules from Pi-hole, and the devices that were registered only for it "
          "(a device that also has a group of yours stays, without Sinko's groups)")
    return 0


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(prog="sinko", description=__doc__.split("\n")[0])
    parser.add_argument("--version", action="version", version=VERSION)
    parser.add_argument("-v", "--verbose", action="store_true")
    sub = parser.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("setup", help="create/refresh Pi-hole objects")
    p.add_argument("--no-gravity", action="store_true", help="skip 'pihole -g' (which otherwise runs one at a time: "
                   "it waits up to 30 minutes for a run that is already going)")
    p.set_defaults(fn=cmd_setup)
    p = sub.add_parser("configure", help="apply required Pi-hole settings")
    p.add_argument("--hostname", default=None, help="local name for the parent page, e.g. family.lan")
    p.add_argument("--ip", default=None, help="this device's LAN address")
    p.add_argument("--remove-hostname", action="store_true")
    p.add_argument("--disable-web", action="store_true", help="turn webserver.serve_all off (uninstall)")
    p.set_defaults(fn=cmd_configure)
    p = sub.add_parser("update", help="update to the latest version")
    p.add_argument("--check", action="store_true", help="only say whether a newer version exists")
    p.add_argument("--yes", action="store_true", help="do not ask for confirmation")
    p.add_argument("--ref", default=None, help="latest, a release such as v3.1.0, or a branch (default from the settings). "
                   "Giving one pins the box to it once the update has worked: updates from the page and at night follow it "
                   "(if the update fails, the box keeps following what it followed before). "
                   "--ref latest follows the newest release again")
    p.add_argument("--force", action="store_true", help="install even if that version is not newer (an update needs "
                   "more than 200 MB of free space either way)")
    p.add_argument("--from-panel", action="store_true", help=argparse.SUPPRESS)      # started by the scheduler
    p.set_defaults(fn=cmd_update)
    sub.add_parser("rollback", help="go back to the previous version stored on this box (needs more than 200 MB free)",
                   description="Go back to the previous version stored on this box. Needs more than 200 MB of free space "
                   "(nothing is changed without it)."
                   ).set_defaults(fn=cmd_rollback)
    sub.add_parser("repair", help="install this version again from the copy on the box when the page and the program are of "
                   "different versions (an update was cut short; the scheduler does it by itself after ten minutes)"
                   ).set_defaults(fn=cmd_repair)
    p = sub.add_parser("selfcheck", help="check that the installation works (used after every update; the scheduler must have run for 20 seconds)")
    p.add_argument("--wait", type=float, default=0, help="keep trying for this many seconds while services start")
    p.set_defaults(fn=cmd_selfcheck)
    sub.add_parser("password-state", help=argparse.SUPPRESS).set_defaults(fn=cmd_password_state)
    p = sub.add_parser("diagnose", help="read-only report on why a service is not blocked")
    p.add_argument("services", nargs="*", help="service ids to test (default: youtube instagram)")
    p.set_defaults(fn=cmd_diagnose)
    p = sub.add_parser("watch", help="follow the DNS log to see whether a device's queries reach the box")
    p.add_argument("minutes", nargs="?", type=float, default=2, help="how long to watch (default 2)")
    p.add_argument("--service", action="append", default=[], help="only this service (repeatable; default all)")
    p.set_defaults(fn=cmd_watch)
    sub.add_parser("domain-map", help=argparse.SUPPRESS).set_defaults(fn=cmd_domain_map)   # used by install.sh
    p = sub.add_parser("use-mac", help="re-register children added by IP address under their MAC address")
    p.add_argument("address", nargs="?", default=None, help="only this child's IP address (default: all)")
    p.add_argument("--dry-run", action="store_true", help="show what would change")
    p.set_defaults(fn=cmd_use_mac)
    sub.add_parser("run", help="run the scheduler (systemd)").set_defaults(fn=cmd_run)
    sub.add_parser("status", help="print current state").set_defaults(fn=cmd_status)
    p = sub.add_parser("telemetry", help="the optional anonymous counter (boxes online): on, off (also makes the counter "
                       "forget this box), status, payload, reset-id (forget the old id, make a new one)")
    p.add_argument("action", choices=["on", "off", "status", "payload", "reset-id"])
    p.set_defaults(fn=cmd_telemetry)
    p = sub.add_parser("learn", help="learning new addresses of blocked apps with the small AI model on the box: on, off, "
                       "status, list, forget NAME (allow a learned address again)")
    p.add_argument("action", choices=["on", "off", "status", "list", "forget"])
    p.add_argument("name", nargs="?", default=None, help="with forget: the learned address to allow again")
    p.set_defaults(fn=cmd_learn)
    p = sub.add_parser("box-info", help="print what the page may know about this box (/pb/box.json), or write it")
    p.add_argument("--write", action="store_true", help="write it into the page folder instead of printing it")
    p.set_defaults(fn=cmd_box_info)
    sub.add_parser("doctor", help="check the installation").set_defaults(fn=cmd_doctor)
    sub.add_parser("remove", help="delete this add-on's Pi-hole objects (a device that also has a group of yours stays, "
                   "without this add-on's groups)",
                   description="Delete the groups, lists and rules this add-on made in Pi-hole, and the devices that were "
                   "registered only for it. A device that also has a group of yours stays, without this add-on's groups."
                   ).set_defaults(fn=cmd_remove)
    args = parser.parse_args(argv)
    logging.basicConfig(level=logging.DEBUG if args.verbose else logging.INFO,
                        format="%(levelname)s %(message)s", stream=sys.stderr)
    if os.geteuid() != 0 and "SINKO_API_URL" not in os.environ:
        print("sinko: run as root (sudo)", file=sys.stderr)
        return 1
    try:
        return args.fn(args)
    except ApiError as err:
        print("sinko: Pi-hole API error: %s" % err, file=sys.stderr)
        return 2
    except (OSError, ValueError, http.client.HTTPException) as err:
        # Pi-hole did not answer properly (FTL restarting, a connection closed half way): one line, not a traceback.
        log.debug("details", exc_info=True)
        print("sinko: Pi-hole could not be reached or did not answer properly (%s: %s). Try again in a minute."
              % (type(err).__name__, short_text(err, 100)), file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
